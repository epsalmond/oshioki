# Copy to /etc/oshioki/server.env, owned by root with mode 0600, then:
#   systemctl enable --now oshioki-server
NATS_URL=nats://127.0.0.1:4222
NATS_USER=oshioki
NATS_PASS=change-me
OSHIOKI_STATE_PATH=/var/lib/oshioki/state.sqlite3
OSHIOKI_LISTEN=127.0.0.1:8443
OSHIOKI_ORIGIN=https://sudo.example.com
OSHIOKI_RP_ID=sudo.example.com
