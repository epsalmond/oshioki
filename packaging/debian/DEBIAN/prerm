#!/bin/sh
# oshioki prerm: stop the server and remove each sudo privilege artifact this
# package enabled, if any. The PAM entries, the plugin block and the sudoers
# drop-in are inspected independently because any one of them may have been
# damaged by an administrator.
set -e

INSTALLER="${OSHIOKI_INSTALLER:-/usr/share/oshioki/install-oshioki-hook}"
SUDO_CONF="${SUDO_CONF:-/etc/sudo.conf}"
SUDOERS_FILE="${SUDOERS_FILE:-${SUDOERS_D:-/etc/sudoers.d}/oshioki}"
# Same spelling and default as the installer's own PAM_D, so a test harness or
# a packager overriding one overrides both.
PAM_D="${PAM_D:-/etc/pam.d}"

case "$1" in
  remove|purge)
    if [ -d /run/systemd/system ] && systemctl is-active -q oshioki-server.service; then
      systemctl stop oshioki-server.service || {
        echo "oshioki: cannot stop oshioki-server; refusing to remove a running server" >&2
        exit 1
      }
    fi
    cleanup_failed=0
    # PAM first, and independently of the two blocks below: the module must
    # stop being referenced by any sudo service before the legacy privilege
    # artifacts come back, and --disable-contextual-pam enforces that order
    # internally (entries out, sudo validated, only then the module unlinked).
    # Presence of either the marker or the exact auth line is enough to ask
    # for cleanup; status cannot answer safely on a damaged stack.
    # The marker or any auth line naming the module: the same rule the
    # installer's pam_lane_active uses, and deliberately looser than the
    # exact line, so a hand-damaged entry still gets cleaned up. No copy of
    # that line lives here, where it could drift from the installer's.
    pam_referrer=0
    for pam_file in "$PAM_D"/sudo*; do
      [ -f "$pam_file" ] || continue
      if grep -Fq '# BEGIN oshioki pam' "$pam_file" 2>/dev/null ||
         grep -Eq '^[[:space:]]*auth[[:space:]].*liboshioki_pam' "$pam_file" 2>/dev/null; then
        pam_referrer=1
        break
      fi
    done
    if [ "$pam_referrer" -eq 1 ]; then
      # Hard stop, not a folded failure: everything below re-establishes the
      # legacy lane's absence, and doing that while the PAM module is still
      # live would remove the artifacts an administrator needs to reach sudo
      # if the module cannot authenticate. Leave the host exactly as found.
      "$INSTALLER" --disable-contextual-pam || {
        echo "oshioki: failed to disable the contextual PAM lane; resolve it first with:" >&2
        echo "oshioki:   $INSTALLER --disable-contextual-pam" >&2
        echo "oshioki: the approval plugin and sudoers drop-in were left untouched" >&2
        exit 1
      }
    fi
    # Status intentionally is not used here: it cannot answer safely when
    # sudo.conf is missing or malformed. Presence of either Oshioki marker or
    # the exact plugin directive is enough to request independent cleanup.
    if [ -f "$SUDO_CONF" ] && {
      grep -Fq '# BEGIN oshioki' "$SUDO_CONF" ||
      grep -Fq '# END oshioki' "$SUDO_CONF" ||
      grep -Fq 'Plugin approval_exec /usr/local/libexec/sudo/oshioki.so' "$SUDO_CONF";
    }; then
      "$INSTALLER" --disable-prelaunch || {
        echo "oshioki: failed to disable the sudo hook; resolve it first with:" >&2
        echo "oshioki:   $INSTALLER --disable-prelaunch" >&2
        cleanup_failed=1
      }
    fi
    if [ -e "$SUDOERS_FILE" ] || [ -L "$SUDOERS_FILE" ]; then
      "$INSTALLER" --remove-sudoers-dropin || {
        echo "oshioki: failed to remove the verified Oshioki sudoers drop-in; resolve it first with:" >&2
        echo "oshioki:   $INSTALLER --remove-sudoers-dropin" >&2
        cleanup_failed=1
      }
    fi
    [ "$cleanup_failed" -eq 0 ] || exit 1
    ;;
esac

exit 0
