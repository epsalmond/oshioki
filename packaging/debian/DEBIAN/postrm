#!/bin/sh
# oshioki postrm: drop the systemd enablement on remove; on purge also drop
# server state, hook state (including cleartext NATS credentials), and the
# hook/plugin files the installer placed outside dpkg's manifest.
#
# Enablement is removed through deb-systemd-helper, which recorded it at
# install time: by now dpkg has already deleted the unit file, so plain
# `systemctl disable` cannot resolve the name. Nothing here may fail.
set -e

SUDOERS_D="${SUDOERS_D:-/etc/sudoers.d}"
SUDOERS_FILE="${SUDOERS_FILE:-$SUDOERS_D/oshioki}"
PAM_D="${PAM_D:-/etc/pam.d}"
# Overridable only so the package-script tests can point the sweep at a
# fixture tree; on a real host these are the two multiarch-shaped locations
# the installer will ever have written the module to.
PAM_MODULE_GLOBS="${PAM_MODULE_GLOBS:-/usr/lib/*/security/liboshioki_pam.so /lib/*/security/liboshioki_pam.so /usr/lib/security/liboshioki_pam.so /lib/security/liboshioki_pam.so /usr/lib/*/security/liboshioki_pam.so.oshioki-new /usr/lib/*/security/liboshioki_pam.so.oshioki-previous /lib/*/security/liboshioki_pam.so.oshioki-new /lib/*/security/liboshioki_pam.so.oshioki-previous /usr/lib/security/liboshioki_pam.so.oshioki-new /usr/lib/security/liboshioki_pam.so.oshioki-previous /lib/security/liboshioki_pam.so.oshioki-new /lib/security/liboshioki_pam.so.oshioki-previous}"

valid_sudoers_user() {
  case "$1" in
    ''|*[!A-Za-z0-9_.-]*) return 1 ;;
  esac
}

# The package may be gone by the time postrm runs. Keep this verifier here,
# independent of the installer, and remove only the complete root-owned 0440
# Oshioki rule. Both the current NOSETENV form and the pre-#50 form are
# recognized so upgrades cannot strand the older Oshioki artifact.
owned_sudoers_dropin_user() {
  local line user owner mode lines last
  [ -f "$SUDOERS_FILE" ] && [ ! -L "$SUDOERS_FILE" ] || return 1
  if owner="$(stat -c '%u' "$SUDOERS_FILE" 2>/dev/null)"; then
    mode="$(stat -c '%a' "$SUDOERS_FILE")"
  else
    owner="$(stat -f '%u' "$SUDOERS_FILE" 2>/dev/null)" || return 1
    mode="$(stat -f '%Lp' "$SUDOERS_FILE")"
  fi
  [ "$owner" = 0 ] || return 1
  [ "$mode" = 440 ] || return 1
  lines="$(wc -l < "$SUDOERS_FILE" | tr -d '[:space:]')"
  [ "$lines" = 1 ] || return 1
  last="$(tail -c 1 "$SUDOERS_FILE" | od -An -t x1 | tr -d '[:space:]')"
  [ "$last" = 0a ] || return 1
  line="$(sed -n '1p' "$SUDOERS_FILE")"
  case "$line" in
    *' ALL=(ALL) NOSETENV: NOPASSWD: ALL')
      user="${line% ALL=(ALL) NOSETENV: NOPASSWD: ALL}" ;;
    *' ALL=(ALL) NOPASSWD: ALL')
      user="${line% ALL=(ALL) NOPASSWD: ALL}" ;;
    *) return 1 ;;
  esac
  valid_sudoers_user "$user" || return 1
  [ "$line" = "$user ALL=(ALL) NOSETENV: NOPASSWD: ALL" ] ||
    [ "$line" = "$user ALL=(ALL) NOPASSWD: ALL" ] || return 1
  printf '%s\n' "$user"
}

# Last-chance sweep for the PAM module after a partial or interrupted
# removal. Self-contained on purpose: the packaged installer may already be
# gone by now, so this repeats the one ordering rule that matters -- never
# unlink a module some /etc/pam.d file still names, because a referenced but
# missing module is the state the install path exists to avoid. Only our own
# exact filename is ever removed. The multiarch globs cover the usual
# Debian layouts; the two unglobbed paths cover the non-multiarch ones a
# discovery run could equally have chosen, and the .oshioki-new /
# .oshioki-previous names cover a refresh that was interrupted between
# staging and the rename.
# Returns non-zero when a module was found but deliberately kept, because
# /etc/pam.d still names it. The caller must then keep the helper the module
# execs and the config it reads too: a referenced module whose helper or
# credentials are gone is exactly the broken-auth state this ordering rule
# exists to avoid.
sweep_pam_module() {
  found=0
  for module in $PAM_MODULE_GLOBS; do
    [ -f "$module" ] || continue
    found=1
    break
  done
  [ "$found" -eq 1 ] || return 0
  if [ -d "$PAM_D" ] && grep -rl liboshioki_pam "$PAM_D" >/dev/null 2>&1; then
    for module in $PAM_MODULE_GLOBS; do
      [ -f "$module" ] || continue
      echo "oshioki: warning: $PAM_D still references liboshioki_pam; leaving $module in place" >&2
    done
    return 1
  fi
  for module in $PAM_MODULE_GLOBS; do
    [ -f "$module" ] || continue
    rm -f "$module"
  done
  return 0
}

remove_verified_sudoers_dropin() {
  [ -e "$SUDOERS_FILE" ] || [ -L "$SUDOERS_FILE" ] || return 0
  owned_sudoers_dropin_user >/dev/null || return 1
  rm -f "$SUDOERS_FILE"
}

case "$1" in
  remove)
    # Mask, don't disable: the unit file is already deleted, so only a
    # mask (a symlink to /dev/null, no unit resolution) can neutralize
    # the dangling wants/ symlink. Reinstall unmasks and re-enables.
    deb-systemd-helper mask oshioki-server.service >/dev/null || true
    ;;
  purge)
    deb-systemd-helper purge oshioki-server.service >/dev/null || true
    deb-systemd-helper unmask oshioki-server.service >/dev/null || true
    # prerm normally removes this first, but purge is the last opportunity
    # after a partial or interrupted removal. This verifier is self-contained
    # because the packaged installer may already have been deleted.
    remove_verified_sudoers_dropin ||
      echo "oshioki: warning: could not remove an unverified sudoers drop-in; leaving it in place" >&2
    # Server state is never load-bearing for authentication, so it always
    # goes. The helper and its config only go when the module went with them:
    # if sweep_pam_module kept the module, /etc/pam.d still execs that helper
    # on every sudo, and removing it here would leave a referenced module
    # with nothing to run.
    if sweep_pam_module; then
      rm -rf /etc/oshioki
      rm -f /usr/local/sbin/oshioki /usr/local/libexec/sudo/oshioki.so
    else
      echo "oshioki: warning: $PAM_D still references liboshioki_pam; leaving /usr/local/sbin/oshioki and /etc/oshioki in place" >&2
    fi
    rm -rf /var/lib/oshioki
    ;;
esac

if [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
fi

exit 0
