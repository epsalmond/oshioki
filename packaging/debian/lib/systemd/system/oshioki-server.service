[Unit]
Description=Oshioki sudo approval server
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/oshioki/server.env

[Service]
Type=simple
User=oshioki
Group=oshioki
EnvironmentFile=/etc/oshioki/server.env
ExecStart=/usr/local/sbin/oshioki-server
StateDirectory=oshioki
Restart=on-failure

[Install]
WantedBy=multi-user.target
