#!/usr/bin/env bash
# test-sudo-password-race: real sudo/PAM coverage for the approval/password
# race. Every run is disposable Ubuntu 24.04; the fixture password travels
# only through a mounted file and a PTY write, never argv, environment, or
# test output.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
WORKSPACE="$(cd "$SCRIPT_DIR/.." && pwd -P)"
IMAGE="${IMAGE:-ubuntu:24.04}"
KEEP_ARTIFACTS="${OSHIOKI_E2E_KEEP_ARTIFACTS:-0}"
SHARE="$(mktemp -d -t oshioki-password.XXXXXX)"
CONTAINER="oshioki-password-${SHARE##*.}"
SECRET_FILE="$SHARE/fixture-password"
TEST_SUCCEEDED=0
AGENT_STATE=""

cleanup() {
    set +e
    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
    if [ -n "$AGENT_STATE" ]; then rm -rf "$AGENT_STATE"; fi
    if [ "$TEST_SUCCEEDED" -eq 1 ] && [ "$KEEP_ARTIFACTS" != 1 ]; then
        rm -rf "$SHARE"
    else
        echo "* retained password-race artifacts: $SHARE" >&2
    fi
}
trap cleanup EXIT

if [ "${OSHIOKI_E2E_SKIP_BUILD:-0}" = 1 ]; then
    [ -s "$WORKSPACE/target/release/liboshioki_plugin.so" ] || {
        echo "missing target/release/liboshioki_plugin.so" >&2
        exit 2
    }
    [ -x "$WORKSPACE/target/release/oshioki" ] || {
    echo "missing target/release/oshioki" >&2
        exit 2
    }
    [ -x "$WORKSPACE/target/release/oshioki-agent" ] || {
        echo "missing target/release/oshioki-agent" >&2
        exit 2
    }
else
    echo "* release: building plugin and hook"
    (cd "$WORKSPACE" && cargo build --release -p oshioki-plugin -p oshioki-hook -p oshioki-agent)
fi

# This value is deliberately created as a file. The shell never expands it in
# a command argument or exported variable, and the PTY driver reads it only to
# type the fixture response after the prompt is visible.
printf 'fixture:oshioki-password-race\n' >"$SECRET_FILE"
chmod 0400 "$SECRET_FILE"
AGENT_STATE="$(mktemp -d -t oshioki-password-agent.XXXXXX)"
"$WORKSPACE/target/release/oshioki-agent" --state "$AGENT_STATE" init --signer software >/dev/null
"$WORKSPACE/target/release/oshioki-agent" --state "$AGENT_STATE" device-record --label password-race >"$SHARE/device-record.json"

docker run -d --name "$CONTAINER" \
    -v "$WORKSPACE/target/release:/run/oshioki:ro" \
    -v "$SHARE:/run/oshioki-test:rw" \
    "$IMAGE" sleep infinity >/dev/null

docker exec "$CONTAINER" bash -ceu '
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y -qq sudo passwd >/dev/null
    chmod 0777 /run/oshioki-test
    install -d -m 0755 /usr/local/libexec/sudo /etc/oshioki
    install -m 0755 /run/oshioki/liboshioki_plugin.so /usr/local/libexec/sudo/oshioki.so
    install -m 0755 /run/oshioki/oshioki /usr/local/sbin/oshioki.real
    printf "%s" "{\"version\":1,\"devices\":[" >/etc/oshioki/devices.json
    tr -d "\n" </run/oshioki-test/device-record.json >>/etc/oshioki/devices.json
    printf "%s\n" "]}" >>/etc/oshioki/devices.json
    cat >/usr/local/sbin/oshioki <<"EOF"
#!/usr/bin/env bash
set -eu
mode="$(cat /run/oshioki-test/mode 2>/dev/null || true)"
printf "%s\n" "$$" >/run/oshioki-test/hook.pid
case "$mode" in
  approved) exit 0 ;;
  delayed-approved) sleep 1; exit 0 ;;
  denied) exit 1 ;;
  unavailable) exit 2 ;;
  delayed-unavailable) sleep 1; exit 2 ;;
  hanging) trap "" TERM; while :; do sleep 1; done ;;
  real) exec /usr/local/sbin/oshioki.real "$@" ;;
  *) exit 1 ;;
esac
EOF
    chmod 0755 /usr/local/sbin/oshioki
    cat >/usr/local/bin/oshioki-terminal-restore-test <<"EOF"
#!/usr/bin/env bash
set -eu
sudo /usr/bin/true
printf "after-sudo\\n"
IFS= read -r line
printf "read=%s\\n" "$line"
EOF
    chmod 0755 /usr/local/bin/oshioki-terminal-restore-test
    printf "%s\n" "Plugin approval_exec /usr/local/libexec/sudo/oshioki.so" >/etc/sudo.conf
    useradd --create-home --shell /bin/bash fixture
    chpasswd </run/oshioki-test/fixture-password
    printf "%s\n" "fixture ALL=(root) NOPASSWD: /usr/bin/true" >/etc/sudoers.d/oshioki-password
    chmod 0440 /etc/sudoers.d/oshioki-password
    visudo -c >/dev/null
' >/dev/null

run_case() {
    local name="$1"
    local mode="$2"
    local command="$3"
    local send_password="$4"
    local output="$SHARE/$name.log"
    scrub_secret() {
        if grep -Fq 'oshioki-password-race' "$output" 2>/dev/null; then
            sed -i 's/oshioki-password-race/[redacted]/g' "$output"
            echo "FAIL: fixture password appeared in $name output" >&2
            return 1
        fi
    }
    printf '%s\n' "$mode" >"$SHARE/mode"
    set +e
    python3 - "$CONTAINER" "$command" "$send_password" "$SECRET_FILE" >"$output" <<'PY'
import os
import pty
import select
import subprocess
import sys
import time

container, command, send_password, secret_path = sys.argv[1:]
pid, fd = pty.fork()
if pid == 0:
    os.execvp("docker", ["docker", "exec", "-i", "-t", container, "bash", "-lc", command])

with open(secret_path, "rb") as handle:
    fixture_password = handle.read().split(b":", 1)[1].strip()
wrong_password = fixture_password + b"-wrong"
sent = False
child_status = None
output = bytearray()
deadline = time.monotonic() + 12
while time.monotonic() < deadline:
    ready, _, _ = select.select([fd], [], [], 0.1)
    if ready:
        try:
            chunk = os.read(fd, 4096)
        except OSError:
            chunk = b""
        if not chunk:
            break
        output.extend(chunk)
    if send_password == "valid" and not sent and b"[sudo/oshioki] password for" in output:
        os.write(fd, fixture_password + b"\n")
        sent = True
    elif send_password == "wrong" and not sent and b"[sudo/oshioki] password for" in output:
        os.write(fd, wrong_password + b"\n")
        sent = True
    elif send_password in ("partial", "partial-after") and not sent and b"[sudo/oshioki] password for" in output:
        os.write(fd, b"partial-input")
        sent = True
    elif send_password == "partial-after" and sent and b"after-sudo" in output:
        os.write(fd, b"after-input\n")
        sent = "after-sent"
    try:
        result = os.waitpid(pid, os.WNOHANG)
    except ChildProcessError:
        break
    if result[0] == pid:
        child_status = result[1]
        break
else:
    os.kill(pid, 15)
    raise SystemExit("PTY case timed out")

while True:
    ready, _, _ = select.select([fd], [], [], 0.1)
    if not ready:
        try:
            result = os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            break
        if result[0] == pid:
            child_status = result[1]
            break
        continue
    try:
        chunk = os.read(fd, 4096)
    except OSError:
        break
    if not chunk:
        break
    output.extend(chunk)

if child_status is None:
    _, child_status = os.waitpid(pid, 0)
rc = os.waitstatus_to_exitcode(child_status)
sys.stdout.buffer.write(output)
print(f"PTY_RC={rc}")
if send_password in ("valid", "wrong", "partial", "partial-after") and b"[sudo/oshioki] password for" not in output:
    raise SystemExit("password prompt was not observed")
normalized = bytes(output).replace(b"\r\n", b"\n")
if send_password == "partial-after" and b"read=after-input\n" not in normalized:
    raise SystemExit("terminal input was consumed after the sudo child returned")
if send_password == "partial-after" and b"partial-inputafter-input" in normalized:
    raise SystemExit("partial password remained in the tty input queue")
PY
    local driver_status=$?
    set -e
    [ "$driver_status" -eq 0 ] || {
        scrub_secret || return 1
        echo "FAIL: PTY driver for $name" >&2
        sed -n '1,160p' "$output" >&2 || true
        return 1
    }
    case "$name" in
        approval-first|password-first|real-hook-password|hanging-hook|terminal-restore)
            scrub_secret || return 1
            grep -Fq 'PTY_RC=0' "$output" || { echo "FAIL: $name did not approve" >&2; return 1; }
            ;;
        wrong-password|explicit-deny|absent-transport|noninteractive)
            scrub_secret || return 1
            grep -Fq 'PTY_RC=0' "$output" && { echo "FAIL: $name unexpectedly approved" >&2; return 1; }
            ;;
    esac
    if [ "$name" = noninteractive ]; then
        ! grep -Fq '[sudo/oshioki] password for' "$output" || {
            echo 'FAIL: sudo -n reached the password tty' >&2
            return 1
        }
    fi
    echo "* PASS: $name"
}

run_case approval-first approved \
    'runuser -u fixture -- sudo /usr/bin/true; rc=$?; pid=$(cat /run/oshioki-test/hook.pid); test ! -e /proc/$pid/status; exit $rc' none
run_case password-first delayed-unavailable \
    'runuser -u fixture -- sudo /usr/bin/true' valid
run_case wrong-password unavailable \
    'runuser -u fixture -- sudo /usr/bin/true' wrong
run_case explicit-deny denied \
    'runuser -u fixture -- sudo /usr/bin/true' none
run_case hanging-hook hanging \
    'runuser -u fixture -- sudo /usr/bin/true; rc=$?; pid=$(cat /run/oshioki-test/hook.pid); test ! -e /proc/$pid/status; exit $rc' valid
run_case terminal-restore delayed-approved \
    'runuser -u fixture -- /usr/local/bin/oshioki-terminal-restore-test' partial-after

# The real hook is exercised with a deliberately absent transport and sudo -n:
# status 2 is unavailable, and the plugin must fail closed without opening a
# password reader. This keeps the fake-hook race cases deterministic while
# still proving the actual hook/plugin/sudo integration path.
run_case real-hook-password real \
    'printf "NATS_URL=nats://127.0.0.1:1\\nOSHIOKI_ALLOW_PLAINTEXT_NATS=1\\n" >/etc/oshioki/config.env; runuser -u fixture -- sudo /usr/bin/true' valid
run_case absent-transport real \
    'printf "OSHIOKI_AGENT_SOCKET=/run/oshioki-test/missing.sock\\n" >/etc/oshioki/config.env; runuser -u fixture -- sudo -n /usr/bin/true' none
run_case noninteractive unavailable \
    'runuser -u fixture -- sudo -n /usr/bin/true' none

TEST_SUCCEEDED=1
echo '* PASS: sudo password/approval race (Ubuntu 24.04, real sudo + PAM)'
