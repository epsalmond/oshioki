#!/usr/bin/env bash
set -euo pipefail

HOOK_CONFIG_DIR="${SUDO_APPROVE_TEST_CONFIG_DIR:?set SUDO_APPROVE_TEST_CONFIG_DIR}"
STATE_ROOT="${HOOK_CONFIG_DIR%/hook}"
TLS_ROOT=/tmp/sudo-approve-e2e-tls
mkdir -p "$HOOK_CONFIG_DIR" "$TLS_ROOT"
chmod 0700 "$HOOK_CONFIG_DIR"

printf '{"version":1,"origin":"%s","rp_id":"%s","server_base_url":"%s"}\n' \
  "$SUDO_APPROVE_ORIGIN" "$SUDO_APPROVE_RP_ID" "$SUDO_APPROVE_ORIGIN" \
  >"$HOOK_CONFIG_DIR/hook.json"
printf 'NATS_URL=%s\nNATS_USER=%s\nNATS_PASS=%s\n' \
  "$NATS_URL" "$NATS_USER" "$NATS_PASS" \
  >"$HOOK_CONFIG_DIR/config.env"
printf '{"version":1,"devices":[]}\n' >"$HOOK_CONFIG_DIR/devices.json"
chmod 0600 "$HOOK_CONFIG_DIR"/*.json "$HOOK_CONFIG_DIR/config.env"

openssl req -x509 -newkey rsa:2048 -nodes -days 1 \
  -subj /CN=sudo.test -addext subjectAltName=DNS:sudo.test \
  -keyout "$TLS_ROOT/key.pem" -out "$TLS_ROOT/cert.pem" >/dev/null 2>&1
export SUDO_APPROVE_TLS_KEY="$TLS_ROOT/key.pem"
export SUDO_APPROVE_TLS_CERT="$TLS_ROOT/cert.pem"
export SUDO_APPROVE_HTTPS_PORT=443

cd /work/server/web
npm run test:e2e

cd /work
SUDO_APPROVE_E2E_IN_CONTAINER=1 \
SUDO_APPROVE_E2E_SKIP_BUILD=1 \
SUDO_APPROVE_E2E_PREBUILT=1 \
  scripts/test-sudo-plugin-container

printf 'compose e2e passed; state root: %s\n' "$STATE_ROOT"
