#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
TEST_ROOT="$(mktemp -d -t sudo-hook-install-test.XXXXXX)"
trap 'rm -rf "$TEST_ROOT"' EXIT
fail() { echo "test-install-sudo-hook: $*" >&2; exit 1; }

mkdir -p "$TEST_ROOT/fake-bin" "$TEST_ROOT/service/scripts" "$TEST_ROOT/service/target/release"
cp "$SCRIPT_DIR/install-sudo-hook" "$TEST_ROOT/service/scripts/"
cp /bin/true "$TEST_ROOT/service/target/release/sudo-approve"
cp /bin/true "$TEST_ROOT/service/target/release/libplugin.so"
(
  cd "$TEST_ROOT/service/target/release"
  sha256sum sudo-approve libplugin.so > SHA256SUMS
)

for wrapper in id chown install sudo file; do
  : > "$TEST_ROOT/fake-bin/$wrapper"
done
cat > "$TEST_ROOT/fake-bin/id" <<'SH'
#!/usr/bin/env bash
[ "${1:-}" = -u ] && { echo 0; exit 0; }
exec /usr/bin/id "$@"
SH
cat > "$TEST_ROOT/fake-bin/chown" <<'SH'
#!/usr/bin/env bash
exit 0
SH
cat > "$TEST_ROOT/fake-bin/install" <<'SH'
#!/usr/bin/env bash
args=(); while [ "$#" -gt 0 ]; do case "$1" in -o|-g) shift 2;; *) args+=("$1"); shift;; esac; done
exec /usr/bin/install "${args[@]}"
SH
cat > "$TEST_ROOT/fake-bin/sudo" <<'SH'
#!/usr/bin/env bash
[ "${FAIL_SUDO:-0}" = 1 ] && exit 1
exit 0
SH
cat > "$TEST_ROOT/fake-bin/file" <<'SH'
#!/usr/bin/env bash
[ "${FAKE_FILE_MISMATCH:-0}" = 1 ] && { echo 'Mach-O arm64'; exit 0; }
exec /usr/bin/file "$@"
SH
chmod 0755 "$TEST_ROOT/fake-bin"/* "$TEST_ROOT/service/scripts/install-sudo-hook"
TEST_PATH="$TEST_ROOT/fake-bin:/usr/bin:/bin"

run_installer() {
  local root="$1"; shift
  mkdir -p "$root"
  PATH="$TEST_PATH" SUDO_CONF="$root/sudo.conf" SUDO_PLUGIN_DIR="$root/plugin" SBIN_DIR="$root/sbin" \
    SUDOERS_D="$root/sudoers.d" SUDO_APPROVE_STATE_DIR="$root/state" \
    SUDO_APPROVE_ORIGIN="https://sudo.test" SUDO_APPROVE_RP_ID="sudo.test" \
    NATS_URL="nats://nats.test:4222" NATS_PASS="${NATS_PASS:-test-only}" \
    "$TEST_ROOT/service/scripts/install-sudo-hook" "$@"
}

if run_installer "$TEST_ROOT/no-mode" >"$TEST_ROOT/no-mode.log" 2>&1; then fail "accepted omitted mode"; fi
grep -Fq 'choose exactly one mode' "$TEST_ROOT/no-mode.log" || fail "missing mode error"

PRELAUNCH="$TEST_ROOT/prelaunch"; mkdir -p "$PRELAUNCH/sudoers.d" "$PRELAUNCH/state"
printf 'outside-before\n' > "$PRELAUNCH/sudo.conf"
printf 'legacy\n' > "$PRELAUNCH/sudoers.d/management-plane-sudo-approve"
printf '{"version":1,"devices":[{"sentinel":true}]}\n' > "$PRELAUNCH/state/devices.json"
devices_hash="$(sha256sum "$PRELAUNCH/state/devices.json")"
run_installer "$PRELAUNCH" --prelaunch
[ ! -e "$PRELAUNCH/sudoers.d/management-plane-sudo-approve" ] || fail "legacy policy survived"
[ "$(sha256sum "$PRELAUNCH/state/devices.json")" = "$devices_hash" ] || fail "existing device state changed"
[ "$(grep -c '^# BEGIN sudo approve$' "$PRELAUNCH/sudo.conf")" -eq 1 ] || fail "managed block duplicated"
run_installer "$PRELAUNCH" --prelaunch
[ "$(grep -c '^# BEGIN sudo approve$' "$PRELAUNCH/sudo.conf")" -eq 1 ] || fail "rerun duplicated block"
run_installer "$PRELAUNCH" --prelaunch-status | grep -Fq enabled || fail "status did not report enabled"

dry_secret='recognizable-dry-run-secret'
dry_output="$(NATS_PASS="$dry_secret" run_installer "$PRELAUNCH" --prelaunch --dry-run 2>&1)"
grep -Fq '<redacted>' <<<"$dry_output" || fail "dry run omitted redaction"
if grep -Fq "$dry_secret" <<<"$dry_output"; then fail "dry run disclosed NATS password"; fi

outside_hash="$(printf 'outside-before\n' | sha256sum | awk '{print $1}')"
run_installer "$PRELAUNCH" --disable-prelaunch
if grep -Fq '# BEGIN sudo approve' "$PRELAUNCH/sudo.conf"; then fail "disable left managed block"; fi
[ "$(sha256sum "$PRELAUNCH/sudo.conf" | awk '{print $1}')" = "$outside_hash" ] || fail "disable changed bytes outside block"
if run_installer "$PRELAUNCH" --prelaunch-status >/dev/null 2>&1; then fail "disabled status returned success"; fi

ROLLBACK="$TEST_ROOT/rollback"; mkdir -p "$ROLLBACK"; printf 'original\n' > "$ROLLBACK/sudo.conf"; before="$(sha256sum "$ROLLBACK/sudo.conf")"
if FAIL_SUDO=1 run_installer "$ROLLBACK" --prelaunch >"$ROLLBACK/log" 2>&1; then fail "accepted sudo validation failure"; fi
[ "$(sha256sum "$ROLLBACK/sudo.conf")" = "$before" ] || fail "rollback did not restore sudo.conf"

UNSAFE="$TEST_ROOT/unsafe"; mkdir -p "$UNSAFE"; ln -s "$TEST_ROOT/elsewhere" "$UNSAFE/sudo.conf"
if run_installer "$UNSAFE" --prelaunch >"$UNSAFE/log" 2>&1; then fail "accepted symlink sudo.conf"; fi

UNSAFE_STATE="$TEST_ROOT/unsafe-state"; mkdir -p "$UNSAFE_STATE/state"; ln -s "$TEST_ROOT/elsewhere" "$UNSAFE_STATE/state/devices.json"
if run_installer "$UNSAFE_STATE" --prelaunch >"$UNSAFE_STATE/log" 2>&1; then fail "accepted symlink devices.json"; fi

BAD_BLOCK="$TEST_ROOT/bad-block"; mkdir -p "$BAD_BLOCK"; printf '# END sudo approve\n# BEGIN sudo approve\n' > "$BAD_BLOCK/sudo.conf"
if run_installer "$BAD_BLOCK" --prelaunch >"$BAD_BLOCK/log" 2>&1; then fail "accepted reversed managed block"; fi
[ ! -e "$BAD_BLOCK/sbin/sudo-approve" ] || fail "installed binaries before rejecting malformed block"

cp "$TEST_ROOT/service/target/release/SHA256SUMS" "$TEST_ROOT/service/target/release/SHA256SUMS.good"
printf '0%.0s' {1..64} > "$TEST_ROOT/service/target/release/SHA256SUMS"
printf '  sudo-approve\n' >> "$TEST_ROOT/service/target/release/SHA256SUMS"
if run_installer "$TEST_ROOT/bad-checksum" --prelaunch >"$TEST_ROOT/bad-checksum.log" 2>&1; then fail "accepted checksum mismatch"; fi
mv "$TEST_ROOT/service/target/release/SHA256SUMS.good" "$TEST_ROOT/service/target/release/SHA256SUMS"

if FAKE_FILE_MISMATCH=1 run_installer "$TEST_ROOT/bad-arch" --prelaunch >"$TEST_ROOT/bad-arch.log" 2>&1; then fail "accepted architecture mismatch"; fi

STANDALONE="$TEST_ROOT/standalone"; run_installer "$STANDALONE" --standalone-e2e
[ ! -e "$STANDALONE/sudoers.d" ] || fail "standalone created sudoers state"
echo "test-install-sudo-hook: PASS"
