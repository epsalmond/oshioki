#!/usr/bin/env bash
set -euo pipefail

ORAS_VERSION=1.3.3
case "$(uname -s):$(uname -m)" in
  Darwin:arm64) ORAS_PLATFORM=darwin_arm64; ORAS_SHA256=f33fc12753c54172b0d0d19eaa0318d3f90fe9b094d96e8b259c881713c92e1c ;;
  Linux:x86_64) ORAS_PLATFORM=linux_amd64; ORAS_SHA256=9ce999f8d2de03fc03968b29d743077a58783e545e5eaa53917ca177352d0e59 ;;
  *) echo "unsupported ORAS host platform" >&2; exit 1 ;;
esac
ACTION="${1:-}"; DIRECTORY="${2:-}"
[ -n "$ACTION" ] && [ -n "$DIRECTORY" ] || { echo "usage: oras-darwin-artifact publish|pull DIRECTORY" >&2; exit 2; }
: "${LOCAL_DOCKER_REGISTRY:?LOCAL_DOCKER_REGISTRY is required}"
: "${CI_COMMIT_SHA:?CI_COMMIT_SHA is required}"
REFERENCE="$LOCAL_DOCKER_REGISTRY/management-plane/sudo-approve-darwin:sha-$CI_COMMIT_SHA"
TMP="$(mktemp -d -t sudo-approve-oras.XXXXXX)"; trap 'rm -rf "$TMP"' EXIT
export DOCKER_CONFIG="$TMP/docker"
mkdir -p "$DOCKER_CONFIG"
archive="$TMP/oras.tar.gz"
curl --fail --location --proto '=https' --tlsv1.2 "https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/oras_${ORAS_VERSION}_${ORAS_PLATFORM}.tar.gz" --output "$archive"
if command -v sha256sum >/dev/null 2>&1; then actual="$(sha256sum "$archive" | awk '{print $1}')"; else actual="$(shasum -a 256 "$archive" | awk '{print $1}')"; fi
[ "$actual" = "$ORAS_SHA256" ] || { echo "ORAS checksum mismatch" >&2; exit 1; }
tar -xzf "$archive" -C "$TMP" oras
case "$ACTION" in
  publish)
    : "${REGISTRY_USERNAME:?REGISTRY_USERNAME is required}"; : "${REGISTRY_PASSWORD:?REGISTRY_PASSWORD is required}"
    printf '%s' "$REGISTRY_PASSWORD" | "$TMP/oras" login "$LOCAL_DOCKER_REGISTRY" --username "$REGISTRY_USERNAME" --password-stdin
    "$TMP/oras" push "$REFERENCE" --artifact-type application/vnd.psalmond.sudo-approve.darwin.v1 \
      --annotation "org.opencontainers.image.revision=$CI_COMMIT_SHA" \
      "$DIRECTORY/management-plane-sudo-approve:application/vnd.psalmond.sudo-approve.hook.v1" \
      "$DIRECTORY/approval_exec.dylib:application/vnd.psalmond.sudo-approve.plugin.v1" \
      "$DIRECTORY/manifest.json:application/vnd.psalmond.sudo-approve.manifest.v1+json" \
      "$DIRECTORY/SHA256SUMS:text/plain"
    "$TMP/oras" manifest fetch --descriptor "$REFERENCE"
    ;;
  pull)
    : "${REGISTRY_USERNAME:?REGISTRY_USERNAME is required}"; : "${REGISTRY_PASSWORD:?REGISTRY_PASSWORD is required}"
    printf '%s' "$REGISTRY_PASSWORD" | "$TMP/oras" login "$LOCAL_DOCKER_REGISTRY" --username "$REGISTRY_USERNAME" --password-stdin
    mkdir -p "$DIRECTORY"; "$TMP/oras" pull "$REFERENCE" --output "$DIRECTORY"
    (cd "$DIRECTORY" && if command -v sha256sum >/dev/null 2>&1; then sha256sum -c SHA256SUMS; else shasum -a 256 -c SHA256SUMS; fi)
    "$TMP/oras" manifest fetch --descriptor "$REFERENCE" > "$DIRECTORY/oci-descriptor.json"
    ;;
  *) echo "unknown action: $ACTION" >&2; exit 2 ;;
esac
