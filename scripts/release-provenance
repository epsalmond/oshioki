#!/usr/bin/env python3
"""Bind release asset hashes to verified source with the existing APT key."""

import hashlib
import json
import pathlib
import re
import subprocess
import sys
import tempfile


def require(condition, message):
    if not condition:
        raise ValueError(message)


def digest(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def run_gpg(home, *args):
    return subprocess.run(["gpg", "--homedir", str(home), "--batch", "--no-auto-key-retrieve",
                           *args], check=True, capture_output=True, text=True)


def process(mode, key, fingerprint, identity_path, *paths):
    require(mode in ("sign", "verify"), "mode must be sign or verify")
    require(re.fullmatch(r"[a-fA-F0-9]{40}|[a-fA-F0-9]{64}", fingerprint), "full fingerprint required")
    fingerprint = fingerprint.upper()
    identity = json.loads(pathlib.Path(identity_path).read_text())
    require(set(identity) == {"schema_version", "tag", "version", "source_commit", "tag_object"}, "invalid source identity")
    with tempfile.TemporaryDirectory(prefix="oshioki-provenance-") as directory:
        home = pathlib.Path(directory)
        home.chmod(0o700)
        run_gpg(home, "--import", key)
        key_info = run_gpg(home, "--with-colons", "--list-keys", fingerprint).stdout
        require(any(line.startswith("fpr:") and line.split(":")[9] == fingerprint
                    for line in key_info.splitlines()), "configured fingerprint not in imported key")
        if mode == "sign":
            require(len(paths) == 1, "sign requires an artifacts directory")
            assets = pathlib.Path(paths[0])
            version = identity["version"]
            names = [f"oshioki_{version}_amd64.deb", f"oshioki-macos-arm64-{version}.tar.gz", "SHA256SUMS"]
            manifest = {**identity, "repository": "epsalmond/oshioki",
                        "sha256": {name: digest(assets / name) for name in names}}
            unsigned = home / "provenance.json"
            unsigned.write_text(json.dumps(manifest, sort_keys=True, indent=2) + "\n")
            output = assets / "RELEASE-PROVENANCE.json.asc"
            require(not output.exists(), "provenance already exists; release assets are immutable")
            run_gpg(home, "--local-user", fingerprint, "--digest-algo", "SHA256", "--armor",
                    "--output", str(output), "--clearsign", str(unsigned))
        else:
            require(len(paths) == 3, "verify requires signed manifest, package and checksum files")
            signed, package, checksums = map(pathlib.Path, paths)
            unsigned = home / "provenance.json"
            result = run_gpg(home, "--status-fd", "1", "--output", str(unsigned), "--decrypt", str(signed))
            valid = [line.split() for line in result.stdout.splitlines() if line.startswith("[GNUPG:] VALIDSIG ")]
            require(len(valid) == 1 and fingerprint in (valid[0][2], valid[0][-1]), "provenance signer mismatch")
            manifest = json.loads(unsigned.read_text())
            require(all(manifest.get(name) == value for name, value in identity.items()), "provenance source identity mismatch")
            require(manifest.get("repository") == "epsalmond/oshioki", "provenance repository mismatch")
            hashes = manifest["sha256"]
            require(package.name == f"oshioki_{identity['version']}_amd64.deb", "package filename mismatch")
            require(hashes.get(package.name) == digest(package), "provenance package hash mismatch")
            require(hashes.get("SHA256SUMS") == digest(checksums), "provenance checksum hash mismatch")


if __name__ == "__main__":
    try:
        if len(sys.argv) < 6:
            raise ValueError("usage: release-provenance sign|verify KEY_FILE FINGERPRINT IDENTITY_JSON ARTIFACTS_DIR|SIGNED_MANIFEST PACKAGE CHECKSUMS")
        process(*sys.argv[1:])
    except (ValueError, KeyError, OSError, subprocess.CalledProcessError) as error:
        print(f"release-provenance: {error}", file=sys.stderr)
        sys.exit(1)
