#!/usr/bin/env python3
"""Check the shipped helper without a Google account, broker, or Touch ID."""

import base64
import hashlib
import json
import os
from pathlib import Path
import stat
import subprocess
import sys
import tempfile


def run(*args):
    return subprocess.run(args, check=True, capture_output=True, text=True, timeout=10).stdout


def main():
    if len(sys.argv) not in (3, 4) or (len(sys.argv) == 4 and sys.argv[3] != "--with-installers"):
        raise SystemExit("usage: test-browser-relay-package BINARY SHA256SUMS [--with-installers]")
    binary, sums = (Path(arg).resolve() for arg in sys.argv[1:3])
    with_installers = len(sys.argv) == 4
    assert binary.is_file() and os.access(binary, os.X_OK), "helper is not executable"
    expected = [line.split()[0] for line in sums.read_text().splitlines()
                if len(line.split()) == 2 and line.split()[1] == "oshioki-browser-relay"]
    digest = hashlib.sha256(binary.read_bytes()).hexdigest()
    assert expected == [digest], "missing, duplicate, or incorrect helper checksum"
    manifest = sums.with_name("manifest.json")
    if manifest.exists():
        entries = [item for item in json.loads(manifest.read_text())["files"]
                   if item["name"] == "oshioki-browser-relay"]
        assert len(entries) == 1 and entries[0]["sha256"] == digest, "incorrect manifest entry"
        assert entries[0]["mode"] == "755", "incorrect manifest mode"
    help_text = run(str(binary), "--help")
    for command in ("local-login", "login", "serve", "keygen"):
        assert command in help_text, f"missing {command} command"
        assert "Usage:" in run(str(binary), command, "--help")
    with tempfile.TemporaryDirectory(prefix="oshioki-package-") as directory:
        key = Path(directory) / "signing.key"
        public = run(str(binary), "keygen", str(key)).strip()
        assert len(base64.urlsafe_b64decode(public + "==")) == 65, "invalid public key"
        secret = key.read_bytes()
        assert len(base64.urlsafe_b64decode(secret.strip() + b"==")) == 32
        assert stat.S_IMODE(key.stat().st_mode) == 0o600, "key is not private"
        retry = subprocess.run([str(binary), "keygen", str(key)], capture_output=True, timeout=10)
        assert retry.returncode != 0 and key.read_bytes() == secret, "keygen overwrote a key"
    if with_installers:
        for name in ("oshioki-google-login-setup", "oshioki-browser-service"):
            helper = binary.with_name(name)
            assert helper.is_file() and os.access(helper, os.X_OK), f"missing executable {name}"
            expected_helper = [line.split()[0] for line in sums.read_text().splitlines()
                               if len(line.split()) == 2 and line.split()[1] == name]
            assert expected_helper == [hashlib.sha256(helper.read_bytes()).hexdigest()], \
                f"missing, duplicate, or incorrect {name} checksum"
            if manifest.exists():
                entries = [item for item in json.loads(manifest.read_text())["files"] if item["name"] == name]
                assert len(entries) == 1 and entries[0]["sha256"] == expected_helper[0], \
                    f"missing or incorrect {name} manifest entry"
                assert entries[0]["mode"] == "755", f"incorrect {name} manifest mode"
            assert stat.S_IMODE(helper.stat().st_mode) == 0o755, f"incorrect {name} mode"
            result = subprocess.run(["python3", str(helper), "--help"], capture_output=True,
                                    text=True, timeout=10, check=True)
            assert "usage:" in (result.stdout + result.stderr).lower(), f"{name} has no CLI help"
    print("browser package: checksums, CLI help, and private key creation passed")


if __name__ == "__main__":
    main()
