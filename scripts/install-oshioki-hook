#!/usr/bin/env bash
# Install, disable, or inspect the retained oshioki prelaunch block.
set -euo pipefail

MODE=""
DRY_RUN=0
SUPERVISED=0
CONFIG_FILE=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --prelaunch|--disable-prelaunch|--remove-sudoers-dropin|--prelaunch-status|--standalone-e2e|\
    --contextual-pam|--disable-contextual-pam|--contextual-pam-status)
      [ -z "$MODE" ] || { echo "install-oshioki-hook: choose exactly one mode" >&2; exit 2; }
      MODE="${1#--}"
      ;;
    --config-file)
      [ "$#" -ge 2 ] || { echo "install-oshioki-hook: --config-file requires a path" >&2; exit 2; }
      CONFIG_FILE="$2"
      shift
      ;;
    --dry-run) DRY_RUN=1 ;;
    # Only --contextual-pam step 7 uses this: a live `sudo true` as the named
    # account, with an administrator present to approve the device prompt.
    --supervised) SUPERVISED=1 ;;
    *) echo "install-oshioki-hook: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done
[ -n "$MODE" ] || { echo "install-oshioki-hook: choose exactly one mode" >&2; exit 2; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SERVICE_DIR="$(cd "$SCRIPT_DIR/.." && pwd -P)"
SUDO_CONF="${SUDO_CONF:-/etc/sudo.conf}"
SBIN_DIR="${SBIN_DIR:-/usr/local/sbin}"
STATE_DIR="${OSHIOKI_STATE_DIR:-/etc/oshioki}"
SUDOERS_D="${SUDOERS_D:-/etc/sudoers.d}"
MAIN_SUDOERS="${MAIN_SUDOERS:-/etc/sudoers}"
SUDOERS_FILE="$SUDOERS_D/oshioki"
ORIGIN="${OSHIOKI_ORIGIN:-}"
RP_ID="${OSHIOKI_RP_ID:-}"
NATS_URL="${NATS_URL:-}"
NATS_USER="${NATS_USER:-}"
NATS_PASS="${NATS_PASS:-}"
ALLOW_PLAINTEXT="${OSHIOKI_ALLOW_PLAINTEXT_NATS:-}"
AGENT_SOCKET="${OSHIOKI_AGENT_SOCKET:-}"
BEGIN_MARK='# BEGIN oshioki'
END_MARK='# END oshioki'
LOCK_DIR="${OSHIOKI_INSTALL_LOCK:-${STATE_DIR}.install.lock}"

case "$(uname -s)" in
  Linux) PLUGIN_DIR="${SUDO_PLUGIN_DIR:-/usr/local/libexec/sudo}"; PLUGIN_NAME=oshioki.so; BUILD_PLUGIN=liboshioki_plugin.so ;;
  Darwin) PLUGIN_DIR="${SUDO_PLUGIN_DIR:-/usr/local/libexec/sudo}"; PLUGIN_NAME=oshioki.dylib; BUILD_PLUGIN=liboshioki_plugin.dylib ;;
  *) echo "install-oshioki-hook: unsupported operating system" >&2; exit 1 ;;
esac
ROOT_GROUP=root
[ "$(uname -s)" = Darwin ] && ROOT_GROUP=wheel
HOOK_BIN="${HOOK_BIN:-$SERVICE_DIR/target/release/oshioki}"
PLUGIN_BIN="${PLUGIN_BIN:-$SERVICE_DIR/target/release/$BUILD_PLUGIN}"
PLUGIN_DEST="$PLUGIN_DIR/$PLUGIN_NAME"

die() { echo "install-oshioki-hook: $*" >&2; exit 1; }
run() { if [ "$DRY_RUN" -eq 1 ]; then printf 'DRY:'; printf ' %q' "$@"; printf '\n'; else "$@"; fi; }
regular_or_absent() { [ ! -L "$1" ] || die "refusing unsafe target: $1"; [ ! -e "$1" ] || [ -f "$1" ] || die "refusing unsafe target: $1"; }
canonicalize() {
  local p="$1" link hops=0
  while [ "$hops" -lt 40 ] && link="$(readlink "$p" 2>/dev/null)" && [ -n "$link" ]; do
    case "$link" in
      /*) p="$link" ;;
      *) p="$(dirname "$p")/$link" ;;
    esac
    hops=$((hops + 1))
  done
  if [ -L "$p" ]; then die "refusing unresolved symlink: $1"; fi
  printf '%s\n' "$p"
}
safe_directory() {
  local canon
  canon="$(canonicalize "$1")"
  [ ! -e "$canon" ] || [ -d "$canon" ] || die "refusing non-directory: $1"
}
hash_file() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'; else shasum -a 256 "$1" | awk '{print $1}'; fi; }

# Passwordless sudo lives in a sudoers.d drop-in next to the plugin block so
# one never outlives the other: the Touch ID approval becomes the only gate
# and sudo stops asking for a password. Both install only with an active
# approval device, both are verified by prelaunch-status, and both go away
# on disable and on a re-run that finds no active devices. A broken sudoers
# file locks every sudo out, so the drop-in is
# visudo-validated before it lands and sudo ignores a leaked temp file (its
# name carries a dot).
sudoers_user() { printf '%s' "${OSHIOKI_SUDO_USER:-${SUDO_USER:-}}"; }
valid_sudoers_user() {
  case "$1" in
    ''|*[!A-Za-z0-9_.-]*) return 1 ;;
  esac
  return 0
}
# `ALL` would imply SETENV; explicitly deny it so the approved environment is
# exactly the one the plugin authenticated in its RequestV1.
sudoers_line() { printf '%s ALL=(ALL) NOSETENV: NOPASSWD: ALL\n' "$1"; }
# Accept the pre-#50 spelling while removing an upgrade's old Oshioki-owned
# file. It is still accepted only as a complete root-owned 0440 drop-in at the
# exact Oshioki path, never as an arbitrary sudoers rule.
legacy_sudoers_line() { printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$1"; }
# The drop-in takes effect only when the main sudoers file includes its
# directory. Either spelling of the system path counts, and so does either
# include marker: sudo 1.9.1 added @includedir, which Ubuntu 24.04 writes.
# Only the # form may be followed by space; @includedir must be contiguous.
sudoers_included() {
  [ -f "$MAIN_SUDOERS" ] && grep -Eq "^[[:space:]]*(#[[:space:]]*|@)includedir[[:space:]]+($SUDOERS_D|/private$SUDOERS_D)([[:space:]]|$)" "$MAIN_SUDOERS" 2>/dev/null
}
find_visudo() {
  if command -v visudo >/dev/null 2>&1; then command -v visudo; return 0; fi
  [ -x /usr/sbin/visudo ] || return 1
  printf '/usr/sbin/visudo\n'
}
write_sudoers_dropin() {
  local user="$1" tmp checker
  safe_directory "$SUDOERS_D"
  regular_or_absent "$SUDOERS_FILE"
  if [ -e "$SUDOERS_FILE" ]; then
    owned_sudoers_dropin_user >/dev/null || die "refusing to overwrite unverified sudoers drop-in: $SUDOERS_FILE"
  fi
  install -d -m 0755 -o root -g "$ROOT_GROUP" "$SUDOERS_D"
  tmp="$(mktemp "${SUDOERS_FILE}.XXXXXX")"
  sudoers_line "$user" > "$tmp"
  checker="$(find_visudo)" || { rm -f "$tmp"; die "visudo not found; refusing to write $SUDOERS_FILE unchecked"; }
  if ! "$checker" -c -f "$tmp" >/dev/null 2>&1; then rm -f "$tmp"; die "visudo rejected the sudoers drop-in; $SUDO_CONF unchanged"; fi
  chmod 0440 "$tmp"; chown "root:$ROOT_GROUP" "$tmp"; mv -f "$tmp" "$SUDOERS_FILE"
}
# Install the drop-in in prelaunch only (standalone-e2e owns no sudoers
# state). Warns and keeps password authentication when the caller never
# named the laptop user or the drop-in would be ignored: both leave today's
# behavior, never a half-open sudo. Explicit garbage fails closed.
install_sudoers_dropin() {
  local user="$1"
  [ "$MODE" = prelaunch ] || return 0
  if ! registry_has_active_passwordless_devices; then
    # A software native key is readable by the account making the sudo
    # request. Keep the plugin available for an additional approval, but
    # remove any stale NOPASSWD rule so sudo still performs its normal
    # authentication first.
    echo "install-oshioki-hook: warning: active devices have no hardware-backed approval; sudo keeps asking for passwords" >&2
    remove_sudoers_dropin
    return 0
  fi
  if [ -z "$user" ]; then
    echo "install-oshioki-hook: warning: no laptop user (set OSHIOKI_SUDO_USER); sudo keeps asking for passwords" >&2
    return 0
  fi
  valid_sudoers_user "$user" || die "invalid sudoers user: $user"
  if ! sudoers_included; then
    echo "install-oshioki-hook: warning: $MAIN_SUDOERS includes no sudoers.d directory; sudo keeps asking for passwords" >&2
    return 0
  fi
  write_sudoers_dropin "$user"
}
# The dry plan mirrors the real checks without writing anything.
plan_sudoers_dropin() {
  local user="$1"
  [ "$MODE" = prelaunch ] || return 0
  if ! registry_has_active_passwordless_devices; then
    echo "DRY: keep password authentication (no hardware-backed approval device)"
    remove_sudoers_dropin
    return 0
  fi
  if [ -z "$user" ]; then echo "DRY: skip $SUDOERS_FILE (no laptop user named)"; return 0; fi
  valid_sudoers_user "$user" || die "invalid sudoers user: $user"
  if ! sudoers_included; then echo "DRY: skip $SUDOERS_FILE ($MAIN_SUDOERS includes no sudoers.d directory)"; return 0; fi
  printf 'DRY: write %s for passwordless sudo by %s\n' "$SUDOERS_FILE" "$user"
}
remove_sudoers_dropin() {
  case "$MODE" in
    prelaunch|disable-prelaunch|remove-sudoers-dropin|contextual-pam) ;;
    *) return 0 ;;
  esac
  [ -e "$SUDOERS_FILE" ] || [ -L "$SUDOERS_FILE" ] || return 0
  dropin_user=""
  dropin_user="$(owned_sudoers_dropin_user)" || die "refusing to remove unverified sudoers drop-in: $SUDOERS_FILE"
  if [ "$DRY_RUN" -eq 1 ]; then printf 'DRY: remove %s (user %s)\n' "$SUDOERS_FILE" "$dropin_user"; return 0; fi
  rm -f "$SUDOERS_FILE"
}
owned_sudoers_dropin_user() {
  local line user owner mode lines last
  [ -f "$SUDOERS_FILE" ] && [ ! -L "$SUDOERS_FILE" ] || return 1
  if owner="$(stat -c '%u' "$SUDOERS_FILE" 2>/dev/null)"; then
    mode="$(stat -c '%a' "$SUDOERS_FILE")"
  else
    owner="$(stat -f '%u' "$SUDOERS_FILE" 2>/dev/null)" || return 1
    mode="$(stat -f '%Lp' "$SUDOERS_FILE")"
  fi
  [ "$owner" -eq 0 ] || return 1
  [ "$mode" = 440 ] || return 1
  lines="$(wc -l < "$SUDOERS_FILE" | tr -d '[:space:]')"
  [ "$lines" = 1 ] || return 1
  last="$(tail -c 1 "$SUDOERS_FILE" | od -An -t x1 | tr -d '[:space:]')"
  [ "$last" = 0a ] || return 1
  line="$(sed -n '1p' "$SUDOERS_FILE")"
  case "$line" in
    ' '*|*$'\t'*) return 1 ;;
  esac
  user="${line%% ALL=(ALL) *}"
  valid_sudoers_user "$user" || return 1
  [ "$line" = "$(sudoers_line "$user")" ] ||
    [ "$line" = "$(legacy_sudoers_line "$user")" ] || return 1
  printf '%s\n' "$user"
}
dropin_ok() {
  local user="$1" dropin_user
  [ -n "$user" ] || return 1
  dropin_user="$(owned_sudoers_dropin_user)" || return 1
  [ "$dropin_user" = "$user" ]
}
backup=""; dropin_backup=""
dropin_original_present=0
rollback_armed=0
# The enable/disable windows rewrite sudo.conf before sudo -V proves the
# result, and the drop-in install between them can still fail (visudo
# refusal, invalid user). Every failure path restores both files so the
# managed block and the drop-in never outlive each other; the EXIT trap is
# the backstop for die and set -e exits inside the window.
restore_sudo_backups() {
  [ "$rollback_armed" -eq 1 ] || return 0
  # Roll back in the reverse order of migration: restore sudo.conf (and its
  # approval plugin) while the blanket rule is still absent, then restore the
  # verified sudoers rule. This keeps an interrupted rollback fail-closed.
  if [ -n "$backup" ] && [ -f "$backup" ]; then
    if ! cp -p "$backup" "$SUDO_CONF"; then
      echo "install-oshioki-hook: rollback could not restore sudo.conf; leaving the sudoers rule absent" >&2
      return 1
    fi
    if ! rm -f "$backup"; then
      echo "install-oshioki-hook: rollback could not remove its sudo.conf backup; leaving the sudoers rule absent" >&2
      return 1
    fi
    pam_trace "pam:rollback:plugin-restored:$SUDO_CONF"
  fi
  # rm first: the drop-in is 0440, so overwriting it in place fails.
  if [ -n "$dropin_backup" ] && [ -f "$dropin_backup" ]; then
    if ! rm -f "$SUDOERS_FILE"; then
      echo "install-oshioki-hook: rollback could not remove the current sudoers rule" >&2
      return 1
    fi
    if ! cp -p "$dropin_backup" "$SUDOERS_FILE"; then
      echo "install-oshioki-hook: rollback could not restore the sudoers rule" >&2
      return 1
    fi
    if ! rm -f "$dropin_backup"; then
      echo "install-oshioki-hook: rollback could not remove its sudoers backup" >&2
      return 1
    fi
    pam_trace "pam:rollback:dropin-restored:$SUDOERS_FILE"
    # Keep repeated EXIT-trap cleanup idempotent: a second pass must not
    # mistake this restored file for a newly-created drop-in.
    dropin_original_present=1
  elif [ "$dropin_original_present" -eq 0 ] && owned_sudoers_dropin_user >/dev/null 2>&1; then
    rm -f "$SUDOERS_FILE"
  fi
  backup=""; dropin_backup=""; rollback_armed=0
}
drop_sudo_backups() {
  local old_backup="$backup" old_dropin_backup="$dropin_backup" cleanup_failed=0
  # The managed state is complete before this cleanup starts. Disarm and
  # clear the rollback inputs first; a cleanup error or signal must never
  # restore only one of the two privilege artifacts.
  backup=""; dropin_backup=""; dropin_original_present=0; rollback_armed=0
  if [ -n "$old_backup" ] && ! rm -f "$old_backup"; then
    echo "install-oshioki-hook: could not remove its sudo.conf rollback backup" >&2
    cleanup_failed=1
  fi
  if [ -n "$old_dropin_backup" ] && ! rm -f "$old_dropin_backup"; then
    echo "install-oshioki-hook: could not remove its sudoers rollback backup" >&2
    cleanup_failed=1
  fi
  return "$cleanup_failed"
}
capture_dropin_backup() {
  # Arm rollback before any managed sudo state is changed. The EXIT trap is
  # intentionally inert after drop_sudo_backups disarms a successful window.
  local tmp
  rollback_armed=1
  dropin_backup=""
  if [ -e "$SUDOERS_FILE" ] || [ -L "$SUDOERS_FILE" ]; then
    dropin_original_present=1
    owned_sudoers_dropin_user >/dev/null 2>&1 ||
      die "refusing to modify unverified sudoers drop-in: $SUDOERS_FILE"
    tmp="$(mktemp "${SUDOERS_FILE}.backup.XXXXXX")" ||
      die "could not create a sudoers rollback backup"
    if ! cp -p "$SUDOERS_FILE" "$tmp"; then
      rm -f "$tmp"
      die "could not back up the sudoers rule"
    fi
    dropin_backup="$tmp"
  else
    dropin_original_present=0
  fi
}
capture_sudo_conf_backup() {
  local suffix="${1:-rollback}" tmp
  tmp="$(mktemp "${SUDO_CONF}.${suffix}.XXXXXX")" ||
    die "could not create a sudo.conf rollback backup"
  if ! cp -p "$SUDO_CONF" "$tmp"; then
    rm -f "$tmp"
    die "could not back up sudo.conf"
  fi
  backup="$tmp"
}

# Before replacing an installed hook or plugin, take the managed sudo
# authorization out of service and prove ordinary sudo still parses the
# resulting configuration. This ordering is important on an interrupted
# upgrade: a half-installed pair must leave sudo using its normal policy, not
# a plugin whose companion may have a different private protocol.
has_managed_state() {
  { [ -f "$SUDO_CONF" ] && {
      grep -Fq "$BEGIN_MARK" "$SUDO_CONF" ||
      grep -Fq "$END_MARK" "$SUDO_CONF" ||
      has_our_plugin;
    }; } ||
    [ -e "$SUDOERS_FILE" ] || [ -L "$SUDOERS_FILE" ];
}

prepare_upgrade() {
  has_managed_state || return 0
  if [ "$DRY_RUN" -eq 1 ]; then
    # Show the same safety order as the real transition: blanket rule first,
    # then the legacy approval plugin.
    remove_sudoers_dropin
    [ -f "$SUDO_CONF" ] && {
      grep -Fq "$BEGIN_MARK" "$SUDO_CONF" ||
      grep -Fq "$END_MARK" "$SUDO_CONF" ||
      has_our_plugin;
    } && echo "DRY: remove the managed Oshioki plugin block from $SUDO_CONF"
    validate_sudo
    return 0
  fi

  if [ -f "$SUDO_CONF" ]; then
    capture_dropin_backup
    capture_sudo_conf_backup upgrade-rollback
  else
    # A drop-in can survive after an administrator removed sudo.conf. Keep its
    # verified backup while normal sudo is checked, then restore it on error.
    capture_dropin_backup
  fi
  # Remove the blanket permission before removing the plugin that used to
  # protect it. A failure to identify or remove the rule therefore leaves the
  # legacy approval path intact.
  remove_sudoers_dropin
  if [ -f "$SUDO_CONF" ]; then
    rewrite_block disable "$SUDO_CONF" "$SUDO_CONF"
  fi
  if ! validate_sudo; then
    restore_sudo_backups
    die "normal sudo validation failed before replacing the hook and plugin"
  fi
  # The disabled state is intentional from this point through both artifact
  # installs. An EXIT trap must not restore the old authorization after a
  # partial copy.
  drop_sudo_backups
}

# True when the hook would refuse NATS_URL as plaintext past loopback. The
# hook itself is authoritative; this only warns at install time so a bad URL
# is caught here instead of at the first sudo afterwards.
needs_tls_warning() {
  case "$NATS_URL" in
    [Tt][Ll][Ss]://*) return 1 ;;
    [Nn][Aa][Tt][Ss]://*) ;;
    *) return 1 ;;
  esac
  [ -z "$ALLOW_PLAINTEXT" ] || return 1
  local rest host
  rest="${NATS_URL#*://}"
  rest="${rest%%/*}"; rest="${rest%%\?*}"; rest="${rest%%#*}"
  host="${rest##*@}"
  case "$host" in
    \[*\]*) host="$(printf '%s' "$host" | sed 's/^\[//; s/\].*//')" ;;
    *) host="${host%%:*}" ;;
  esac
  case "$host" in
    ""|[Ll][Oo][Cc][Aa][Ll][Hh][Oo][Ss][Tt]|127.*|::1) return 1 ;;
  esac
  return 0
}

load_config_file() {
  local path="$1" owner mode line key value
  if [ ! -f "$path" ] || [ -L "$path" ]; then
    die "config file must be a regular file: $path"
  fi
  if owner="$(stat -c '%u' "$path" 2>/dev/null)"; then
    mode="$(stat -c '%a' "$path")"
  else
    owner="$(stat -f '%u' "$path")"
    mode="$(stat -f '%Lp' "$path")"
  fi
  [ "$owner" -eq 0 ] || die "config file must be owned by root: $path"
  [ "$mode" = 600 ] || die "config file must have mode 0600: $path"
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    case "$line" in \#*) continue ;; esac
    case "$line" in *=*) ;; *) die "invalid config line in $path" ;; esac
    key="${line%%=*}"
    value="${line#*=}"
    case "$value" in
      [[:space:]]*|*[[:space:]]|\"*\"|\'*\') die "config value must be unquoted and untrimmed: $key" ;;
    esac
    case "$key" in
      OSHIOKI_ORIGIN) ORIGIN="$value" ;;
      OSHIOKI_RP_ID) RP_ID="$value" ;;
      NATS_URL) NATS_URL="$value" ;;
      NATS_USER) NATS_USER="$value" ;;
      NATS_PASS) NATS_PASS="$value" ;;
      OSHIOKI_ALLOW_PLAINTEXT_NATS) ALLOW_PLAINTEXT="$value" ;;
      OSHIOKI_AGENT_SOCKET) AGENT_SOCKET="$value" ;;
      OSHIOKI_LOCAL) : ;; # local-setup marker; inert, kept so the mode is visible in the file
      OSHIOKI_CONTEXTUAL_PAM) : ;; # read by the Debian postinst to opt into --contextual-pam; inert here
      *) die "unknown config key in $path: $key" ;;
    esac
  done < "$path"
}

# A software native device is explicitly not eligible for passwordless sudo:
# the enrolled account can read its signing key and replace its socket. The
# registry is machine-written by this installer and serde emits `kind` before
# `active`; resetting at each record's version keeps legacy records (which
# default to WebAuthn) eligible while recognizing a software record even when
# each JSON field occupies its own line.
# One of: absent (no registry yet), empty (registry, no active device),
# software-only (active devices, none hardware-backed), eligible, or corrupt
# (something is there but it is not a device registry). Only the last is a
# reason to stop: the migration's "not yet" path needs to tell an operator
# which of the first three they are looking at.
registry_device_state() {
  local file="$STATE_DIR/devices.json"
  [ -e "$file" ] || { printf 'absent\n'; return 0; }
  { [ -f "$file" ] && [ -r "$file" ]; } || { printf 'corrupt\n'; return 0; }
  grep -Fq '"devices"' "$file" 2>/dev/null || { printf 'corrupt\n'; return 0; }
  if registry_has_active_passwordless_devices; then printf 'eligible\n'; return 0; fi
  if grep -Eq '"active":[[:space:]]*true' "$file" 2>/dev/null; then
    printf 'software-only\n'
    return 0
  fi
  printf 'empty\n'
}

registry_has_active_passwordless_devices() {
  [ -f "$STATE_DIR/devices.json" ] || return 1
  awk '
    /"version"[[:space:]]*:/ { software=0 }
    /"kind"[[:space:]]*:[[:space:]]*"software"/ { software=1 }
    /"active"[[:space:]]*:[[:space:]]*true/ && !software { found=1 }
    END { exit found ? 0 : 1 }
  ' "$STATE_DIR/devices.json"
}

# Resolve caller-supplied paths (e.g. Homebrew prefix symlinks) to the real
# files before the safety checks below. Checksum lookup uses the resolved
# basename, so links must keep the artifact filename.
HOOK_BIN="$(canonicalize "$HOOK_BIN")"
PLUGIN_BIN="$(canonicalize "$PLUGIN_BIN")"

[ -z "$CONFIG_FILE" ] || load_config_file "$CONFIG_FILE"

validate_marker_pair() {
  local source="$1" begin="$2" end="$3" begins ends begin_line end_line
  begins="$(grep -cF "$begin" "$source" 2>/dev/null || true)"
  ends="$(grep -cF "$end" "$source" 2>/dev/null || true)"
  if ! { { [ "$begins" -eq 0 ] && [ "$ends" -eq 0 ]; } ||
    { [ "$begins" -eq 1 ] && [ "$ends" -eq 1 ]; }; }; then
    echo "install-oshioki-hook: malformed managed block in $source" >&2
    return 1
  fi
  if [ "$begins" -eq 1 ]; then
    begin_line="$(grep -nF "$begin" "$source" | cut -d: -f1)"
    end_line="$(grep -nF "$end" "$source" | cut -d: -f1)"
    if [ "$begin_line" -ge "$end_line" ]; then
      echo "install-oshioki-hook: malformed managed block in $source" >&2
      return 1
    fi
  fi
}

validate_block() {
  local source="$1"
  validate_marker_pair "$source" "$BEGIN_MARK" "$END_MARK"
}

# ---------------------------------------------------------------------------
# Contextual PAM authentication (issue #73)
#
# The legacy lane is a sudo plugin plus a blanket NOPASSWD rule in
# sudoers.d. The contextual lane is a PAM auth module referenced from the
# `sudo` service stack, with no sudoers rule at all: sudo keeps asking for
# authentication and the module answers it from a hardware device, falling
# back to the ordinary password when it cannot.
#
# Everything below owns exactly two artifacts per host: the module file in
# the platform security directory, and one marker-delimited block per PAM
# service file. `common-auth` is never touched and `pam-auth-update` is never
# invoked: a mistake there would reach every service on the host, not just
# sudo.
# ---------------------------------------------------------------------------
PAM_BEGIN_MARK='# BEGIN oshioki pam'
PAM_END_MARK='# END oshioki pam'
PAM_D="${PAM_D:-/etc/pam.d}"
PAM_MODULE_BIN="${PAM_MODULE_BIN:-}"
PAM_MULTIARCH_FILE="${OSHIOKI_PAM_MULTIARCH:-/usr/share/oshioki/pam-multiarch}"
case "$(uname -s)" in
  Darwin)
    PAM_MODULE_NAME=liboshioki_pam.dylib
    PAM_SERVICES="sudo_local"
    ;;
  *)
    PAM_MODULE_NAME=liboshioki_pam.so
    PAM_SERVICES="sudo sudo-i"
    ;;
esac
# A packaging/test override in the same class as SUDO_PLUGIN_DIR and SBIN_DIR.
# When it is empty the directory is discovered, never assumed.
PAM_SECURITY_DIR="${PAM_SECURITY_DIR:-}"

# One line per migration step, for the tests that assert the rollback chain
# order. Inert unless INSTALL_TRACE names a file; the existing fake `cp` and
# `rm` wrappers write to the same log, so step lines and file operations
# interleave in real execution order.
pam_trace() { [ -z "${INSTALL_TRACE:-}" ] || printf '%s\n' "$1" >> "$INSTALL_TRACE"; }

pam_module_dest() { printf '%s/%s\n' "$1" "$PAM_MODULE_NAME"; }
# The exact auth line, byte for byte. Linux gets a bracket control because
# Linux-PAM has one; see pam/README.md for why each token is there, and in
# particular why `module_unknown=ignore` is the difference between a degraded
# install and a host where no sudo can ever succeed. macOS has no bracket
# controls, so its ordinary auth error remains available for password fallback.
pam_auth_line() {
  if [ "$(uname -s)" = Darwin ]; then
    printf 'auth       sufficient     %s\n' "$(pam_module_dest "$1")"
  else
    printf 'auth [success=done authinfo_unavail=ignore module_unknown=ignore ignore=ignore default=die] %s\n' "$PAM_MODULE_NAME"
  fi
}

# True when this host is already on the contextual PAM lane: some sudo
# service file carries our marker, or names our module on an auth line. The
# second test is deliberately looser than the exact line the installer
# writes -- a half-edited or hand-modified entry still means the module is
# live, and every caller of this predicate uses it to withhold or undo
# something, never to grant.
# Only the service names PAM actually reads: a `sudo.XXXXXX` left behind by
# a crashed edit is litter, not a live lane, and treating it as one would
# withhold the plugin lane from that host forever.
pam_lane_active() {
  local service file
  for service in $PAM_SERVICES; do
    file="$PAM_D/$service"
    [ -f "$file" ] || continue
    if grep -Fq "$PAM_BEGIN_MARK" "$file" 2>/dev/null; then return 0; fi
    if grep -Eq '^[[:space:]]*auth[[:space:]].*liboshioki_pam' "$file" 2>/dev/null; then return 0; fi
  done
  return 1
}

stat_owner() { stat -c '%u' "$1" 2>/dev/null || stat -f '%u' "$1" 2>/dev/null; }
stat_mode() { stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null; }

# The mode as exactly four octal digits: special, user, group, other.
padded_mode() {
  local mode
  mode="$(stat_mode "$1")" || return 1
  case "$mode" in
    ''|*[!0-7]*) return 1 ;;
  esac
  while [ "${#mode}" -lt 4 ]; do mode="0$mode"; done
  [ "${#mode}" -eq 4 ] || return 1
  printf '%s\n' "$mode"
}

# Root-owned and not writable by anyone else. Used for the helper the module
# execs and for every parent directory on its path: a writable parent is a
# writable helper one rename later.
path_is_root_owned_and_tight() {
  local target="$1" owner mode
  owner="$(stat_owner "$target")" || return 1
  [ "$owner" = 0 ] || return 1
  mode="$(padded_mode "$target")" || return 1
  # Group- and world-writable both lose: 2, 3, 6 and 7 all carry the write
  # bit. A writable parent directory is a writable helper one rename later.
  case "${mode:2:1}" in 2|3|6|7) return 1 ;; esac
  case "${mode:3:1}" in 2|3|6|7) return 1 ;; esac
  return 0
}

helper_path_secure() {
  local helper="$SBIN_DIR/oshioki" directory mode
  [ -f "$helper" ] && [ ! -L "$helper" ] || return 1
  path_is_root_owned_and_tight "$helper" || return 1
  mode="$(padded_mode "$helper")" || return 1
  # No setuid and no setgid: the module runs the helper from sudo's already
  # privileged PAM process and must never grant it privilege of its own.
  case "${mode:0:1}" in 2|3|4|5|6|7) return 1 ;; esac
  # At least one execute bit. The module's own path check rejects a helper
  # with `mode & 0o111 == 0` as insecure, and on Linux under `default=die`
  # that refusal fails every sudo before a password prompt is ever drawn --
  # so precheck and status must refuse it here, where there is still somewhere
  # to print a fix. Mirror the module's test exactly rather than demanding
  # only the owner bit.
  [ "$((8#$mode & 8#111))" -ne 0 ] || return 1
  directory="$(dirname "$helper")"
  while :; do
    path_is_root_owned_and_tight "$directory" || return 1
    [ "$directory" != / ] || break
    directory="$(dirname "$directory")"
  done
  return 0
}

# A Darwin PAM directory may be absent on a fresh host. It is safe to create
# only the final leaf when every existing component is a root-owned directory
# with no group/other write bit. Discovery rejects a symlink at the leaf and
# resolves trusted ancestor symlinks before this canonical-path walk: this
# directory is where sudo loads root-context code.
pam_security_path_secure() {
  local path="$1" parent
  while :; do
    [ ! -L "$path" ] || return 1
    if [ -e "$path" ]; then
      [ -d "$path" ] || return 1
      path_is_root_owned_and_tight "$path" || return 1
    fi
    [ "$path" = / ] && break
    parent="$(dirname "$path")"
    [ "$parent" != "$path" ] || break
    path="$parent"
  done
  return 0
}

pam_security_dir_secure() {
  local dir="$1"
  [ -d "$dir" ] && [ ! -L "$dir" ] || return 1
  pam_security_path_secure "$dir"
}

# Resolve every existing ancestor while retaining the final component. The
# generic canonicalize helper follows only a symlink that names the complete
# path; it would miss merged-/usr paths such as /lib/security where /lib is
# the symlink. The leaf is checked separately before this helper is called.
physical_directory_path() {
  local path="$1" parent
  path="${path%/}"
  [ -n "$path" ] || path=/
  [ "$path" = / ] && { printf '/\n'; return 0; }
  parent="$(cd "$(dirname "$path")" 2>/dev/null && pwd -P)" || return 1
  printf '%s/%s\n' "$parent" "$(basename "$path")"
}

pam_security_dir_created=0

# Where this platform keeps PAM modules. Discovered from the packaging
# database first, because a hard-coded multiarch triplet is wrong on every
# architecture but one, and a module written to the wrong directory is a
# module PAM cannot find -- which `module_unknown=ignore` turns into a silent
# password-only host rather than a visible error.
discover_security_dir() {
  local dir="" candidate listed triplet parent
  if [ -n "$PAM_SECURITY_DIR" ]; then
    dir="$PAM_SECURITY_DIR"
    # An explicit override is still checked, just against a weaker shape than
    # a discovered path: it must be absolute and end in the directory name
    # PAM module directories actually use. A packager pointing at a staging
    # root or a distribution with a different prefix is legitimate; a typo
    # that lands on /tmp or a home directory is not. The strong system-path
    # regex below cannot be applied here because it would reject every
    # staging root by construction.
    printf '%s\n' "$dir" | grep -Eq '^/([A-Za-z0-9._+-]+/)*(security|pam)$' ||
      die "refusing an implausible PAM security directory override: $dir"
  elif [ "$(uname -s)" = Darwin ]; then
    # /usr/lib/pam is SIP-protected. The module goes beside it in /usr/local
    # and is referenced by absolute path, so OpenPAM's search path and its
    # `.so.N` version probing never come into it.
    dir=/usr/local/lib/pam
  else
    if command -v dpkg-query >/dev/null 2>&1; then
      listed="$(dpkg-query -L libpam-modules 2>/dev/null | grep -E '/pam_unix\.so$' | head -1 || true)"
      [ -z "$listed" ] || dir="$(dirname "$listed")"
    fi
    if [ -z "$dir" ]; then
      for candidate in "/usr/lib/$(uname -m)-linux-gnu/security" /lib/security /usr/lib/security; do
        [ -d "$candidate" ] || continue
        dir="$candidate"
        break
      done
    fi
    [ -n "$dir" ] || die "could not locate the PAM security directory"
    printf '%s\n' "$dir" | grep -Eq '^((/usr)?/lib/[a-z0-9_]+-linux-[a-z]+/security|/(usr/)?lib/security)$' ||
      die "refusing an unexpected PAM security directory: $dir"
  fi
  # This directory holds code libpam loads into every privileged sudo. On
  # macOS its absolute path is written into sudo_local, so a directory
  # anybody can write to is a standing offer to replace root-loaded code.
  # A fresh Darwin host may lack only the final leaf; dry-run reports the same
  # create step while the real migration creates it after the rollback inputs
  # are armed. The parent must already exist so we never recursively create an
  # unsafe path. Resolve trusted ancestor symlinks before checking their
  # ownership: merged-/usr Linux hosts commonly expose /lib this way. The
  # final leaf itself is never accepted as a symlink.
  if [ -L "$dir" ]; then
    die "refusing symlink PAM security directory: $dir"
  elif [ ! -e "$dir" ]; then
    [ "$MODE" = contextual-pam ] || die "PAM security directory does not exist: $dir"
    parent="$(dirname "$dir")"
    [ -d "$parent" ] || die "PAM security directory parent does not exist: $parent"
    # The parent itself may be a symlink (for example /lib on a merged-/usr
    # host), so resolve the complete existing directory rather than retaining
    # its final component as physical_directory_path intentionally does.
    parent="$(cd "$parent" 2>/dev/null && pwd -P)" ||
      die "could not resolve PAM security directory parent: $parent"
    pam_security_path_secure "$parent" ||
      die "refusing a PAM security directory that is not root-owned and not writable by others: $dir"
    dir="$parent/$(basename "$dir")"
  elif [ ! -d "$dir" ]; then
    die "refusing non-directory PAM security path: $dir"
  else
    dir="$(physical_directory_path "$dir")" ||
      die "could not resolve PAM security directory: $dir"
    pam_security_dir_secure "$dir" ||
      die "refusing a PAM security directory that is not root-owned and not writable by others: $dir"
  fi
  if [ "$(uname -s)" != Darwin ]; then
    # If pam_unix.so is not here, this is not the directory PAM loads from,
    # whatever the path looks like.
    [ -f "$dir/pam_unix.so" ] || die "no pam_unix.so in $dir; refusing to install a PAM module there"
    # On a .deb install the build recorded the multiarch triplet it was built
    # for. A mismatch means the package and the host disagree about the
    # architecture; that is a hard refusal, never a warning.
    if [ -f "$PAM_MULTIARCH_FILE" ]; then
      triplet="$(head -1 "$PAM_MULTIARCH_FILE" | tr -d '[:space:]')"
      if [ -n "$triplet" ]; then
        case "$dir" in
          "/usr/lib/$triplet/security"|"/lib/$triplet/security") ;;
          *) die "packaged multiarch $triplet does not match the discovered $dir" ;;
        esac
      fi
    fi
  fi
  printf '%s\n' "$dir"
}

# Create the missing Darwin leaf after all rollback inputs have been captured.
# Existing directories are rechecked here to close the preflight-to-write
# window; a directory made by this invocation is removed by cleanup_install if
# any later migration step fails, but only while it remains empty.
ensure_pam_security_dir() {
  local dir="$1" parent
  if [ -e "$dir" ] || [ -L "$dir" ]; then
    [ ! -L "$dir" ] || die "refusing symlink PAM security directory: $dir; restored the prior configuration"
    pam_security_dir_secure "$dir" ||
      die "refusing a PAM security directory that is not root-owned and not writable by others: $dir; restored the prior configuration"
    return 0
  fi
  parent="$(dirname "$dir")"
  [ -d "$parent" ] || die "PAM security directory parent does not exist: $parent; restored the prior configuration"
  pam_security_path_secure "$parent" ||
    die "refusing a PAM security directory that is not root-owned and not writable by others: $dir; restored the prior configuration"
  [ "$DRY_RUN" -eq 0 ] || return 0
  install -d -m 0755 -o root -g "$ROOT_GROUP" "$dir" ||
    die "could not create PAM security directory: $dir; restored the prior configuration"
  pam_security_dir_created=1
  pam_security_dir_secure "$dir" ||
    die "created PAM security directory is not root-owned and not writable by others: $dir; restored the prior configuration"
}

# The file as an administrator's stock content: our owned block removed, then
# comments and blank lines dropped. Fingerprinting this rather than the raw
# file is what makes a re-run see the same stack the first run saw.
pam_stock_view() {
  local file="$1" line
  line="$(pam_auth_line "${2:-}")"
  [ -f "$file" ] || return 0
  awk -v begin="$PAM_BEGIN_MARK" -v end="$PAM_END_MARK" -v authline="${line%$'\n'}" '
    $0 == begin { inside=1; next }
    $0 == end { inside=0; next }
    inside { next }
    $0 == authline { next }
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    { print }
  ' "$file"
}

# 0 = stock and editable, 1 = refuse, 2 = inherits the edit from another
# service and must be skipped. Every refusal leaves the file untouched.
pam_fingerprint_ok() {
  local service="$1" dir="${2:-}" file view
  file="$PAM_D/$service"
  [ ! -L "$file" ] || return 1
  if [ "$(uname -s)" = Darwin ]; then
    pam_fingerprint_ok_darwin "$service" "$dir"
    return
  fi
  # 3 = the service file does not exist on this host. Not every distribution
  # ships sudo-i, and a service we were never asked to edit is not the same
  # thing as one whose contents we refuse.
  [ -f "$file" ] || return 3
  # A line continued with a trailing backslash joins the next one, so the
  # comment- and block-stripped view is not a faithful reading of what PAM
  # parses -- a continued comment can swallow an auth line, or an auth line
  # can be spelled across two. Refuse rather than guess.
  if grep -q '\\$' "$file"; then
    return 1
  fi
  view="$(pam_stock_view "$file" "$dir")"
  # `sudo-i` is often just `@include sudo`, in which case editing `sudo` has
  # already covered it and a second block would run the module twice.
  # Every match here is case-insensitive: Linux-PAM compares the type and
  # the @include directive with strcasecmp, so `AUTH` and `@Include` are the
  # same words to it and must be the same words to us.
  if printf '%s\n' "$view" | grep -Eqi '^[[:space:]]*@include[[:space:]]+sudo$'; then
    return 2
  fi
  # An administrator with their own auth policy in this service is not a
  # stack we understand well enough to edit.
  #
  # Every pattern here tolerates leading whitespace because Linux-PAM does:
  # it strips it before parsing, so `  auth required pam_faillock.so preauth`
  # is a live second factor. A column-0 anchor would call that file stock and
  # land our `success=done` block after it, silently disabling the factor.
  if printf '%s\n' "$view" | grep -Eqi '^[[:space:]]*auth[[:space:]]'; then
    return 1
  fi
  [ "$(printf '%s\n' "$view" | grep -Eci '^[[:space:]]*@include[[:space:]]+common-auth$')" = 1 ] || return 1
  # A liboshioki_pam reference outside our marker pair belongs to someone
  # else; we never adopt it and never write a second one next to it.
  if printf '%s\n' "$view" | grep -Fq liboshioki_pam; then
    return 1
  fi
  return 0
}

# macOS: the module goes in sudo_local, but only if /etc/pam.d/sudo is the
# stock stack that includes sudo_local as its first auth line. sudo_local
# itself may hold comments, a pam_tid line, and our block -- nothing else.
pam_fingerprint_ok_darwin() {
  local dir="${2:-}" sudo_view local_view
  [ -f "$PAM_D/sudo" ] && [ ! -L "$PAM_D/sudo" ] || return 1
  if grep -q '\\$' "$PAM_D/sudo"; then
    return 1
  fi
  if [ -f "$PAM_D/sudo_local" ] && grep -q '\\$' "$PAM_D/sudo_local"; then
    return 1
  fi
  # Leading whitespace is tolerated for the same reason as on Linux: OpenPAM
  # strips it, so an indented auth line is a live one.
  sudo_view="$(pam_stock_view "$PAM_D/sudo" "$dir" | grep -Ei '^[[:space:]]*auth[[:space:]]' || true)"
  [ "$(printf '%s\n' "$sudo_view" | sed -n '1p')" != "" ] || return 1
  printf '%s\n' "$sudo_view" | sed -n '1p' | grep -Eqi '^[[:space:]]*auth[[:space:]]+include[[:space:]]+sudo_local$' || return 1
  printf '%s\n' "$sudo_view" | sed -n '2p' | grep -Fq pam_smartcard.so || return 1
  printf '%s\n' "$sudo_view" | sed -n '3p' | grep -Fq pam_opendirectory.so || return 1
  [ "$(printf '%s\n' "$sudo_view" | grep -c .)" = 3 ] || return 1
  if [ -e "$PAM_D/sudo_local" ]; then
    [ -f "$PAM_D/sudo_local" ] && [ ! -L "$PAM_D/sudo_local" ] || return 1
    local_view="$(pam_stock_view "$PAM_D/sudo_local" "$dir")"
    # Comments and blanks are already gone from the view. What may remain is
    # an administrator's pam_tid line and nothing else.
    if printf '%s\n' "$local_view" | grep -q .; then
      if printf '%s\n' "$local_view" | grep -q . && \
         printf '%s\n' "$local_view" | grep -vEqi '^[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so$'; then
        return 1
      fi
    fi
  fi
  return 0
}

pam_block_present() {
  local file="$1" dir="${2:-}" line
  line="$(pam_auth_line "$dir")"
  [ -f "$file" ] || return 1
  grep -Fxq "$PAM_BEGIN_MARK" "$file" 2>/dev/null || return 1
  grep -Fxq "${line%$'\n'}" "$file" 2>/dev/null
}

# Known and accepted, reviewed with the rest of this block:
#
# * No fsync before the rename. The temp file is renamed into place, which is
#   atomic against a concurrent reader, but a power loss immediately after can
#   leave a zero-length PAM file. This matches rewrite_block above and the
#   sudoers drop-in writer; fixing it here alone would buy nothing, and
#   `module_unknown=ignore` plus `@include common-auth` means a truncated
#   sudo service still reaches pam_unix.
# * A SIGKILL (which no trap can catch) leaves this function's mktemp file,
#   and capture_pam_backups' snapshot, on disk. Both carry a dot in their
#   names so PAM's own service lookup never matches them, and the next run
#   overwrites the live file regardless; they are litter, not a hazard.
#
# awk's `print` always terminates a line, so a rewrite would silently add a
# trailing newline to a file that had none. Match the source exactly: a
# round trip through write + remove must be byte-identical.
pam_match_trailing_newline() {
  local source="$1" staged="$2" size
  [ -f "$source" ] && [ -s "$source" ] || return 0
  [ "$(tail -c 1 "$source" | od -An -t x1 | tr -d '[:space:]')" != 0a ] || return 0
  [ -s "$staged" ] || return 0
  size="$(wc -c < "$staged" | tr -d '[:space:]')"
  head -c "$((size - 1))" "$staged" > "$staged.notrail" || return 1
  mv -f "$staged.notrail" "$staged"
}

# Insert (or re-insert) the owned block. Idempotent by construction: an
# existing owned block is dropped in the same pass that writes the new one, so
# a second run produces byte-identical output. Every other line is preserved
# in order.
write_pam_block() {
  local file="$1" dir="$2" tmp line
  line="$(pam_auth_line "$dir")"; line="${line%$'\n'}"
  regular_or_absent "$file"
  # A file that does not exist yet (macOS sudo_local) has no markers to
  # validate; validate_marker_pair counts grep hits and needs a real file.
  [ ! -f "$file" ] || validate_marker_pair "$file" "$PAM_BEGIN_MARK" "$PAM_END_MARK" ||
    die "malformed managed PAM block in $file"
  tmp="$(mktemp "${file}.XXXXXX")" || die "could not stage an edit of $file"
  if [ "$(uname -s)" = Darwin ]; then
    # Appended after any pam_tid line: Touch ID first, local device second.
    # Apple's own line is never rewritten or reordered.
    if [ -f "$file" ]; then
      awk -v begin="$PAM_BEGIN_MARK" -v end="$PAM_END_MARK" -v authline="$line" '
        $0 == begin { inside=1; next }
        $0 == end { inside=0; next }
        inside { next }
        $0 == authline { next }
        # Only a live auth line counts. The stock sudo_local ships pam_tid
        # commented out; appending after that comment would put our block
        # above an administrator who later uncomments it.
        { buf[n++]=$0; if (tolower($0) ~ /^[[:space:]]*auth[[:space:]]+.*pam_tid/) last=n }
        END {
          for (i = 0; i < n; i++) {
            print buf[i]
            if (i + 1 == last) { print begin; print authline; print end; done=1 }
          }
          if (!done) { print begin; print authline; print end }
        }
      ' "$file" > "$tmp" || { rm -f "$tmp"; die "could not rewrite $file"; }
    else
      printf '# sudo_local: created by install-oshioki-hook --contextual-pam\n%s\n%s\n%s\n' \
        "$PAM_BEGIN_MARK" "$line" "$PAM_END_MARK" > "$tmp"
    fi
  else
    [ -f "$file" ] || { rm -f "$tmp"; die "missing PAM service file: $file"; }
    awk -v begin="$PAM_BEGIN_MARK" -v end="$PAM_END_MARK" -v authline="$line" '
      $0 == begin { inside=1; next }
      $0 == end { inside=0; next }
      inside { next }
      $0 == authline { next }
      !done && tolower($0) ~ /^[[:space:]]*@include[[:space:]]+common-auth$/ {
        print begin; print authline; print end; done=1
      }
      { print }
      END { if (!done) exit 3 }
    ' "$file" > "$tmp" || { rm -f "$tmp"; die "no @include common-auth anchor in $file"; }
  fi
  pam_match_trailing_newline "$file" "$tmp" || { rm -f "$tmp" "$tmp.notrail"; die "could not rewrite $file"; }
  chmod 0644 "$tmp"; chown "root:$ROOT_GROUP" "$tmp"; mv -f "$tmp" "$file"
}

# Remove exactly our marker comments and our exact auth line, preserving
# every other byte in order. A damaged marker pair is not a licence to delete
# arbitrary text, and it must still not block removal of the auth line -- that
# line is the live artifact.
remove_pam_block() {
  local file="$1" dir="$2" tmp line
  line="$(pam_auth_line "$dir")"; line="${line%$'\n'}"
  [ -f "$file" ] || return 0
  regular_or_absent "$file"
  tmp="$(mktemp "${file}.XXXXXX")" || die "could not stage an edit of $file"
  # The dylib pattern is the one place this is not an exact-string match.
  # The macOS auth line embeds the absolute module path, and that path is
  # only known if the security directory can still be discovered -- which it
  # cannot once someone has removed /usr/local/lib/pam. Matching our own
  # module filename with any prefix removes the live line instead of leaving
  # sudo pointing at a deleted dylib. It still names our module, so this is
  # not a licence to delete arbitrary text.
  awk -v begin="$PAM_BEGIN_MARK" -v end="$PAM_END_MARK" -v authline="$line" '
    $0 == begin || $0 == end || $0 == authline { next }
    tolower($0) ~ /^[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+([^[:space:]]*\/)?liboshioki_pam\.dylib$/ { next }
    { print }
  ' "$file" > "$tmp" ||
    { rm -f "$tmp"; die "could not rewrite $file"; }
  pam_match_trailing_newline "$file" "$tmp" || { rm -f "$tmp" "$tmp.notrail"; die "could not rewrite $file"; }
  chmod 0644 "$tmp"; chown "root:$ROOT_GROUP" "$tmp"; mv -f "$tmp" "$file"
}

pam_backups=""
pam_rollback_armed=0

# Snapshot every file the migration may edit, before anything is edited. An
# absent file is recorded as absent, so rollback deletes what we created
# rather than leaving an empty one behind.
capture_pam_backups() {
  local file tmp
  pam_backups=""
  pam_rollback_armed=1
  for file in "$@"; do
    if [ -e "$file" ]; then
      regular_or_absent "$file"
      tmp="$(mktemp "${file}.oshioki-backup.XXXXXX")" ||
        die "could not create a PAM rollback backup for $file"
      if ! cp -p "$file" "$tmp"; then
        rm -f "$tmp"
        die "could not back up $file"
      fi
      pam_backups="${pam_backups}${file}|${tmp}
"
    else
      pam_backups="${pam_backups}${file}|-
"
    fi
  done
}

# Rollback steps 1 and 2 of the four in the plan: PAM entries first (so the
# module stops being referenced before it stops existing), then the module
# file. Chained ahead of restore_sudo_backups, which does steps 3 and 4.
# A second EXIT pass must be a no-op, so the armed flag and the entry list are
# cleared before any work.
restore_pam_backups() {
  [ "$pam_rollback_armed" -eq 1 ] || return 0
  local entries="$pam_backups" file tmp status=0
  pam_backups=""
  pam_rollback_armed=0
  while IFS='|' read -r file tmp; do
    [ -n "$file" ] || continue
    if [ "$tmp" = "-" ]; then
      rm -f "$file" || status=1
    else
      if cp -p "$tmp" "$file"; then rm -f "$tmp" || status=1; else status=1; fi
    fi
    pam_trace "pam:rollback:restored:$file"
  done <<EOF
$entries
EOF
  if [ "$status" -ne 0 ]; then
    echo "install-oshioki-hook: rollback could not fully restore the PAM configuration" >&2
  fi
  return "$status"
}

# Disarm before deleting the snapshots, matching drop_sudo_backups: a signal
# between the two must never restore half of a committed migration.
drop_pam_backups() {
  local entries="$pam_backups" file tmp status=0
  pam_backups=""
  pam_rollback_armed=0
  while IFS='|' read -r file tmp; do
    [ -n "$tmp" ] || continue
    [ "$tmp" = "-" ] && continue
    rm -f "$tmp" || status=1
  done <<EOF
$entries
EOF
  return "$status"
}

# Commit the contextual migration as one rollback state transition. Every
# rollback arm and the newly-created-directory flag are cleared before any
# snapshot is deleted: a signal in the cleanup window must not restore sudo's
# legacy artifacts while leaving the PAM lane live (or vice versa).
commit_pam_migration() {
  local pam_entries="$pam_backups" old_backup="$backup" old_dropin_backup="$dropin_backup" status=0
  # Keep these clears in one assignment-only simple command. Bash cannot run
  # a pending EXIT/TERM trap between the individual state transitions.
  pam_backups="" pam_rollback_armed=0 backup="" dropin_backup="" dropin_original_present=0 rollback_armed=0 pam_security_dir_created=0

  while IFS='|' read -r file tmp; do
    [ -n "$tmp" ] || continue
    [ "$tmp" = "-" ] && continue
    rm -f "$tmp" || status=1
  done <<EOF
$pam_entries
EOF
  if [ -n "$old_backup" ] && ! rm -f "$old_backup"; then
    echo "install-oshioki-hook: could not remove its sudo.conf rollback backup" >&2
    status=1
  fi
  if [ -n "$old_dropin_backup" ] && ! rm -f "$old_dropin_backup"; then
    echo "install-oshioki-hook: could not remove its sudoers rollback backup" >&2
    status=1
  fi
  return "$status"
}

# The named services that this host will actually get a block in, with the
# ones that inherit it recorded separately for status to report.
pam_services_to_edit=""
pam_services_inherited=""
pam_services_absent=""
classify_pam_services() {
  local dir="$1" service status
  pam_services_to_edit=""
  pam_services_inherited=""
  pam_services_absent=""
  for service in $PAM_SERVICES; do
    status=0
    pam_fingerprint_ok "$service" "$dir" || status=$?
    case "$status" in
      0) pam_services_to_edit="${pam_services_to_edit}${service} " ;;
      2) pam_services_inherited="${pam_services_inherited}${service} " ;;
      3) pam_services_absent="${pam_services_absent}${service} " ;;
      *) die "refusing a customised PAM stack: $PAM_D/$service is not a stock sudo layout" ;;
    esac
  done
  [ -n "$pam_services_to_edit" ] || die "no editable PAM service found under $PAM_D"
}

# The checksum manifest, wherever this installation flow put it. A git
# checkout builds it into target/release; a package ships it next to the
# installer. Status must not pass a module it never verified, so callers
# treat "not found" as a failure rather than a waiver.
default_checksums() {
  local candidate
  for candidate in "$SERVICE_DIR/target/release/SHA256SUMS" "$SCRIPT_DIR/SHA256SUMS"; do
    [ -f "$candidate" ] && [ ! -L "$candidate" ] || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

pam_module_checksum_ok() {
  local module="$1" manifest="$2" name expected
  name="$(basename "$module")"
  expected="$(awk -v name="$name" '$2 == name {print $1}' "$manifest")"
  [ "${#expected}" -eq 64 ] || return 1
  [ "$(hash_file "$module")" = "$expected" ]
}

# `common-auth` is shared by every service on the host. If our module ever
# appeared there it would run for ssh, login, polkit and cron, not just sudo.
# Asserted after every edit rather than trusted.
assert_common_auth_clean() {
  [ -f "$PAM_D/common-auth" ] || return 0
  if grep -F liboshioki_pam "$PAM_D/common-auth" >/dev/null 2>&1; then
    return 1
  fi
  return 0
}

validate_visudo() {
  local checker
  if [ "$DRY_RUN" -eq 1 ]; then printf 'DRY: visudo -c\n'; return 0; fi
  checker="$(find_visudo)" || return 0
  "$checker" -c >/dev/null 2>&1
}

if [ "$MODE" = prelaunch-status ]; then
  [ -f "$SUDO_CONF" ] || { echo "disabled"; exit 1; }
  validate_block "$SUDO_CONF"
  begins="$(grep -cF "$BEGIN_MARK" "$SUDO_CONF" || true)"
  if [ "$begins" -gt 0 ] && grep -Fq "Plugin approval_exec $PLUGIN_DEST" "$SUDO_CONF"; then
    # With no named user there is no drop-in to verify, so the plugin block
    # alone reports enabled; laptop-setup always names one, keeping the
    # coupling strict in the owned flow.
    dropin_user="$(sudoers_user)"
    if [ -z "$dropin_user" ] || ! registry_has_active_passwordless_devices; then
      if [ -n "$dropin_user" ] && { [ -e "$SUDOERS_FILE" ] || [ -L "$SUDOERS_FILE" ]; }; then
        echo "enabled with passwordless sudo but no hardware-backed approval device"
        exit 1
      fi
      echo "enabled: $PLUGIN_DEST (sudo password required for software-only approvals)"
      exit 0
    fi
    if dropin_ok "$dropin_user"; then echo "enabled: $PLUGIN_DEST"; exit 0; fi
    echo "enabled without passwordless sudo"
    exit 1
  fi
  if [ "$begins" -eq 0 ]; then echo "disabled"; exit 1; fi
  die "malformed managed block in $SUDO_CONF"
fi

# Package removal uses this mode after dpkg has already lost the rest of the
# installer context. It deliberately does not inspect sudo.conf: the drop-in
# is a separate privilege artifact and must be removable when that file is
# absent or damaged.
if [ "$MODE" = remove-sudoers-dropin ]; then
  [ "$(id -u)" -eq 0 ] || [ "$DRY_RUN" -eq 1 ] || die "must run as root"
  safe_directory "$SUDOERS_D"
  remove_sudoers_dropin
  exit 0
fi

# Installation still rejects a malformed sudo.conf before touching any
# binaries. Disablement is the one exception: its cleanup path must inspect
# the independent drop-in even when this file cannot be parsed.
case "$MODE" in
  # Disablement and status must work on a host whose sudo.conf an
  # administrator already deleted or damaged; installation still refuses one.
  disable-prelaunch|disable-contextual-pam|contextual-pam-status) ;;
  *) [ ! -f "$SUDO_CONF" ] || validate_block "$SUDO_CONF" ;;
esac

[ "$(id -u)" -eq 0 ] || [ "$DRY_RUN" -eq 1 ] || die "must run as root"
safe_directory "$(dirname "$STATE_DIR")"; safe_directory "$STATE_DIR"; regular_or_absent "$SUDO_CONF"
safe_directory "$SBIN_DIR"; safe_directory "$PLUGIN_DIR"; regular_or_absent "$SBIN_DIR/oshioki"; regular_or_absent "$PLUGIN_DEST"
regular_or_absent "$STATE_DIR/config.env"; regular_or_absent "$STATE_DIR/hook.json"; regular_or_absent "$STATE_DIR/devices.json"

if [ "$DRY_RUN" -eq 0 ] && [ "$MODE" != contextual-pam-status ]; then
  mkdir "$LOCK_DIR" 2>/dev/null || die "another installer holds $LOCK_DIR"
  cleanup_install() {
    # Do not allow a signal during rollback to re-enter this cleanup.
    trap - HUP INT TERM
    # PAM entries and the module first, then sudo.conf and the sudoers rule:
    # the module must stop being referenced before the legacy privilege
    # artifacts come back.
    restore_pam_backups || true
    restore_sudo_backups || true
    # The refresh path's staging files. Neither is ever referenced by a PAM
    # file, so removing them is always safe; leaving them would strand a
    # copy of the module beside the live one.
    [ -z "${pam_staged:-}" ] || rm -f "$pam_staged"
    [ -z "${pam_previous:-}" ] || rm -f "$pam_previous"
    if [ "${pam_security_dir_created:-0}" -eq 1 ] &&
       [ -n "${security_dir:-}" ] && [ -d "$security_dir" ] && [ ! -L "$security_dir" ]; then
      # The directory is ours only when this run created it. `rmdir` removes
      # it only if no unrelated file appeared beneath it during the window.
      rmdir "$security_dir" 2>/dev/null || true
    fi
    rmdir "$LOCK_DIR" 2>/dev/null || true
  }
  handle_signal() {
    local status="$1"
    # Exit invokes cleanup_install through EXIT and cannot resume the forward
    # migration at the point where the signal arrived.
    trap - HUP INT TERM
    exit "$status"
  }
  trap cleanup_install EXIT
  trap 'handle_signal 129' HUP
  trap 'handle_signal 130' INT
  trap 'handle_signal 143' TERM
fi

rewrite_block() {
  local action="$1" source="$2" destination="$3" tmp
  validate_block "$source"
  tmp="$(mktemp "${destination}.XXXXXX")"
  awk -v begin="$BEGIN_MARK" -v end="$END_MARK" '
    $0 == begin { inside=1; next }
    $0 == end { inside=0; next }
    !inside { print }
  ' "$source" > "$tmp"
  if grep -q '^Plugin approval_exec ' "$tmp"; then
    rm -f "$tmp"
    die "unmanaged approval_exec plugin line in $source"
  fi
  if [ "$action" = enable ]; then
    [ ! -s "$tmp" ] || [ "$(tail -c 1 "$tmp" | wc -l)" -ne 0 ] || printf '\n' >> "$tmp"
    printf '%s\nPlugin approval_exec %s\n%s\n' "$BEGIN_MARK" "$PLUGIN_DEST" "$END_MARK" >> "$tmp"
  fi
  chmod 0644 "$tmp"; chown "root:$ROOT_GROUP" "$tmp"; mv -f "$tmp" "$destination"
}

rewrite_partial_block() {
  local source="$1" destination="$2" tmp
  tmp="$(mktemp "${destination}.XXXXXX")"
  # A damaged marker pair is not enough to justify deleting arbitrary text.
  # Remove only the exact Oshioki plugin directive and our marker comments;
  # preserve every other sudo configuration line byte-for-byte in order.
  awk -v begin="$BEGIN_MARK" -v end="$END_MARK" -v plugin="Plugin approval_exec $PLUGIN_DEST" \
    '$0 != begin && $0 != end && $0 != plugin { print }' "$source" > "$tmp"
  chmod 0644 "$tmp"; chown "root:$ROOT_GROUP" "$tmp"; mv -f "$tmp" "$destination"
}

has_our_plugin() {
  [ -f "$SUDO_CONF" ] && grep -Fxq "Plugin approval_exec $PLUGIN_DEST" "$SUDO_CONF" 2>/dev/null
}

validate_sudo() {
  if [ "${SKIP_NODEVER:-0}" = 1 ]; then return 0; fi
  if [ "$DRY_RUN" -eq 1 ]; then printf 'DRY: sudo -V  # validate %s\n' "$SUDO_CONF"; return 0; fi
  sudo -V >/dev/null 2>&1
}


# Rollback for the contextual migration, in the plan's order: PAM entries and
# the module first (restore_pam_backups), then sudo.conf and the sudoers rule
# (restore_sudo_backups). Never the reverse: restoring the blanket NOPASSWD
# rule while the module is still referenced would leave a host with two
# authorization paths and no proof that either works.
pam_rollback_all() {
  restore_pam_backups || true
  restore_sudo_backups || true
}

# Where the module could be, for a removal that must work even when discovery
# fails (libpam-modules purged, a damaged multiarch file).
pam_module_removal_targets() {
  local dir candidate suffix
  dir="$(discover_security_dir 2>/dev/null)" || dir=""
  # The refresh path's staging names go too: nothing ever references them,
  # and one left behind by an interrupted refresh is a stray copy of the
  # module in the security directory.
  for suffix in "" .oshioki-new .oshioki-previous; do
    [ -z "$dir" ] || printf '%s%s\n' "$(pam_module_dest "$dir")" "$suffix"
  done
  if [ "$(uname -s)" != Darwin ]; then
    for candidate in "/usr/lib/$(uname -m)-linux-gnu/security" /lib/security /usr/lib/security; do
      [ "$candidate" != "$dir" ] || continue
      for suffix in "" .oshioki-new .oshioki-previous; do
        [ -f "$candidate/$PAM_MODULE_NAME$suffix" ] || continue
        printf '%s/%s%s\n' "$candidate" "$PAM_MODULE_NAME" "$suffix"
      done
    done
  fi
}

if [ "$MODE" = contextual-pam-status ]; then
  # Eight lines, one per property the lane depends on. Exit 0 only if every
  # one is OK: a status that reports a problem and still succeeds is a status
  # nothing can be scripted against.
  pam_status_rc=0
  pam_status_ok() { printf 'OK    %s\n' "$1"; }
  pam_status_bad() { printf 'FAIL  %s\n' "$1"; pam_status_rc=1; }

  status_dir="$(discover_security_dir 2>/dev/null)" || status_dir=""
  status_module=""
  [ -z "$status_dir" ] || status_module="$(pam_module_dest "$status_dir")"

  # 1. module present, and matching the manifest when one is available.
  if [ -z "$status_module" ] || [ ! -f "$status_module" ]; then
    pam_status_bad "module: not installed${status_dir:+ in $status_dir}"
  else
    status_manifest="${OSHIOKI_CHECKSUMS:-$(default_checksums || true)}"
    if [ -z "$status_manifest" ] || [ ! -f "$status_manifest" ] || [ -L "$status_manifest" ]; then
      # An unverified module is not an OK status line. Reporting success here
      # would mean `--contextual-pam-status` exits 0 on a host where the file
      # in the PAM search path was never checked against anything.
      pam_status_bad "module: $status_module present but no SHA256SUMS manifest was found to verify it against"
    elif pam_module_checksum_ok "$status_module" "$status_manifest"; then
      pam_status_ok "module: $status_module (sha256 matches $status_manifest)"
    else
      pam_status_bad "module: $status_module does not match $status_manifest"
    fi
  fi

  # 2. the owned entry, per service, with inheritance called out rather than
  #    silently counted as present.
  status_entries=""
  status_entry_rc=0
  for status_service in $PAM_SERVICES; do
    status_fp=0
    pam_fingerprint_ok "$status_service" "$status_dir" || status_fp=$?
    if [ "$status_fp" = 3 ]; then
      status_entries="${status_entries}${status_service}=no-such-service "
    elif [ "$status_fp" = 2 ]; then
      status_entries="${status_entries}${status_service}=inherited-via-include "
    elif pam_block_present "$PAM_D/$status_service" "$status_dir"; then
      status_entries="${status_entries}${status_service}=present "
    else
      status_entries="${status_entries}${status_service}=absent "
      status_entry_rc=1
    fi
  done
  if [ "$status_entry_rc" -eq 0 ]; then
    pam_status_ok "pam entries: ${status_entries% }"
  else
    pam_status_bad "pam entries: ${status_entries% }"
  fi

  # 3. the stack we edited still looks like the stack we fingerprinted. An
  #    administrator change under us is loud, not silent.
  status_fingerprint_rc=0
  status_fingerprints=""
  for status_service in $PAM_SERVICES; do
    status_fp=0
    pam_fingerprint_ok "$status_service" "$status_dir" || status_fp=$?
    case "$status_fp" in
      0) status_fingerprints="${status_fingerprints}${status_service}=stock " ;;
      2) status_fingerprints="${status_fingerprints}${status_service}=inherited " ;;
      3) status_fingerprints="${status_fingerprints}${status_service}=no-such-service " ;;
      *) status_fingerprints="${status_fingerprints}${status_service}=CHANGED "; status_fingerprint_rc=1 ;;
    esac
  done
  if [ "$status_fingerprint_rc" -eq 0 ]; then
    pam_status_ok "stock fingerprint: ${status_fingerprints% }"
  else
    pam_status_bad "stock fingerprint: ${status_fingerprints% } (an administrator changed the sudo stack under us)"
  fi

  # 4. common-auth, which we must never have touched.
  if assert_common_auth_clean; then
    pam_status_ok "common-auth: clean (no liboshioki_pam reference)"
  else
    pam_status_bad "common-auth: references liboshioki_pam; the module reaches every service on this host"
  fi

  # 5. the helper the module execs, and every parent on its path.
  if helper_path_secure; then
    pam_status_ok "helper: $SBIN_DIR/oshioki root-owned, executable, not writable by others, not setuid"
  else
    pam_status_bad "helper: $SBIN_DIR/oshioki is missing, not root-owned, not executable, writable by others, or setuid; the module refuses it and every sudo then fails without a password prompt (fix: install -o root -g root -m 0755 the hook binary at $SBIN_DIR/oshioki)"
  fi

  # 6. something that can actually answer an authentication.
  if registry_has_active_passwordless_devices; then
    pam_status_ok "devices: an active hardware-backed device is enrolled"
  else
    pam_status_bad "devices: no active hardware-backed device; every sudo falls back to a password"
  fi

  # 7. the legacy lane must be gone, not merely inactive.
  status_legacy=""
  if [ -e "$SUDOERS_FILE" ] || [ -L "$SUDOERS_FILE" ]; then status_legacy="blanket-rule "; fi
  if [ -f "$SUDO_CONF" ] && grep -q '^Plugin approval_exec ' "$SUDO_CONF" 2>/dev/null; then
    status_legacy="${status_legacy}approval-plugin "
  fi
  if [ -z "$status_legacy" ]; then
    pam_status_ok "legacy artifacts: none (no blanket sudoers rule, no approval plugin)"
  else
    pam_status_bad "legacy artifacts: ${status_legacy% } still present"
  fi

  # 8. sudo itself parses the result.
  if validate_sudo; then
    pam_status_ok "sudo -V: exits 0"
  else
    pam_status_bad "sudo -V: non-zero"
  fi
  exit "$pam_status_rc"
fi

if [ "$MODE" = contextual-pam ]; then
  # Test-only fault injection, in the same class as SKIP_NODEVER above. Each
  # name marks one step of the migration so the rollback chain can be
  # asserted from the outside; none of them is a supported operator control.
  FAIL_PAM_MODULE_INSTALL="${FAIL_PAM_MODULE_INSTALL:-0}"
  FAIL_PAM_SELFTEST="${FAIL_PAM_SELFTEST:-0}"
  FAIL_PAM_EDIT="${FAIL_PAM_EDIT:-}"
  SIGNAL_AFTER_PAM_EDIT="${SIGNAL_AFTER_PAM_EDIT:-0}"

  # --- Step 1: prerequisites. Nothing on this host has changed yet, so a
  # refusal here is total and costs the administrator nothing.
  [ -n "$PAM_MODULE_BIN" ] || die "PAM_MODULE_BIN is required for --contextual-pam"
  PAM_MODULE_BIN="$(canonicalize "$PAM_MODULE_BIN")"
  { [ -f "$PAM_MODULE_BIN" ] && [ ! -L "$PAM_MODULE_BIN" ]; } ||
    die "missing or unsafe PAM module artifact: $PAM_MODULE_BIN"
  PAM_CHECKSUMS="${OSHIOKI_CHECKSUMS:-$(default_checksums || true)}"
  [ -n "$PAM_CHECKSUMS" ] || die "no artifact checksum manifest found"
  PAM_CHECKSUMS="$(canonicalize "$PAM_CHECKSUMS")"
  { [ -f "$PAM_CHECKSUMS" ] && [ ! -L "$PAM_CHECKSUMS" ]; } ||
    die "missing artifact checksum manifest: $PAM_CHECKSUMS"
  pam_module_checksum_ok "$PAM_MODULE_BIN" "$PAM_CHECKSUMS" ||
    die "checksum mismatch for $(basename "$PAM_MODULE_BIN")"
  security_dir="$(discover_security_dir)"
  module_dest="$(pam_module_dest "$security_dir")"
  safe_directory "$PAM_D"
  classify_pam_services "$security_dir"
  helper_path_secure ||
    die "helper $SBIN_DIR/oshioki is missing, not executable, or on an unsafe path; install the hook (root-owned, mode 0755, on a root-owned path) before migrating"
  assert_common_auth_clean ||
    die "$PAM_D/common-auth already references liboshioki_pam; refusing to touch this host"
  pam_trace "pam:prereq-ok"

  # --- Upgrade path: the lane is already live and only the module file is
  # out of date. A package upgrade must refresh it, and must do so without
  # going through the migration again: the PAM block stays exactly as it is,
  # the replacement is proven to load before anything references it, and the
  # swap is a single rename. A host with the block but no module falls
  # through to the full migration below, which reinstalls and re-edits.
  if pam_lane_active && [ -f "$module_dest" ]; then
    if pam_module_checksum_ok "$module_dest" "$PAM_CHECKSUMS"; then
      pam_trace "pam:refresh:current"
      echo "install-oshioki-hook: contextual PAM already current at $module_dest"
      exit 0
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
      printf 'DRY: stage %s beside %s, self-test it, then rename it into place\n' \
        "$PAM_MODULE_BIN" "$module_dest"
      printf 'DRY: %s pam-selftest --module %s.oshioki-new\n' "$SBIN_DIR/oshioki" "$module_dest"
      validate_sudo
      exit 0
    fi
    pam_staged="$module_dest.oshioki-new"
    pam_previous="$module_dest.oshioki-previous"
    rm -f "$pam_staged" "$pam_previous"
    if [ "$FAIL_PAM_MODULE_INSTALL" = 1 ] ||
       ! install -m 0644 -o root -g "$ROOT_GROUP" "$PAM_MODULE_BIN" "$pam_staged"; then
      rm -f "$pam_staged"
      die "could not stage the replacement PAM module at $pam_staged; $module_dest is unchanged"
    fi
    if [ "$FAIL_PAM_SELFTEST" = 1 ] ||
       ! "$SBIN_DIR/oshioki" pam-selftest --module "$pam_staged"; then
      rm -f "$pam_staged"
      die "PAM module self-test failed for $pam_staged; $module_dest is unchanged"
    fi
    pam_trace "pam:refresh:selftest-ok"
    cp -p "$module_dest" "$pam_previous" || {
      rm -f "$pam_staged" "$pam_previous"
      die "could not back up $module_dest; nothing was changed"
    }
    mv -f "$pam_staged" "$module_dest" || {
      rm -f "$pam_staged" "$pam_previous"
      die "could not replace $module_dest; the previous module is still in place"
    }
    pam_trace "pam:refresh:module-swapped:$module_dest"
    if ! validate_sudo; then
      mv -f "$pam_previous" "$module_dest" ||
        die "sudo -V failed after refreshing the module, and the previous module could not be restored from $pam_previous; restore it by hand or run --disable-contextual-pam"
      die "sudo -V failed after refreshing the module; restored the previous one"
    fi
    rm -f "$pam_previous"
    pam_previous=""
    pam_trace "pam:refresh:committed"
    echo "install-oshioki-hook: contextual PAM module refreshed at $module_dest"
    exit 0
  fi

  # --- The lane is configured but its module is gone: an interrupted
  # refresh, a purge that swept too far, or a hand-edited host. Linux
  # survives it (module_unknown=ignore turns the missing module into a
  # password prompt) but macOS does not, so it is never passed over quietly.
  pam_lane_missing_module=0
  if pam_lane_active; then
    pam_lane_missing_module=1
    echo "install-oshioki-hook: WARNING: the contextual PAM lane is configured but the module file is missing: $module_dest" >&2
    echo "install-oshioki-hook: reinstalling it; sudo authenticates by password until this finishes" >&2
  fi

  # --- Not yet, rather than a failure: the .deb's opt-in key can be
  # pre-seeded before any device is paired, and every postinst until then
  # would otherwise abort the migration as an error. Prerequisite problems
  # above still die; this one only means "come back after pinning a device",
  # and nothing on the host has been touched.
  pam_registry_state="$(registry_device_state)"
  case "$pam_registry_state" in
    corrupt)
      die "$STATE_DIR/devices.json is unreadable or is not a device registry; refusing to migrate" ;;
    eligible) ;;
    *)
      # A host whose PAM stack already names a module that is not there is
      # the one case this may not shrug off: leaving it as it is means macOS
      # sudo is reaching a missing module through its sufficient entry on every
      # request.
      [ "$pam_lane_missing_module" -eq 0 ] ||
        die "the contextual PAM lane is configured but $module_dest is missing, and no hardware-backed device can prove a replacement; pin a device and re-run, or run --disable-contextual-pam"
      pam_trace "pam:not-yet"
      case "$pam_registry_state" in
        absent|empty)
          echo "install-oshioki-hook: no approval device pinned yet; skipping the contextual PAM migration" >&2 ;;
        software-only)
          echo "install-oshioki-hook: only software approval devices are active; a hardware-backed device is required, so the contextual PAM migration was skipped" >&2 ;;
      esac
      echo "install-oshioki-hook: no active hardware-backed approval device yet; pin one, then re-run: $0 --contextual-pam" >&2
      exit 0 ;;
  esac

  if [ "$DRY_RUN" -eq 1 ]; then
    # The plan mirrors the real order exactly, including the two removals
    # that precede anything being installed.
    remove_sudoers_dropin
    if [ -f "$SUDO_CONF" ] && { grep -Fq "$BEGIN_MARK" "$SUDO_CONF" || has_our_plugin; }; then
      echo "DRY: remove the managed Oshioki plugin block from $SUDO_CONF"
    fi
    validate_sudo
    if [ ! -e "$security_dir" ]; then
      printf 'DRY: create %s (root:%s mode 0755)\n' "$security_dir" "$ROOT_GROUP"
    fi
    printf 'DRY: install %s to %s\n' "$PAM_MODULE_BIN" "$module_dest"
    printf 'DRY: %s pam-selftest --module %s\n' "$SBIN_DIR/oshioki" "$module_dest"
    for service in $pam_services_to_edit; do
      printf 'DRY: insert the exact oshioki pam block into %s/%s\n' "$PAM_D" "$service"
    done
    for service in $pam_services_inherited; do
      printf 'DRY: skip %s/%s (inherits the edit via @include sudo)\n' "$PAM_D" "$service"
    done
    for service in $pam_services_absent; do
      printf 'DRY: skip %s/%s (no such service file on this host)\n' "$PAM_D" "$service"
    done
    printf 'DRY: assert %s/common-auth has no liboshioki_pam reference\n' "$PAM_D"
    validate_visudo
    validate_sudo
    exit 0
  fi

  # --- Step 0 invariant: nothing has changed. Arm every rollback input
  # before the first mutation, and snapshot the module destination alongside
  # the PAM files so rollback treats it as one ordered set.
  capture_dropin_backup
  [ ! -f "$SUDO_CONF" ] || capture_sudo_conf_backup contextual-pam-rollback
  pam_snapshot_targets=""
  for service in $pam_services_to_edit; do
    pam_snapshot_targets="$pam_snapshot_targets $PAM_D/$service"
  done
  # shellcheck disable=SC2086
  capture_pam_backups $pam_snapshot_targets "$module_dest"

  # --- Step 2: the blanket rule goes first, while the legacy plugin is still
  # there to guard it. The reverse order would leave passwordless sudo with
  # nothing approving it, even momentarily.
  remove_sudoers_dropin
  pam_trace "pam:dropin-removed"

  # --- Step 3: the legacy plugin goes. From here until step 6 this host is
  # on ordinary password sudo -- which is why there is no double-auth window
  # and no intermediate state that grants more than stock sudo does.
  if [ -f "$SUDO_CONF" ]; then
    rewrite_block disable "$SUDO_CONF" "$SUDO_CONF"
  fi
  if ! validate_sudo; then
    pam_rollback_all
    die "sudo -V failed after removing the legacy plugin; restored the prior configuration"
  fi
  pam_trace "pam:plugin-removed"

  # --- Step 4: the module lands but nothing references it yet: inert. On a
  # fresh Darwin host this also creates the private security-directory leaf;
  # it is still covered by the rollback armed above.
  ensure_pam_security_dir "$security_dir"
  if [ "$FAIL_PAM_MODULE_INSTALL" = 1 ] ||
     ! install -m 0644 -o root -g "$ROOT_GROUP" "$PAM_MODULE_BIN" "$module_dest"; then
    pam_rollback_all
    die "could not install the PAM module to $module_dest; this host is on password sudo"
  fi
  pam_trace "pam:module-installed:$module_dest"

  # --- Step 5: prove the file actually loads and exports the auth entry
  # points, while a failure still means no PAM file has been touched.
  if [ "$FAIL_PAM_SELFTEST" = 1 ] ||
     ! "$SBIN_DIR/oshioki" pam-selftest --module "$module_dest"; then
    pam_rollback_all
    die "PAM module self-test failed for $module_dest; no PAM configuration was changed"
  fi
  pam_trace "pam:selftest-ok"

  # --- Step 6: the module goes live.
  for service in $pam_services_to_edit; do
    if [ "$FAIL_PAM_EDIT" = "$service" ]; then
      pam_rollback_all
      die "could not edit $PAM_D/$service; restored the prior configuration"
    fi
    write_pam_block "$PAM_D/$service" "$security_dir"
    pam_trace "pam:edit:$service"
    if [ "$SIGNAL_AFTER_PAM_EDIT" = 1 ]; then
      kill -TERM $$
      sleep 5
    fi
  done
  if ! assert_common_auth_clean; then
    pam_rollback_all
    die "the module leaked into $PAM_D/common-auth; restored the prior configuration"
  fi
  pam_trace "pam:common-auth-clean"
  if ! validate_visudo; then
    pam_rollback_all
    die "visudo -c failed after the PAM edit; restored the prior configuration"
  fi
  if ! validate_sudo; then
    pam_rollback_all
    die "sudo -V failed after the PAM edit; restored the prior configuration"
  fi
  pam_trace "pam:sudo-validated"

  # --- Step 7: a live proof, only when an administrator is watching. This is
  # the only step that needs a human, and the only one that can observe the
  # module end to end on the real stack.
  if [ "$SUPERVISED" -eq 1 ]; then
    if [ ! -t 0 ]; then
      echo "install-oshioki-hook: warning: --supervised needs a TTY on stdin; skipping the live proof" >&2
    else
      proof_user="$(sudoers_user)"
      if [ -z "$proof_user" ]; then
        pam_rollback_all
        die "--supervised needs OSHIOKI_SUDO_USER to name the account that proves the stack"
      fi
      if ! valid_sudoers_user "$proof_user"; then
        pam_rollback_all
        die "invalid sudoers user: $proof_user"
      fi
      echo "install-oshioki-hook: approve the device prompt for $proof_user to finish the migration" >&2
      if ! su -l "$proof_user" -c 'sudo -k && sudo true'; then
        pam_rollback_all
        die "the supervised sudo proof failed for $proof_user; restored the legacy configuration"
      fi
      pam_trace "pam:supervised-proof-ok"
    fi
  fi

  # --- Step 8: commit. All rollback state disarms come before any snapshot
  # deletion, so a signal in this window cannot restore half a migration.
  commit_pam_migration ||
    echo "install-oshioki-hook: could not remove all migration rollback backups" >&2
  pam_trace "pam:committed"
  echo "install-oshioki-hook: contextual PAM installed ($module_dest; services ${pam_services_to_edit% })"
  [ -z "$pam_services_inherited" ] ||
    echo "install-oshioki-hook: ${pam_services_inherited% } inherits the edit via @include sudo"
  [ -z "$pam_services_absent" ] ||
    echo "install-oshioki-hook: ${pam_services_absent% } does not exist on this host and was skipped"
  exit 0
fi

if [ "$MODE" = disable-contextual-pam ]; then
  # Strict order, and the only order that is safe: PAM entries out, sudo
  # proven, and only then the file itself. Removing the module first would
  # leave every /etc/pam.d/sudo pointing at a missing object; the installed
  # control line survives that (module_unknown=ignore), but an older or
  # hand-edited line would not, and the window is avoidable.
  disable_dir="$(discover_security_dir 2>/dev/null)" || disable_dir=""
  # On macOS the auth line embeds the module's absolute path, so a failed
  # discovery would otherwise build the wrong line and leave the real one in
  # place, pointing at a file this very run is about to delete. Fall back to
  # the canonical location the installer owns; remove_pam_block's dylib
  # pattern covers the rest.
  if [ -z "$disable_dir" ] && [ "$(uname -s)" = Darwin ]; then
    disable_dir=/usr/local/lib/pam
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    for service in $PAM_SERVICES; do
      [ -f "$PAM_D/$service" ] || continue
      printf 'DRY: remove the exact oshioki pam block from %s/%s\n' "$PAM_D" "$service"
    done
    validate_sudo
    while IFS= read -r target; do
      [ -n "$target" ] || continue
      printf 'DRY: remove %s\n' "$target"
    done <<EOF
$(pam_module_removal_targets)
EOF
    exit 0
  fi
  for service in $PAM_SERVICES; do
    [ -f "$PAM_D/$service" ] || continue
    remove_pam_block "$PAM_D/$service" "$disable_dir"
    pam_trace "pam:disable:edit:$service"
  done
  # A failure here exits non-zero with the module still installed, never the
  # other way round.
  validate_sudo || die "sudo -V failed after removing the PAM entries; the module is still installed"
  pam_trace "pam:disable:sudo-validated"
  # Someone else's reference to our module is not ours to strand. Unlinking
  # the file while any service still names it is exactly the
  # referenced-but-missing state this ordering exists to prevent.
  # Our own litter is not a referrer: a crashed earlier run can leave a
  # mktemp stage file, a rollback snapshot, or a .notrail intermediate next
  # to the service it was editing, and every one of them contains the auth
  # line. They are all "<service>.<something>"; a PAM service name is the
  # bare name, so excluding that shape excludes exactly our own files.
  disable_excludes=()
  for service in $PAM_SERVICES; do
    disable_excludes+=(--exclude="${service}.*")
  done
  disable_referrers="$(grep -rl "${disable_excludes[@]}" liboshioki_pam "$PAM_D" 2>/dev/null || true)"
  if [ -n "$disable_referrers" ]; then
    echo "install-oshioki-hook: $PAM_D still references the module; leaving it installed:" >&2
    printf '%s\n' "$disable_referrers" | sed 's/^/  /' >&2
    exit 1
  fi
  while IFS= read -r target; do
    [ -n "$target" ] || continue
    [ -e "$target" ] || continue
    rm -f "$target" || die "could not remove $target"
    pam_trace "pam:disable:module-removed:$target"
  done <<EOF
$(pam_module_removal_targets)
EOF
  echo "install-oshioki-hook: contextual PAM disabled and sudo validated"
  exit 0
fi

if [ "$MODE" = disable-prelaunch ]; then
  # A package can be removed after an administrator has already deleted
  # sudo.conf. The separate drop-in cleanup still has to run.
  if [ ! -e "$SUDO_CONF" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then echo "DRY: no sudo.conf to clean"; fi
    remove_sudoers_dropin
    exit 0
  fi
  partial_block=0
  if ! validate_block "$SUDO_CONF"; then
    # Marker comments identify the managed artifact even when one marker is
    # missing, duplicated, or reversed. rewrite_partial_block removes only
    # those comments and the exact Oshioki directive, preserving all other
    # administrator content.
    partial_block=1
  else
    begin_count="$(grep -cF "$BEGIN_MARK" "$SUDO_CONF" || true)"
    if [ "$begin_count" -ne 1 ] && has_our_plugin; then
      # The exact plugin directive remains even though its marker pair was
      # removed. Treat that directive as the independently identifiable
      # Oshioki artifact.
      partial_block=1
    fi
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    # Keep the reviewable plan in the same order as the real cleanup.
    remove_sudoers_dropin
    if [ "$partial_block" -eq 1 ]; then echo "DRY: remove exact Oshioki plugin directive from $SUDO_CONF"; else echo "DRY: remove exact managed block from $SUDO_CONF"; fi
    exit 0
  fi
  capture_dropin_backup
  capture_sudo_conf_backup
  remove_sudoers_dropin
  if [ "$partial_block" -eq 1 ]; then rewrite_partial_block "$SUDO_CONF" "$SUDO_CONF"; else rewrite_block disable "$SUDO_CONF" "$SUDO_CONF"; fi
  if ! validate_sudo; then
    restore_sudo_backups
    die "sudo -V failed after disable; restored prior configuration"
  fi
  drop_sudo_backups
  echo "install-oshioki-hook: prelaunch disabled and sudo validated"; exit 0
fi

[ -n "$ORIGIN" ] || die "OSHIOKI_ORIGIN is required"
[ -n "$RP_ID" ] || die "OSHIOKI_RP_ID is required"
# Transports are explicit: an empty NATS_URL means socket-only (no NATS
# keys are written at all, never placeholders), and an empty socket with an
# empty URL means nothing could approve, which fails here rather than at
# the first sudo. Credentials are both-or-neither on both sides of the
# URL's presence: creds without a server, or a user without a password,
# describe a NATS that cannot exist.
if [ -z "$NATS_URL" ]; then
  if [ -n "$NATS_USER" ] || [ -n "$NATS_PASS" ]; then
    die "NATS_USER/NATS_PASS are set but NATS_URL is not; set all three or none"
  fi
  [ -n "$AGENT_SOCKET" ] || die "no approval transports: NATS_URL is empty and OSHIOKI_AGENT_SOCKET is not set"
else
  if [ -n "$NATS_PASS" ]; then
    [ -n "$NATS_USER" ] || NATS_USER="oshioki"
  elif [ -n "$NATS_USER" ]; then
    die "NATS_USER is set but NATS_PASS is not; set both or neither"
  fi
fi
if needs_tls_warning; then
  echo "install-oshioki-hook: warning: NATS_URL is plaintext to a non-loopback host, and the hook will refuse it: use tls://, or set OSHIOKI_ALLOW_PLAINTEXT_NATS=1 (testing only; see README.md)" >&2
fi

for artifact in "$HOOK_BIN" "$PLUGIN_BIN"; do
  if [ ! -f "$artifact" ] || [ -L "$artifact" ]; then
    die "missing or unsafe build artifact: $artifact"
  fi
done
architecture="$(uname -m)"; file_output="$(file -b "$HOOK_BIN") $(file -b "$PLUGIN_BIN")"
case "$architecture" in
  x86_64|amd64) grep -Eqi 'x86[-_ ]?64|x86_64' <<<"$file_output" || die "artifact architecture does not match $architecture" ;;
  arm64|aarch64) grep -Eqi 'arm64|aarch64' <<<"$file_output" || die "artifact architecture does not match $architecture" ;;
  *) die "unsupported architecture: $architecture" ;;
esac

CHECKSUMS="${OSHIOKI_CHECKSUMS:-$SERVICE_DIR/target/release/SHA256SUMS}"
CHECKSUMS="$(canonicalize "$CHECKSUMS")"
if [ ! -f "$CHECKSUMS" ] || [ -L "$CHECKSUMS" ]; then
  die "missing artifact checksum manifest: $CHECKSUMS"
fi
for artifact in "$HOOK_BIN" "$PLUGIN_BIN"; do
  name="$(basename "$artifact")"; expected="$(awk -v name="$name" '$2 == name {print $1}' "$CHECKSUMS")"
  [ "${#expected}" -eq 64 ] || die "checksum manifest has no exact entry for $name"
  [ "$(hash_file "$artifact")" = "$expected" ] || die "checksum mismatch for $name"
done

prepare_upgrade

run install -d -m 0755 "$SBIN_DIR" "$PLUGIN_DIR"
run install -m 0755 -o root -g "$ROOT_GROUP" "$HOOK_BIN" "$SBIN_DIR/oshioki"
run install -m 0755 -o root -g "$ROOT_GROUP" "$PLUGIN_BIN" "$PLUGIN_DEST"
run install -d -m 0750 -o root -g "$ROOT_GROUP" "$STATE_DIR"

if [ "$DRY_RUN" -eq 1 ]; then
  if [ -n "$NATS_URL" ]; then printf 'DRY: write %s/config.env with NATS_PASS=<redacted>\n' "$STATE_DIR"; else printf 'DRY: write %s/config.env without NATS (socket-only)\n' "$STATE_DIR"; fi
  [ -z "$ALLOW_PLAINTEXT" ] || printf 'DRY: write OSHIOKI_ALLOW_PLAINTEXT_NATS=%s to config.env\n' "$ALLOW_PLAINTEXT"
  [ -z "$AGENT_SOCKET" ] || printf 'DRY: write OSHIOKI_AGENT_SOCKET=%s to config.env\n' "$AGENT_SOCKET"
  printf 'DRY: write %s/hook.json for origin %s and RP ID %s\n' "$STATE_DIR" "$ORIGIN" "$RP_ID"
else
  tmp="$(mktemp "$STATE_DIR/config.env.XXXXXX")"; [ -z "$NATS_URL" ] || printf 'NATS_URL=%s\n' "$NATS_URL" > "$tmp"; [ -z "$NATS_URL" ] || [ -z "$NATS_PASS" ] || printf 'NATS_USER=%s\nNATS_PASS=%s\n' "$NATS_USER" "$NATS_PASS" >> "$tmp"; [ -z "$ALLOW_PLAINTEXT" ] || printf 'OSHIOKI_ALLOW_PLAINTEXT_NATS=%s\n' "$ALLOW_PLAINTEXT" >> "$tmp"; [ -z "$AGENT_SOCKET" ] || printf 'OSHIOKI_AGENT_SOCKET=%s\n' "$AGENT_SOCKET" >> "$tmp"; chmod 0600 "$tmp"; chown "root:$ROOT_GROUP" "$tmp"; mv -f "$tmp" "$STATE_DIR/config.env"
  tmp="$(mktemp "$STATE_DIR/hook.json.XXXXXX")"; printf '{"version":1,"origin":"%s","rp_id":"%s","server_base_url":"%s"}\n' "$ORIGIN" "$RP_ID" "$ORIGIN" > "$tmp"; chmod 0600 "$tmp"; chown "root:$ROOT_GROUP" "$tmp"; mv -f "$tmp" "$STATE_DIR/hook.json"
  if [ ! -e "$STATE_DIR/devices.json" ]; then printf '{"version":1,"devices":[]}\n' > "$STATE_DIR/devices.json"; chmod 0600 "$STATE_DIR/devices.json"; chown "root:$ROOT_GROUP" "$STATE_DIR/devices.json"; fi
fi

# Enabling the plugin with no approval devices locks every sudo out: the
# hook fails closed on an empty registry, including the sudo that would pin
# the first device. The binaries and config still install; pin a device and
# re-run to enable. The registry is machine-written, so the literal
# `"active": true` can only come from the active field: string values escape
# their quotes, and no other key is named active.
registry_has_active_devices() {
  grep -Eq '"active":[[:space:]]*true' "$STATE_DIR/devices.json" 2>/dev/null
}

# A host already migrated to the contextual PAM lane must not be pulled back
# onto the plugin lane by an upgrade. `apt upgrade` re-runs postinst, which
# re-runs --prelaunch; re-enabling the approval plugin and the blanket
# NOPASSWD rule here would silently give such a host two authorization paths,
# and a half-finished opt-in migration would leave both live. The hook
# binary, the plugin file and the config above are still refreshed -- only
# the enablement is withheld -- and any stale legacy artifact is removed
# rather than left behind.
if pam_lane_active; then
  if [ "$DRY_RUN" -eq 1 ]; then
    remove_sudoers_dropin
    echo "DRY: skip enabling $SUDO_CONF (this host is on the contextual PAM lane)"
    validate_sudo
    exit 0
  fi
  echo "install-oshioki-hook: this host is on the contextual PAM lane; not enabling the approval plugin or the blanket sudoers rule" >&2
  capture_dropin_backup
  [ ! -f "$SUDO_CONF" ] || capture_sudo_conf_backup
  remove_sudoers_dropin
  if [ -f "$SUDO_CONF" ] && { grep -Fq "$BEGIN_MARK" "$SUDO_CONF" || has_our_plugin; }; then
    rewrite_block disable "$SUDO_CONF" "$SUDO_CONF"
  fi
  if ! validate_sudo; then
    restore_sudo_backups
    die "sudo -V failed; restored prior configuration"
  fi
  drop_sudo_backups
  echo "install-oshioki-hook: $MODE installed; the contextual PAM lane is unchanged"
  exit 0
fi
if [ "$DRY_RUN" -eq 1 ]; then
  if registry_has_active_devices; then
    echo "DRY: enable exact managed block in $SUDO_CONF"
    plan_sudoers_dropin "$(sudoers_user)"
  elif [ -f "$SUDO_CONF" ] && grep -qF "$BEGIN_MARK" "$SUDO_CONF"; then
    remove_sudoers_dropin
    echo "DRY: remove exact managed block from $SUDO_CONF (no active approval devices)"
  else
    remove_sudoers_dropin
    echo "DRY: skip enabling $SUDO_CONF (no active approval devices)"
  fi
  validate_sudo; exit 0
fi
if ! registry_has_active_devices; then
  echo "install-oshioki-hook: warning: no active approval devices; $SUDO_CONF keeps no managed block (pin a device, then re-run)" >&2
  # An enabled block with an empty registry fails every sudo closed,
  # including the sudo that would pin the first device: take it back out.
  if [ -f "$SUDO_CONF" ] && grep -qF "$BEGIN_MARK" "$SUDO_CONF"; then
    capture_dropin_backup
    capture_sudo_conf_backup
    remove_sudoers_dropin
    rewrite_block disable "$SUDO_CONF" "$SUDO_CONF"
    if ! validate_sudo; then
      restore_sudo_backups
      die "sudo -V failed; restored prior configuration"
    fi
    drop_sudo_backups
  else
    remove_sudoers_dropin
  fi
else
[ -f "$SUDO_CONF" ] || install -m 0644 -o root -g "$ROOT_GROUP" /dev/null "$SUDO_CONF"
capture_dropin_backup
capture_sudo_conf_backup
rewrite_block enable "$SUDO_CONF" "$SUDO_CONF"
install_sudoers_dropin "$(sudoers_user)"
if ! validate_sudo; then
  restore_sudo_backups
  die "sudo -V failed; restored prior configuration"
fi
drop_sudo_backups
fi
echo "install-oshioki-hook: $MODE installed and sudo validated"
