#!/usr/bin/env bash
# Install, disable, or inspect the retained oshioki prelaunch block.
set -euo pipefail

MODE=""
DRY_RUN=0
CONFIG_FILE=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --prelaunch|--disable-prelaunch|--prelaunch-status|--standalone-e2e)
      [ -z "$MODE" ] || { echo "install-oshioki-hook: choose exactly one mode" >&2; exit 2; }
      MODE="${1#--}"
      ;;
    --config-file)
      [ "$#" -ge 2 ] || { echo "install-oshioki-hook: --config-file requires a path" >&2; exit 2; }
      CONFIG_FILE="$2"
      shift
      ;;
    --dry-run) DRY_RUN=1 ;;
    *) echo "install-oshioki-hook: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done
[ -n "$MODE" ] || { echo "install-oshioki-hook: choose exactly one mode" >&2; exit 2; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SERVICE_DIR="$(cd "$SCRIPT_DIR/.." && pwd -P)"
SUDO_CONF="${SUDO_CONF:-/etc/sudo.conf}"
SBIN_DIR="${SBIN_DIR:-/usr/local/sbin}"
STATE_DIR="${OSHIOKI_STATE_DIR:-/etc/oshioki}"
SUDOERS_D="${SUDOERS_D:-/etc/sudoers.d}"
MAIN_SUDOERS="${MAIN_SUDOERS:-/etc/sudoers}"
SUDOERS_FILE="$SUDOERS_D/oshioki"
ORIGIN="${OSHIOKI_ORIGIN:-}"
RP_ID="${OSHIOKI_RP_ID:-}"
NATS_URL="${NATS_URL:-}"
NATS_USER="${NATS_USER:-oshioki}"
NATS_PASS="${NATS_PASS:-}"
ALLOW_PLAINTEXT="${OSHIOKI_ALLOW_PLAINTEXT_NATS:-}"
AGENT_SOCKET="${OSHIOKI_AGENT_SOCKET:-}"
BEGIN_MARK='# BEGIN oshioki'
END_MARK='# END oshioki'
LOCK_DIR="${OSHIOKI_INSTALL_LOCK:-${STATE_DIR}.install.lock}"

case "$(uname -s)" in
  Linux) PLUGIN_DIR="${SUDO_PLUGIN_DIR:-/usr/local/libexec/sudo}"; PLUGIN_NAME=oshioki.so; BUILD_PLUGIN=liboshioki_plugin.so ;;
  Darwin) PLUGIN_DIR="${SUDO_PLUGIN_DIR:-/usr/local/libexec/sudo}"; PLUGIN_NAME=oshioki.dylib; BUILD_PLUGIN=liboshioki_plugin.dylib ;;
  *) echo "install-oshioki-hook: unsupported operating system" >&2; exit 1 ;;
esac
ROOT_GROUP=root
[ "$(uname -s)" = Darwin ] && ROOT_GROUP=wheel
HOOK_BIN="${HOOK_BIN:-$SERVICE_DIR/target/release/oshioki}"
PLUGIN_BIN="${PLUGIN_BIN:-$SERVICE_DIR/target/release/$BUILD_PLUGIN}"
PLUGIN_DEST="$PLUGIN_DIR/$PLUGIN_NAME"

die() { echo "install-oshioki-hook: $*" >&2; exit 1; }
run() { if [ "$DRY_RUN" -eq 1 ]; then printf 'DRY:'; printf ' %q' "$@"; printf '\n'; else "$@"; fi; }
regular_or_absent() { [ ! -L "$1" ] || die "refusing unsafe target: $1"; [ ! -e "$1" ] || [ -f "$1" ] || die "refusing unsafe target: $1"; }
canonicalize() {
  local p="$1" link hops=0
  while [ "$hops" -lt 40 ] && link="$(readlink "$p" 2>/dev/null)" && [ -n "$link" ]; do
    case "$link" in
      /*) p="$link" ;;
      *) p="$(dirname "$p")/$link" ;;
    esac
    hops=$((hops + 1))
  done
  if [ -L "$p" ]; then die "refusing unresolved symlink: $1"; fi
  printf '%s\n' "$p"
}
safe_directory() {
  local canon
  canon="$(canonicalize "$1")"
  [ ! -e "$canon" ] || [ -d "$canon" ] || die "refusing non-directory: $1"
}
hash_file() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'; else shasum -a 256 "$1" | awk '{print $1}'; fi; }

# Passwordless sudo lives in a sudoers.d drop-in next to the plugin block so
# one never outlives the other: the Touch ID approval becomes the only gate
# and sudo stops asking for a password. Both install only with an active
# approval device, both are verified by prelaunch-status, and both go away
# on disable. A broken sudoers file locks every sudo out, so the drop-in is
# visudo-validated before it lands and sudo ignores a leaked temp file (its
# name carries a dot).
sudoers_user() { printf '%s' "${OSHIOKI_SUDO_USER:-${SUDO_USER:-}}"; }
valid_sudoers_user() {
  case "$1" in
    ''|*[!A-Za-z0-9_.-]*) return 1 ;;
  esac
  return 0
}
sudoers_line() { printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$1"; }
# The drop-in takes effect only when the main sudoers file includes its
# directory. Either spelling of the system path counts.
sudoers_included() {
  [ -f "$MAIN_SUDOERS" ] && grep -Eq "^[[:space:]]*#[[:space:]]*includedir[[:space:]]+($SUDOERS_D|/private$SUDOERS_D)([[:space:]]|$)" "$MAIN_SUDOERS" 2>/dev/null
}
find_visudo() {
  if command -v visudo >/dev/null 2>&1; then command -v visudo; return 0; fi
  [ -x /usr/sbin/visudo ] || return 1
  printf '/usr/sbin/visudo\n'
}
write_sudoers_dropin() {
  local user="$1" tmp checker
  safe_directory "$SUDOERS_D"
  regular_or_absent "$SUDOERS_FILE"
  install -d -m 0755 -o root -g "$ROOT_GROUP" "$SUDOERS_D"
  tmp="$(mktemp "${SUDOERS_FILE}.XXXXXX")"
  sudoers_line "$user" > "$tmp"
  checker="$(find_visudo)" || { rm -f "$tmp"; die "visudo not found; refusing to write $SUDOERS_FILE unchecked"; }
  if ! "$checker" -c -f "$tmp" >/dev/null 2>&1; then rm -f "$tmp"; die "visudo rejected the sudoers drop-in; $SUDO_CONF unchanged"; fi
  chmod 0440 "$tmp"; chown "root:$ROOT_GROUP" "$tmp"; mv -f "$tmp" "$SUDOERS_FILE"
}
# Install the drop-in in prelaunch only (standalone-e2e owns no sudoers
# state). Warns and keeps password authentication when the caller never
# named the laptop user or the drop-in would be ignored: both leave today's
# behavior, never a half-open sudo. Explicit garbage fails closed.
install_sudoers_dropin() {
  local user="$1"
  [ "$MODE" = prelaunch ] || return 0
  if [ -z "$user" ]; then
    echo "install-oshioki-hook: warning: no laptop user (set OSHIOKI_SUDO_USER); sudo keeps asking for passwords" >&2
    return 0
  fi
  valid_sudoers_user "$user" || die "invalid sudoers user: $user"
  if ! sudoers_included; then
    echo "install-oshioki-hook: warning: $MAIN_SUDOERS includes no sudoers.d directory; sudo keeps asking for passwords" >&2
    return 0
  fi
  write_sudoers_dropin "$user"
}
# The dry plan mirrors the real checks without writing anything.
plan_sudoers_dropin() {
  local user="$1"
  [ "$MODE" = prelaunch ] || return 0
  if [ -z "$user" ]; then echo "DRY: skip $SUDOERS_FILE (no laptop user named)"; return 0; fi
  valid_sudoers_user "$user" || die "invalid sudoers user: $user"
  if ! sudoers_included; then echo "DRY: skip $SUDOERS_FILE ($MAIN_SUDOERS includes no sudoers.d directory)"; return 0; fi
  printf 'DRY: write %s for passwordless sudo by %s\n' "$SUDOERS_FILE" "$user"
}
remove_sudoers_dropin() {
  [ "$MODE" = prelaunch ] || [ "$MODE" = disable-prelaunch ] || return 0
  [ -e "$SUDOERS_FILE" ] || [ -L "$SUDOERS_FILE" ] || return 0
  if [ "$DRY_RUN" -eq 1 ]; then printf 'DRY: remove %s\n' "$SUDOERS_FILE"; return 0; fi
  rm -f "$SUDOERS_FILE"
}
dropin_ok() {
  local user="$1" owner mode
  [ -n "$user" ] || return 1
  [ -f "$SUDOERS_FILE" ] && [ ! -L "$SUDOERS_FILE" ] || return 1
  if owner="$(stat -c '%u' "$SUDOERS_FILE" 2>/dev/null)"; then
    mode="$(stat -c '%a' "$SUDOERS_FILE")"
  else
    owner="$(stat -f '%u' "$SUDOERS_FILE" 2>/dev/null)" || return 1
    mode="$(stat -f '%Lp' "$SUDOERS_FILE")"
  fi
  [ "$owner" -eq 0 ] || return 1
  [ "$mode" = 440 ] || return 1
  grep -Fxq "$(sudoers_line "$user")" "$SUDOERS_FILE" 2>/dev/null
}

# True when the hook would refuse NATS_URL as plaintext past loopback. The
# hook itself is authoritative; this only warns at install time so a bad URL
# is caught here instead of at the first sudo afterwards.
needs_tls_warning() {
  case "$NATS_URL" in
    [Tt][Ll][Ss]://*) return 1 ;;
    [Nn][Aa][Tt][Ss]://*) ;;
    *) return 1 ;;
  esac
  [ -z "$ALLOW_PLAINTEXT" ] || return 1
  local rest host
  rest="${NATS_URL#*://}"
  rest="${rest%%/*}"; rest="${rest%%\?*}"; rest="${rest%%#*}"
  host="${rest##*@}"
  case "$host" in
    \[*\]*) host="$(printf '%s' "$host" | sed 's/^\[//; s/\].*//')" ;;
    *) host="${host%%:*}" ;;
  esac
  case "$host" in
    ""|[Ll][Oo][Cc][Aa][Ll][Hh][Oo][Ss][Tt]|127.*|::1) return 1 ;;
  esac
  return 0
}

load_config_file() {
  local path="$1" owner mode line key value
  if [ ! -f "$path" ] || [ -L "$path" ]; then
    die "config file must be a regular file: $path"
  fi
  if owner="$(stat -c '%u' "$path" 2>/dev/null)"; then
    mode="$(stat -c '%a' "$path")"
  else
    owner="$(stat -f '%u' "$path")"
    mode="$(stat -f '%Lp' "$path")"
  fi
  [ "$owner" -eq 0 ] || die "config file must be owned by root: $path"
  [ "$mode" = 600 ] || die "config file must have mode 0600: $path"
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    case "$line" in \#*) continue ;; esac
    case "$line" in *=*) ;; *) die "invalid config line in $path" ;; esac
    key="${line%%=*}"
    value="${line#*=}"
    case "$value" in
      [[:space:]]*|*[[:space:]]|\"*\"|\'*\') die "config value must be unquoted and untrimmed: $key" ;;
    esac
    case "$key" in
      OSHIOKI_ORIGIN) ORIGIN="$value" ;;
      OSHIOKI_RP_ID) RP_ID="$value" ;;
      NATS_URL) NATS_URL="$value" ;;
      NATS_USER) NATS_USER="$value" ;;
      NATS_PASS) NATS_PASS="$value" ;;
      OSHIOKI_ALLOW_PLAINTEXT_NATS) ALLOW_PLAINTEXT="$value" ;;
      OSHIOKI_AGENT_SOCKET) AGENT_SOCKET="$value" ;;
      OSHIOKI_LOCAL) : ;; # local-setup marker; inert, kept so the mode is visible in the file
      *) die "unknown config key in $path: $key" ;;
    esac
  done < "$path"
}

# Resolve caller-supplied paths (e.g. Homebrew prefix symlinks) to the real
# files before the safety checks below. Checksum lookup uses the resolved
# basename, so links must keep the artifact filename.
HOOK_BIN="$(canonicalize "$HOOK_BIN")"
PLUGIN_BIN="$(canonicalize "$PLUGIN_BIN")"

[ -z "$CONFIG_FILE" ] || load_config_file "$CONFIG_FILE"

validate_marker_pair() {
  local source="$1" begin="$2" end="$3" begins ends begin_line end_line
  begins="$(grep -cF "$begin" "$source" 2>/dev/null || true)"
  ends="$(grep -cF "$end" "$source" 2>/dev/null || true)"
  { [ "$begins" -eq 0 ] && [ "$ends" -eq 0 ]; } ||
    { [ "$begins" -eq 1 ] && [ "$ends" -eq 1 ]; } ||
    die "malformed managed block in $source"
  if [ "$begins" -eq 1 ]; then
    begin_line="$(grep -nF "$begin" "$source" | cut -d: -f1)"
    end_line="$(grep -nF "$end" "$source" | cut -d: -f1)"
    [ "$begin_line" -lt "$end_line" ] || die "malformed managed block in $source"
  fi
}

validate_block() {
  local source="$1"
  validate_marker_pair "$source" "$BEGIN_MARK" "$END_MARK"
}

if [ "$MODE" = prelaunch-status ]; then
  [ -f "$SUDO_CONF" ] || { echo "disabled"; exit 1; }
  validate_block "$SUDO_CONF"
  begins="$(grep -cF "$BEGIN_MARK" "$SUDO_CONF" || true)"
  if [ "$begins" -gt 0 ] && grep -Fq "Plugin approval_exec $PLUGIN_DEST" "$SUDO_CONF"; then
    # With no named user there is no drop-in to verify, so the plugin block
    # alone reports enabled; laptop-setup always names one, keeping the
    # coupling strict in the owned flow.
    dropin_user="$(sudoers_user)"
    if [ -z "$dropin_user" ] || dropin_ok "$dropin_user"; then echo "enabled: $PLUGIN_DEST"; exit 0; fi
    echo "enabled without passwordless sudo"
    exit 1
  fi
  if [ "$begins" -eq 0 ]; then echo "disabled"; exit 1; fi
  die "malformed managed block in $SUDO_CONF"
fi

[ "$(id -u)" -eq 0 ] || [ "$DRY_RUN" -eq 1 ] || die "must run as root"
safe_directory "$(dirname "$STATE_DIR")"; safe_directory "$STATE_DIR"; regular_or_absent "$SUDO_CONF"
safe_directory "$SBIN_DIR"; safe_directory "$PLUGIN_DIR"; regular_or_absent "$SBIN_DIR/oshioki"; regular_or_absent "$PLUGIN_DEST"
regular_or_absent "$STATE_DIR/config.env"; regular_or_absent "$STATE_DIR/hook.json"; regular_or_absent "$STATE_DIR/devices.json"

if [ "$DRY_RUN" -eq 0 ]; then
  mkdir "$LOCK_DIR" 2>/dev/null || die "another installer holds $LOCK_DIR"
  trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT HUP INT TERM
fi

rewrite_block() {
  local action="$1" source="$2" destination="$3" tmp
  validate_block "$source"
  tmp="$(mktemp "${destination}.XXXXXX")"
  awk -v begin="$BEGIN_MARK" -v end="$END_MARK" '
    $0 == begin { inside=1; next }
    $0 == end { inside=0; next }
    !inside { print }
  ' "$source" > "$tmp"
  if grep -q '^Plugin approval_exec ' "$tmp"; then
    rm -f "$tmp"
    die "unmanaged approval_exec plugin line in $source"
  fi
  if [ "$action" = enable ]; then
    [ ! -s "$tmp" ] || [ "$(tail -c 1 "$tmp" | wc -l)" -ne 0 ] || printf '\n' >> "$tmp"
    printf '%s\nPlugin approval_exec %s\n%s\n' "$BEGIN_MARK" "$PLUGIN_DEST" "$END_MARK" >> "$tmp"
  fi
  chmod 0644 "$tmp"; chown "root:$ROOT_GROUP" "$tmp"; mv -f "$tmp" "$destination"
}

[ ! -f "$SUDO_CONF" ] || validate_block "$SUDO_CONF"

validate_sudo() {
  if [ "${SKIP_NODEVER:-0}" = 1 ]; then return 0; fi
  if [ "$DRY_RUN" -eq 1 ]; then printf 'DRY: sudo -V  # validate %s\n' "$SUDO_CONF"; return 0; fi
  sudo -V >/dev/null 2>&1
}

if [ "$MODE" = disable-prelaunch ]; then
  [ -f "$SUDO_CONF" ] || die "missing $SUDO_CONF"
  if [ "$DRY_RUN" -eq 1 ]; then echo "DRY: remove exact managed block from $SUDO_CONF"; remove_sudoers_dropin; exit 0; fi
  backup="$(mktemp "${SUDO_CONF}.rollback.XXXXXX")"; cp -p "$SUDO_CONF" "$backup"
  dropin_backup=""
  if [ -f "$SUDOERS_FILE" ]; then dropin_backup="$(mktemp "${SUDOERS_FILE}.backup.XXXXXX")"; cp -p "$SUDOERS_FILE" "$dropin_backup"; fi
  rewrite_block disable "$SUDO_CONF" "$SUDO_CONF"
  remove_sudoers_dropin
  if ! validate_sudo; then
    cp -p "$backup" "$SUDO_CONF"; rm -f "$backup"
    # rm first: the drop-in is 0440, so overwriting it in place fails.
    if [ -n "$dropin_backup" ]; then rm -f "$SUDOERS_FILE"; cp -p "$dropin_backup" "$SUDOERS_FILE"; rm -f "$dropin_backup"; fi
    die "sudo -V failed after disable; restored prior configuration"
  fi
  rm -f "$backup"; [ -z "$dropin_backup" ] || rm -f "$dropin_backup"
  echo "install-oshioki-hook: prelaunch disabled and sudo validated"; exit 0
fi

[ -n "$ORIGIN" ] || die "OSHIOKI_ORIGIN is required"
[ -n "$RP_ID" ] || die "OSHIOKI_RP_ID is required"
[ -n "$NATS_URL" ] || die "NATS_URL is required"
[ -n "$NATS_PASS" ] || die "NATS_PASS is required"
if needs_tls_warning; then
  echo "install-oshioki-hook: warning: NATS_URL is plaintext to a non-loopback host, and the hook will refuse it: use tls://, or set OSHIOKI_ALLOW_PLAINTEXT_NATS=1 (testing only; see README.md)" >&2
fi

for artifact in "$HOOK_BIN" "$PLUGIN_BIN"; do
  if [ ! -f "$artifact" ] || [ -L "$artifact" ]; then
    die "missing or unsafe build artifact: $artifact"
  fi
done
architecture="$(uname -m)"; file_output="$(file -b "$HOOK_BIN") $(file -b "$PLUGIN_BIN")"
case "$architecture" in
  x86_64|amd64) grep -Eqi 'x86[-_ ]?64|x86_64' <<<"$file_output" || die "artifact architecture does not match $architecture" ;;
  arm64|aarch64) grep -Eqi 'arm64|aarch64' <<<"$file_output" || die "artifact architecture does not match $architecture" ;;
  *) die "unsupported architecture: $architecture" ;;
esac

CHECKSUMS="${OSHIOKI_CHECKSUMS:-$SERVICE_DIR/target/release/SHA256SUMS}"
CHECKSUMS="$(canonicalize "$CHECKSUMS")"
if [ ! -f "$CHECKSUMS" ] || [ -L "$CHECKSUMS" ]; then
  die "missing artifact checksum manifest: $CHECKSUMS"
fi
for artifact in "$HOOK_BIN" "$PLUGIN_BIN"; do
  name="$(basename "$artifact")"; expected="$(awk -v name="$name" '$2 == name {print $1}' "$CHECKSUMS")"
  [ "${#expected}" -eq 64 ] || die "checksum manifest has no exact entry for $name"
  [ "$(hash_file "$artifact")" = "$expected" ] || die "checksum mismatch for $name"
done


run install -d -m 0755 "$SBIN_DIR" "$PLUGIN_DIR"
run install -m 0755 -o root -g "$ROOT_GROUP" "$HOOK_BIN" "$SBIN_DIR/oshioki"
run install -m 0755 -o root -g "$ROOT_GROUP" "$PLUGIN_BIN" "$PLUGIN_DEST"
run install -d -m 0750 -o root -g "$ROOT_GROUP" "$STATE_DIR"

if [ "$DRY_RUN" -eq 1 ]; then
  printf 'DRY: write %s/config.env with NATS_PASS=<redacted>\n' "$STATE_DIR"
  [ -z "$ALLOW_PLAINTEXT" ] || printf 'DRY: write OSHIOKI_ALLOW_PLAINTEXT_NATS=%s to config.env\n' "$ALLOW_PLAINTEXT"
  [ -z "$AGENT_SOCKET" ] || printf 'DRY: write OSHIOKI_AGENT_SOCKET=%s to config.env\n' "$AGENT_SOCKET"
  printf 'DRY: write %s/hook.json for origin %s and RP ID %s\n' "$STATE_DIR" "$ORIGIN" "$RP_ID"
else
  tmp="$(mktemp "$STATE_DIR/config.env.XXXXXX")"; printf 'NATS_URL=%s\nNATS_USER=%s\nNATS_PASS=%s\n' "$NATS_URL" "$NATS_USER" "$NATS_PASS" > "$tmp"; [ -z "$ALLOW_PLAINTEXT" ] || printf 'OSHIOKI_ALLOW_PLAINTEXT_NATS=%s\n' "$ALLOW_PLAINTEXT" >> "$tmp"; [ -z "$AGENT_SOCKET" ] || printf 'OSHIOKI_AGENT_SOCKET=%s\n' "$AGENT_SOCKET" >> "$tmp"; chmod 0600 "$tmp"; chown "root:$ROOT_GROUP" "$tmp"; mv -f "$tmp" "$STATE_DIR/config.env"
  tmp="$(mktemp "$STATE_DIR/hook.json.XXXXXX")"; printf '{"version":1,"origin":"%s","rp_id":"%s","server_base_url":"%s"}\n' "$ORIGIN" "$RP_ID" "$ORIGIN" > "$tmp"; chmod 0600 "$tmp"; chown "root:$ROOT_GROUP" "$tmp"; mv -f "$tmp" "$STATE_DIR/hook.json"
  if [ ! -e "$STATE_DIR/devices.json" ]; then printf '{"version":1,"devices":[]}\n' > "$STATE_DIR/devices.json"; chmod 0600 "$STATE_DIR/devices.json"; chown "root:$ROOT_GROUP" "$STATE_DIR/devices.json"; fi
fi

# Enabling the plugin with no approval devices locks every sudo out: the
# hook fails closed on an empty registry, including the sudo that would pin
# the first device. The binaries and config still install; pin a device and
# re-run to enable. The registry is machine-written, so the literal
# `"active": true` can only come from the active field: string values escape
# their quotes, and no other key is named active.
registry_has_active_devices() {
  grep -Eq '"active":[[:space:]]*true' "$STATE_DIR/devices.json" 2>/dev/null
}
if [ "$DRY_RUN" -eq 1 ]; then
  if registry_has_active_devices; then echo "DRY: enable exact managed block in $SUDO_CONF"; plan_sudoers_dropin "$(sudoers_user)"; else echo "DRY: skip enabling $SUDO_CONF (no active approval devices)"; remove_sudoers_dropin; fi
  validate_sudo; exit 0
fi
if ! registry_has_active_devices; then
  echo "install-oshioki-hook: warning: no active approval devices; leaving $SUDO_CONF without the managed block (pin a device, then re-run)" >&2
  remove_sudoers_dropin
else
[ -f "$SUDO_CONF" ] || install -m 0644 -o root -g "$ROOT_GROUP" /dev/null "$SUDO_CONF"
backup="$(mktemp "${SUDO_CONF}.rollback.XXXXXX")"; cp -p "$SUDO_CONF" "$backup"
dropin_backup=""
if [ -f "$SUDOERS_FILE" ]; then dropin_backup="$(mktemp "${SUDOERS_FILE}.backup.XXXXXX")"; cp -p "$SUDOERS_FILE" "$dropin_backup"; fi
rewrite_block enable "$SUDO_CONF" "$SUDO_CONF"
install_sudoers_dropin "$(sudoers_user)"
if ! validate_sudo; then
  rewrite_block disable "$SUDO_CONF" "$SUDO_CONF"; cp -p "$backup" "$SUDO_CONF"; rm -f "$backup"
  # rm first: the drop-in is 0440, so overwriting it in place fails.
  if [ -n "$dropin_backup" ]; then rm -f "$SUDOERS_FILE"; cp -p "$dropin_backup" "$SUDOERS_FILE"; rm -f "$dropin_backup"; else rm -f "$SUDOERS_FILE"; fi
  die "sudo -V failed; restored prior configuration"
fi
rm -f "$backup"; [ -z "$dropin_backup" ] || rm -f "$dropin_backup"
fi
echo "install-oshioki-hook: $MODE installed and sudo validated"
