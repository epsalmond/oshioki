#!/usr/bin/env bash
set -euo pipefail

OUTPUT="${1:-}"
[ -n "$OUTPUT" ] || { echo "usage: build-darwin-artifact OUTPUT_DIR" >&2; exit 2; }
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
REVISION="$(git -C "$ROOT" rev-parse HEAD)"
TARGET="aarch64-apple-darwin"

cd "$ROOT"
cargo build --locked --release --target "$TARGET" -p management-plane-sudo-approve -p plugin
mkdir -p "$OUTPUT"
install -m 0755 "target/$TARGET/release/management-plane-sudo-approve" "$OUTPUT/management-plane-sudo-approve"
install -m 0755 "target/$TARGET/release/libplugin.dylib" "$OUTPUT/approval_exec.dylib"

mode_of() { if stat -f '%Lp' "$1" >/dev/null 2>&1; then stat -f '%Lp' "$1"; else stat -c '%a' "$1"; fi; }
hash_of() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'; else shasum -a 256 "$1" | awk '{print $1}'; fi; }
hook_hash="$(hash_of "$OUTPUT/management-plane-sudo-approve")"
plugin_hash="$(hash_of "$OUTPUT/approval_exec.dylib")"
toolchain="$(rustc --version --verbose | tr '\n' ';')"
cat > "$OUTPUT/manifest.json" <<EOF
{"schema_version":1,"target":"$TARGET","revision":"$REVISION","toolchain":"$toolchain","files":[{"name":"management-plane-sudo-approve","mode":"$(mode_of "$OUTPUT/management-plane-sudo-approve")","sha256":"$hook_hash","media_type":"application/vnd.psalmond.sudo-approve.hook.v1"},{"name":"approval_exec.dylib","mode":"$(mode_of "$OUTPUT/approval_exec.dylib")","sha256":"$plugin_hash","media_type":"application/vnd.psalmond.sudo-approve.plugin.v1"}]}
EOF
(
  cd "$OUTPUT"
  if command -v sha256sum >/dev/null 2>&1; then sha256sum management-plane-sudo-approve approval_exec.dylib manifest.json > SHA256SUMS; else shasum -a 256 management-plane-sudo-approve approval_exec.dylib manifest.json > SHA256SUMS; fi
)
file "$OUTPUT/management-plane-sudo-approve" "$OUTPUT/approval_exec.dylib" | grep -q 'arm64'
nm -gU "$OUTPUT/approval_exec.dylib" | grep -Eq '(_)?approval_exec$'
