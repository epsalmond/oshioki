#!/usr/bin/env bash
set -euo pipefail
SOURCE="${1:?usage: prepare-image-dockerfile SOURCE DESTINATION DESCRIPTOR}"
DESTINATION="${2:?usage: prepare-image-dockerfile SOURCE DESTINATION DESCRIPTOR}"
DESCRIPTOR="${3:?usage: prepare-image-dockerfile SOURCE DESTINATION DESCRIPTOR}"
digest="$(jq -er '.digest' "$DESCRIPTOR")"
case "$digest" in sha256:????????????????????????????????????????????????????????????????) ;; *) echo "invalid OCI digest" >&2; exit 1;; esac
sed "s/^ARG DARWIN_ARTIFACT_DIGEST$/ARG DARWIN_ARTIFACT_DIGEST=$digest/" "$SOURCE" > "$DESTINATION"
grep -Fq "ARG DARWIN_ARTIFACT_DIGEST=$digest" "$DESTINATION"
