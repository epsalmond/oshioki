#!/usr/bin/env bash
set -euo pipefail
# test-ntfy-isolation: a dead ntfy endpoint must not delay verdicts.
#
# Seeds a pending request with an enrolled device, parks an undeliverable
# ntfy row head-of-line in the outbox, submits a browser denial, and proves
# the verdict reaches NATS before the request expires — while the ntfy row
# stays unsent and the server stays healthy.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"

for tool in cargo nats-server sqlite3 curl python3; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "missing ntfy isolation prerequisite: $tool" >&2
    exit 2
  }
done

free_port() {
  python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'
}

NATS_PORT="$(free_port)"
SERVER_PORT="$(free_port)"
while [ "$SERVER_PORT" = "$NATS_PORT" ]; do SERVER_PORT="$(free_port)"; done
DEAD_PORT="$(free_port)"
while [ "$DEAD_PORT" = "$NATS_PORT" ] || [ "$DEAD_PORT" = "$SERVER_PORT" ]; do DEAD_PORT="$(free_port)"; done

TEMP_ROOT="$(cd "${TMPDIR:-/tmp}" && pwd -P)"
STATE_ROOT="$(mktemp -d "$TEMP_ROOT/oshioki-ntfy.XXXXXX")"
NATS_PID=""
SERVER_PID=""
SUB_PID=""
TEST_OK=0

cleanup() {
  set +e
  [ -z "$SUB_PID" ] || kill "$SUB_PID" >/dev/null 2>&1 || true
  [ -z "$SERVER_PID" ] || kill "$SERVER_PID" >/dev/null 2>&1 || true
  [ -z "$NATS_PID" ] || kill "$NATS_PID" >/dev/null 2>&1 || true
  [ -z "$SUB_PID" ] || wait "$SUB_PID" >/dev/null 2>&1 || true
  [ -z "$SERVER_PID" ] || wait "$SERVER_PID" >/dev/null 2>&1 || true
  [ -z "$NATS_PID" ] || wait "$NATS_PID" >/dev/null 2>&1 || true
  if [ "$TEST_OK" -eq 1 ]; then
    rm -rf -- "$STATE_ROOT"
  else
    printf 'retained failed ntfy state: %s\n' "$STATE_ROOT" >&2
  fi
}
trap cleanup EXIT

fail() {
  echo "test-ntfy-isolation: $*" >&2
  exit 1
}

mkdir -p "$STATE_ROOT/nats" "$STATE_ROOT/server"
cargo build --manifest-path "$REPO_ROOT/Cargo.toml" -p oshioki-server --locked

nats-server -js -sd "$STATE_ROOT/nats" -p "$NATS_PORT" \
  --user oshioki --pass test-only >"$STATE_ROOT/nats.log" 2>&1 &
NATS_PID=$!
for _ in $(seq 1 50); do
  if (exec 3<>"/dev/tcp/127.0.0.1/$NATS_PORT") 2>/dev/null; then
    exec 3>&-
    break
  fi
  sleep 0.1
done
kill -0 "$NATS_PID" || fail "nats-server did not start (see $STATE_ROOT/nats.log)"

# Minimal raw-NATS client: create the request stream, then subscribe for the
# verdict. stdlib only, same as scripts/test-sudo-plugin-subscriber.py.
cat >"$STATE_ROOT/nats_helper.py" <<'PYEOF'
import json, os, socket, sys, time

host, port, user, password, mode, subject, outfile = (
    sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4],
    sys.argv[5], sys.argv[6], sys.argv[7] if len(sys.argv) > 7 else None,
)
deadline = time.time() + 30
sock = socket.create_connection((host, port), timeout=30)
sock.settimeout(30)
sock.sendall(
    ("CONNECT %s\r\n" % json.dumps({
        "verbose": False, "pedantic": False, "user": user, "pass": password,
    })).encode()
)
buf = b""

def lines():
    global buf
    while time.time() < deadline:
        end = buf.find(b"\r\n")
        if end < 0:
            chunk = sock.recv(65535)
            if not chunk:
                return
            buf += chunk
            continue
        line = buf[:end]
        buf = buf[end + 2 :]
        yield line

def send(data: bytes):
    sock.sendall(data)

def await_pong():
    for line in lines():
        if line == b"PONG":
            return
        if line == b"PING":
            send(b"PONG\r\n")
        elif line.startswith(b"-ERR"):
            raise RuntimeError(line.decode())
    raise RuntimeError("no PONG from NATS")

def await_msg(sid: bytes):
    global buf
    wanted = b"MSG "
    while time.time() < deadline:
        for line in lines():
            if line == b"PING":
                send(b"PONG\r\n")
            elif line.startswith(b"-ERR"):
                raise RuntimeError(line.decode())
            elif line.startswith(wanted):
                _, _, msg_sid, length = line.split(b" ")
                while len(buf) < int(length) + 2:
                    chunk = sock.recv(65535)
                    if not chunk:
                        raise RuntimeError("connection closed mid-payload")
                    buf += chunk
                payload = buf[: int(length)]
                buf = buf[int(length) + 2 :]
                if msg_sid == sid:
                    return payload
    raise RuntimeError("no MSG from NATS")

if mode == "create-stream":
    send(b"SUB _INBOX.ntfy 1\r\nPING\r\n")
    await_pong()
    body = json.dumps({
        "name": "OSHIOKI", "subjects": ["oshioki.request.>"],
        "retention": "limits", "discard": "old",
        "max_age": 600_000_000_000, "storage": "memory", "num_replicas": 1,
    }).encode()
    send(b"PUB $JS.API.STREAM.CREATE.OSHIOKI _INBOX.ntfy %d\r\n" % len(body) + body + b"\r\n")
    response = json.loads(await_msg(b"1"))
    if "error" in response:
        raise RuntimeError("stream create failed: %s" % response["error"])
    print("stream ok")
elif mode == "subscribe":
    send(b"SUB " + subject.encode() + b" 2\r\nPING\r\n")
    await_pong()
    payload = await_msg(b"2")
    with open(outfile + ".part", "wb") as handle:
        handle.write(payload)
    os.replace(outfile + ".part", outfile)
    print("verdict ok")
PYEOF

NATS_ARGS=(127.0.0.1 "$NATS_PORT" oshioki test-only)
python3 "$STATE_ROOT/nats_helper.py" "${NATS_ARGS[@]}" create-stream OSHIOKI "$STATE_ROOT" \
  || fail "stream create failed"

NATS_URL="nats://127.0.0.1:$NATS_PORT" \
NATS_USER=oshioki \
NATS_PASS=test-only \
OSHIOKI_STATE_PATH="$STATE_ROOT/server/state.sqlite3" \
OSHIOKI_LISTEN="127.0.0.1:$SERVER_PORT" \
OSHIOKI_ORIGIN="https://sudo.test" \
OSHIOKI_RP_ID=sudo.test \
  "$REPO_ROOT/target/debug/oshioki-server" >"$STATE_ROOT/server.log" 2>&1 &
SERVER_PID=$!
for _ in $(seq 1 100); do
  if curl --fail --silent "http://127.0.0.1:$SERVER_PORT/healthz" >/dev/null; then
    break
  fi
  sleep 0.1
done
curl --fail --silent "http://127.0.0.1:$SERVER_PORT/healthz" >/dev/null \
  || fail "server did not become healthy (see $STATE_ROOT/server.log)"

REQUEST_ID="ntfy-test-1"
TOKEN="test-token-ntfy-1-0123456789abcdef"
FINGERPRINT="$(python3 -c 'import base64; print(base64.urlsafe_b64encode(bytes(range(16))).rstrip(b"=").decode())')"
TOKEN_HEX="$(printf '%s' "$TOKEN" | sha256sum | awk '{print $1}')"
ENVELOPE_HEX="$(printf '%s' "$REQUEST_ID" | sha256sum | awk '{print $1}')"
NTFY_HEX="$(python3 -c 'import sys; print(sys.argv[1].encode().hex())' '{"title":"sudo on nas"}')"
NOW="$(date +%s)"
EXPIRY="$((NOW + 180))"
DB="$STATE_ROOT/server/state.sqlite3"

sqlite3 "$DB" <<SQL || fail "seeding the database failed"
INSERT INTO devices(fingerprint, credential_id, api_token_hash, public_record_json, active, updated_at)
VALUES('$FINGERPRINT', 'ntfy-cred-1', X'$TOKEN_HEX', '{}', 1, $NOW);
INSERT INTO requests(id, envelope_hash, envelope_json, host, user, issued_at, expires_at, state, created_at)
VALUES('$REQUEST_ID', X'$ENVELOPE_HEX', '{}', 'nas', 'eric', $NOW, $EXPIRY, 'pending', $NOW);
INSERT INTO sealed_bodies(request_id, fingerprint, body_json)
VALUES('$REQUEST_ID', '$FINGERPRINT', '{"device_fingerprint":"$FINGERPRINT","ephemeral_pub":"AA","nonce":"AA","ciphertext":"AA"}');
INSERT INTO outbox(kind, dedupe_key, subject, payload, created_at)
VALUES('ntfy', 'ntfy-seed-1', 'http://127.0.0.1:$DEAD_PORT/', X'$NTFY_HEX', $NOW);
SQL

# The ntfy row above has the lowest outbox id: under the old shared queue it
# head-of-line-blocks the verdict below. Nothing listens on DEAD_PORT, so the
# notification worker fails and backs off while the verdict lane proceeds.
VERDICT_FILE="$STATE_ROOT/verdict.json"
python3 "$STATE_ROOT/nats_helper.py" "${NATS_ARGS[@]}" subscribe "oshioki.verdict.$REQUEST_ID" "$VERDICT_FILE" &
SUB_PID=$!
sleep 1

STATUS="$(curl --silent --output /dev/null --write-out '%{http_code}' -X POST \
  "http://127.0.0.1:$SERVER_PORT/api/v1/requests/$REQUEST_ID/deny" \
  -H "Authorization: Bearer $TOKEN" \
  -H 'Content-Type: application/json' \
  -d "{\"version\":1,\"request_id\":\"$REQUEST_ID\",\"device_fingerprint\":\"$FINGERPRINT\"}")"
[ "$STATUS" = "202" ] || fail "deny was not accepted (HTTP $STATUS)"

for _ in $(seq 1 300); do
  [ -f "$VERDICT_FILE" ] && break
  sleep 0.1
done
[ -f "$VERDICT_FILE" ] || fail "verdict never reached NATS (ntfy blocked the queue?)"
grep -Fq "$REQUEST_ID" "$VERDICT_FILE" || fail "verdict payload names another request"
[ "$(date +%s)" -lt "$EXPIRY" ] || fail "verdict arrived after the request expired"

UNSENT="$(sqlite3 "$DB" "SELECT COUNT(*) FROM outbox WHERE kind='ntfy' AND sent_at IS NULL;")"
[ "$UNSENT" = "1" ] || fail "the failed notification was lost or marked sent"
curl --fail --silent "http://127.0.0.1:$SERVER_PORT/healthz" >/dev/null \
  || fail "server went unhealthy while ntfy was down"

TEST_OK=1
echo "test-ntfy-isolation: PASS"
