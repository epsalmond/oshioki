#!/usr/bin/env bash
# Reproducible, test-only sudo policy-query characterization for issue 73.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
WORKSPACE="$(cd "$SCRIPT_DIR/.." && pwd -P)"
IMAGE="${IMAGE:-ubuntu:24.04}"
KEEP_ARTIFACTS="${OSHIOKI_E2E_KEEP_ARTIFACTS:-0}"
STATE_ROOT="$(mktemp -d -t oshioki-sudo-query.XXXXXX)"
CONTAINER="oshioki-sudo-query-${STATE_ROOT##*.}"
TEST_SUCCEEDED=0

cleanup() {
    set +e
    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
    if [ "$TEST_SUCCEEDED" -eq 1 ] && [ "$KEEP_ARTIFACTS" != 1 ]; then
        rm -rf "$STATE_ROOT"
    else
        echo "* retained sudo policy-query artifacts: $STATE_ROOT" >&2
    fi
}
trap cleanup EXIT

mkdir -p "$STATE_ROOT"
chmod 0700 "$STATE_ROOT"
docker run --rm --name "$CONTAINER" --pids-limit 64 \
    -v "$WORKSPACE":/work:ro \
    -v "$STATE_ROOT":/run/oshioki-sudo-query:rw \
    "$IMAGE" \
    bash /work/tests/sudo-query/run-in-container.sh

TEST_SUCCEEDED=1
echo "* PASS: sudo policy-query spike (Ubuntu 24.04, private approval plugin)"
