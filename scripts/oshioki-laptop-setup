#!/usr/bin/env bash
# shellcheck disable=SC2015,SC2034
# One-command laptop setup for local sudo approvals.
#
# brew install epsalmond/oshioki/oshioki && oshioki-laptop-setup
#
# Idempotent: re-running after a brew upgrade reinstalls the hook and plugin
# from the new bottle and restarts the agent. Everything needing privilege
# goes through sudo; the NATS password never appears in output or arguments.
#
# --local pairs this machine with itself and needs no server: the device
# record is exported and pinned directly, and the installer leaves the sudo
# plugin disabled until a device is active rather than locking sudo out.
# --local is socket-only unless a NATS is staged (NATS_URL, NATS_USER, or
# NATS_PASS in the environment): a staged NATS is probed before anything is
# written, and an unstaged one writes no NATS keys anywhere, never
# placeholders. A stale placeholder install migrates with --reconfigure.
#
# The Mac agent's autostart plist gets its own NATS role, never the hook's:
# server mode prompts for it separately (persisted as OSHIOKI_AGENT_NATS_URL/
# USER/PASS in install.env, defaulting the URL to the hook's own but every
# field independently overridable); --local stages the same three names from
# the environment, unpersisted. An existing plist that already names a NATS
# is left alone on an ordinary re-run -- only --reconfigure replaces it. See
# RUNBOOK.md.
# On macOS --local also wraps the agent in
# Oshioki.app (scripts/mac/bundle-agent) so the Touch ID sheet shows the
# Oshioki name and logo instead of a bare binary; set OSHIOKI_SIGN_IDENTITY
# to sign the bundle too.
#
# One elevation per run: --local does all of its privileged work (config,
# install, pin, enable) in a single sudo of this script's --privileged-phase
# subcommand, so setup costs one approval instead of one per step. The phase
# shows the installer's dry-run plan and asks before acting; only its
# machine-readable value block goes to stdout, everything human-facing goes
# to stderr. Server mode keeps its interactive multi-step flow.
#
# Portable to the stock macOS bash 3.2: no arrays, no associative arrays,
# no process substitution.
set -euo pipefail

# Owner-only by default: install.env, agent.env, and the plist all hold the
# NATS password, and creating them at the ambient umask would leave each
# briefly world-readable before its explicit chmod runs.
umask 077

die() { echo "oshioki-laptop-setup: $*" >&2; exit 1; }
# Everything human-facing goes to stderr: the privileged phase's stdout is a
# machine-readable value block the outer run parses.
info() { echo "oshioki-laptop-setup: $*" >&2; }
# agent.env is read back by shell sourcing, so every value has to survive the
# shell: a password holding a space, $, backtick, # or quote would otherwise
# be split or expanded. Single quotes suppress all of that, and a literal
# single quote is spliced in as '\'' -- the one character they cannot hold.
shell_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

YES=0
RECONFIGURE=0
LOCAL=0
PRIVILEGED=0
VALUES_FILE=""
# Opt-in, never the default: the contextual PAM lane replaces the approval
# plugin and the blanket NOPASSWD rule with a PAM auth entry, and a laptop
# that gets it by surprise is a laptop whose sudo changed shape without its
# owner asking. Same spelling as the .deb's /etc/oshioki/install.env key so
# one name covers both lanes.
CONTEXTUAL_PAM="${OSHIOKI_CONTEXTUAL_PAM:-0}"
[ "$CONTEXTUAL_PAM" = 1 ] || CONTEXTUAL_PAM=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --yes) YES=1 ;;
    --reconfigure) RECONFIGURE=1 ;;
    --local) LOCAL=1 ;;
    --privileged-phase) PRIVILEGED=1 ;;
    --contextual-pam) CONTEXTUAL_PAM=1 ;;
    --values-file)
      [ "$#" -ge 2 ] || die "--values-file requires a path"
      VALUES_FILE="$2"; shift
      ;;
    -h|--help)
      echo "usage: oshioki-laptop-setup [--yes] [--reconfigure] [--local] [--contextual-pam]" >&2
      echo "  --yes          accept defaults and prompts without asking" >&2
      echo "  --reconfigure  re-enter /etc/oshioki/install.env from scratch" >&2
      echo "  --local        pair this machine with itself; no server needed" >&2
      echo "  --contextual-pam  after the install, migrate sudo to the PAM lane" >&2
      echo "                    (same as OSHIOKI_CONTEXTUAL_PAM=1); keep a second" >&2
      echo "                    root shell open while it runs" >&2
      exit 0
      ;;
    *) echo "oshioki-laptop-setup: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

# The script elevates once by itself (step 2); running the whole thing as
# root poisons user-owned files instead (the app bundle lost its readable
# icon that way). The privileged phase is the only part that runs as root.
if [ "$PRIVILEGED" -eq 0 ] && [ "$(id -u)" -eq 0 ]; then
  die "run as yourself, not under sudo: the script elevates once by itself"
fi

# Absolute path to this script, with every symlink in the chain walked out.
# `pwd -P` alone resolves symlinked *directories* but not a symlinked
# *file*, and Homebrew puts this script on PATH as
# /opt/homebrew/bin/oshioki-laptop-setup -> ../Cellar/oshioki/<version>/bin/
# oshioki-laptop-setup. Without this the keg probe below would look for
# /opt/homebrew/libexec/SHA256SUMS, miss it, and leave the installer to fall
# back on a repo-relative build path that does not exist (issue #91). It is
# also the path the privileged phase re-invokes under sudo, where a bare
# name would not resolve. macOS ships no `readlink -f`, hence the loop.
resolve_script_path() {
  local path="$1" target dir hops=0
  while [ -L "$path" ]; do
    hops=$((hops + 1))
    [ "$hops" -le 40 ] || die "symlink loop resolving $1"
    # Fail closed. A readlink that is missing or errors would otherwise leave
    # target empty, path would become "<dir>/", the loop would end, and the
    # function would hand back the link's own directory -- exactly the #91
    # behaviour this walk exists to prevent, with nothing said about it.
    target="$(readlink "$path")" && [ -n "$target" ] ||
      die "cannot resolve symlink: $path"
    case "$target" in
      /*) path="$target" ;;
      *) path="$(dirname "$path")/$target" ;;
    esac
  done
  dir="$(cd "$(dirname "$path")" && pwd -P)" ||
    die "cannot reach the directory of $path"
  printf '%s/%s\n' "$dir" "$(basename "$path")"
}
SCRIPT_PATH="$(resolve_script_path "${BASH_SOURCE[0]}")" || exit 1
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
# The keg (or repo) root one level up, normalised here so every path derived
# from it is printable and comparable rather than carrying a literal "/..".
PARENT_DIR="$(cd "$SCRIPT_DIR/.." && pwd -P)"
AGENT_BIN_EXPLICIT="${AGENT_BIN:-}"
LAPTOP_USER="${SUDO_USER:-$(id -un)}"
INSTALLER="${INSTALLER:-$SCRIPT_DIR/install-oshioki-hook}"
AGENT_BIN="${AGENT_BIN:-$SCRIPT_DIR/oshioki-agent}"
# Repo checkout layout keeps the built agent next to the source tree.
if [ ! -x "$AGENT_BIN" ] && [ -x "$PARENT_DIR/target/release/oshioki-agent" ]; then
  AGENT_BIN="$PARENT_DIR/target/release/oshioki-agent"
fi
# Brew layout keeps binaries next to this script and data one level up in
# libexec. HOOK_BIN and friends stay empty outside that layout so the
# installer falls back to its own repo defaults.
HOOK_BIN=""
PLUGIN_BIN=""
OSHIOKI_CHECKSUMS=""
if [ -x "$SCRIPT_DIR/oshioki" ] && [ -f "$PARENT_DIR/libexec/SHA256SUMS" ]; then
  HOOK_BIN="${HOOK_BIN:-$SCRIPT_DIR/oshioki}"
  PLUGIN_BIN="${PLUGIN_BIN:-$PARENT_DIR/libexec/oshioki.dylib}"
  OSHIOKI_CHECKSUMS="${OSHIOKI_CHECKSUMS:-$PARENT_DIR/libexec/SHA256SUMS}"
fi
HOOK_BIN="${HOOK_BIN:-}"
PLUGIN_BIN="${PLUGIN_BIN:-}"
OSHIOKI_CHECKSUMS="${OSHIOKI_CHECKSUMS:-}"
# The PAM module, wherever this layout put it. Left empty when it is absent:
# only --contextual-pam needs it, and the installer's own error is clearer
# than one invented here. The release artifact and the brew libexec keep the
# module under its exact SHA256SUMS name, so the name never varies.
pam_module_name=liboshioki_pam.so
[ "$(uname -s)" != Darwin ] || pam_module_name=liboshioki_pam.dylib
PAM_MODULE_BIN="${PAM_MODULE_BIN:-}"
if [ -z "$PAM_MODULE_BIN" ]; then
  for candidate in \
    "$PARENT_DIR/libexec/$pam_module_name" \
    "$SCRIPT_DIR/$pam_module_name" \
    "$PARENT_DIR/target/release/$pam_module_name"; do
    [ -f "$candidate" ] || continue
    PAM_MODULE_BIN="$candidate"
    break
  done
fi
INSTALLED_HOOK="${INSTALLED_HOOK:-/usr/local/sbin/oshioki}"
# Seconds to wait for `oshioki enroll` to print its URL. Deliberately longer
# than the hook's own transport timeouts so a reachability problem is
# reported by the hook, in its own words, rather than by this poll.
ENROLL_URL_TIMEOUT="${OSHIOKI_ENROLL_URL_TIMEOUT:-60}"
# The agent keeps its box secret in the macOS login keychain, which only a
# graphical login session has unlocked. Over ssh, or from a launchd job with
# no session, the Security framework refuses with errSecInteractionNotAllowed
# and every agent verb fails the same way: it cannot read an existing identity
# and it cannot store a new one. Without this the setup reads that as "no
# agent identity", enrols a second device nobody asked for, and only then dies
# on a Security framework string. Matched on the framework's own wording,
# which is what the agent's error chain carries up.
agent_keychain_blocked() {
  case "$1" in
    *'User interaction is not allowed'*) return 0 ;;
    *) return 1 ;;
  esac
}
die_keychain_locked() {
  die "the login keychain is not available in this session: macOS answered \"User interaction is not allowed\". The agent keeps its box secret there, so no identity can be read or created over ssh, over a remote shell, or from a job with no graphical session. Run this from a Terminal window while logged in to this Mac, or unlock the keychain first with: security unlock-keychain ~/Library/Keychains/login.keychain-db"
}
SUDO="${SUDO:-sudo}"
LAUNCHCTL="${LAUNCHCTL:-launchctl}"
SYSTEMCTL="${SYSTEMCTL:-systemctl}"
PLUTIL="${PLUTIL:-plutil}"

INSTALL_ENV="${OSHIOKI_INSTALL_ENV:-/etc/oshioki/install.env}"
AGENT_STATE="${OSHIOKI_AGENT_STATE:-$HOME/.config/oshioki}"
DEFAULT_SOCKET="$AGENT_STATE/agent.sock"
LABEL="com.oshioki.agent"
# The agent's own NATS bus and role, kept apart from NATS_URL_V/NATS_USER_V/
# NATS_PASS_V (the hook's) everywhere below. Writing the hook's credentials
# into the agent's environment authenticates it as the wrong NATS user,
# which the server answers with "Permissions Violation for Subscription"
# rather than approvals ever arriving. Empty means socket-only for the
# agent, independent of whether the hook itself talks to a NATS.
AGENT_NATS_URL_V=""
AGENT_NATS_USER_V=""
AGENT_NATS_PASS_V=""

[ -x "$INSTALLER" ] || die "installer not found: $INSTALLER (set INSTALLER)"
# Server mode needs the agent up front for pairing; local mode builds it
# just below, so its check waits until the build block ran.
if [ "$LOCAL" -eq 0 ]; then
  [ -x "$AGENT_BIN" ] || die "agent not found: $AGENT_BIN (set AGENT_BIN)"
fi
TOTAL_STEPS=5
if [ "$LOCAL" -eq 1 ]; then TOTAL_STEPS=4; fi
# Repo checkout without a prior build: compile what the installer needs and
# write the checksum manifest the installer verifies, same as the release
# lane. Brew layouts already ship all three, so this is a no-op there.
if [ "$LOCAL" -eq 1 ]; then
  repo_root="$PARENT_DIR"
  if [ -f "$repo_root/Cargo.toml" ]; then
    release="$repo_root/target/release"
    if [ ! -x "$release/oshioki" ] || [ ! -x "$release/oshioki-agent" ]; then
      command -v cargo >/dev/null 2>&1 || die "cargo not found; install Rust or set AGENT_BIN"
      info "building release artifacts (one time)"
      ( cd "$repo_root" && cargo build --release -p oshioki-hook -p oshioki-plugin -p oshioki-agent )
    fi
    plugin="$release/liboshioki_plugin.dylib"
    [ "$(uname -s)" = Darwin ] || plugin="$release/liboshioki_plugin.so"
    if [ -f "$release/oshioki" ] && [ -f "$plugin" ]; then
      if command -v sha256sum >/dev/null 2>&1; then
        ( cd "$release" && sha256sum oshioki "$(basename "$plugin")" > SHA256SUMS )
      else
        ( cd "$release" && shasum -a 256 oshioki "$(basename "$plugin")" > SHA256SUMS )
      fi
    fi
    [ -x "$AGENT_BIN" ] || AGENT_BIN="$release/oshioki-agent"
    [ -x "$AGENT_BIN" ] || die "agent not found after build: $AGENT_BIN"
    # A bare binary makes the Touch ID sheet show a file name and the
    # generic executable badge. The bundle makes it show the Oshioki
    # name with the logo; every later step (identity, plist) uses
    # AGENT_BIN, so switching it here switches all of them. An
    # explicitly chosen agent binary is left alone.
    if [ -z "$AGENT_BIN_EXPLICIT" ] && [ "$(uname -s)" = Darwin ] \
      && [ -x "$repo_root/scripts/mac/bundle-agent" ]; then
      if [ -n "${OSHIOKI_SIGN_IDENTITY:-}" ]; then
        bundle_bin="$("$repo_root/scripts/mac/bundle-agent" --sign "$OSHIOKI_SIGN_IDENTITY")"
      else
        bundle_bin="$("$repo_root/scripts/mac/bundle-agent")"
      fi
      [ -x "$bundle_bin" ] || die "app bundle has no agent binary: $bundle_bin"
      AGENT_BIN="$bundle_bin"
    fi
  fi
fi

prompt() {
  local label="$1" def="$2" var="$3" secret="$4" value
  if [ "$YES" -eq 1 ]; then
    [ -n "$def" ] || die "$label has no default; set it in the environment or re-run without --yes"
    printf -v "$var" '%s' "$def"
    return 0
  fi
  if [ ! -t 0 ]; then
    [ -n "$def" ] || die "$label has no default and stdin is not a terminal"
    printf -v "$var" '%s' "$def"
    return 0
  fi
  if [ "$secret" -eq 1 ]; then
    printf '%s: ' "$label" >&2
    IFS= read -r -s value || true
    echo >&2
    [ -n "$value" ] || value="$def"
  elif [ -n "$def" ]; then
    printf '%s [%s]: ' "$label" "$def" >&2
    IFS= read -r value || true
    [ -n "$value" ] || value="$def"
  else
    printf '%s: ' "$label" >&2
    IFS= read -r value || true
  fi
  [ -n "$value" ] || die "$label is required"
  printf -v "$var" '%s' "$value"
}

# Read one key out of install.env without sourcing it.
env_key() {
  $SUDO cat "$INSTALL_ENV" 2>/dev/null | awk -F= -v key="$1" '$1 == key { print substr($0, length($1) + 2); exit }'
}

# Does install.env exist? Ask the same way env_key() reads it. /etc/oshioki is
# root-owned 0700 and install.env inside it 0600, so a bare `[ -f ]` run as
# the laptop user answers "missing" for a file that is there (issue #88): the
# run then takes the write branch and overwrites a good config, or dies
# prompting for values it already has. Root and an empty $SUDO test directly;
# there is no privilege to borrow then.
install_env_exists() {
  if [ "$(id -u)" -eq 0 ] || [ -z "${SUDO:-}" ]; then
    [ -f "$INSTALL_ENV" ]
  else
    $SUDO test -f "$INSTALL_ENV"
  fi
}

# Parse the privileged phase's value block into the config globals.
read_markers() {
  local block line key value
  block="$(printf '%s\n' "$1" | sed -n '/^OSHIOKI_SETUP_VALUES_BEGIN$/,/^OSHIOKI_SETUP_VALUES_END$/p')"
  [ -n "$block" ] || die "privileged phase reported no configuration"
  ORIGIN=""; RP_ID=""; NATS_URL_V=""; NATS_USER_V=""; NATS_PASS_V=""; AGENT_SOCKET_V=""
  while IFS= read -r line; do
    case "$line" in
      OSHIOKI_SETUP_VALUES_BEGIN|OSHIOKI_SETUP_VALUES_END) continue ;;
      *=*) ;;
      *) continue ;;
    esac
    key="${line%%=*}"; value="${line#*=}"
    case "$key" in
      OSHIOKI_ORIGIN) ORIGIN="$value" ;;
      OSHIOKI_RP_ID) RP_ID="$value" ;;
      NATS_URL) NATS_URL_V="$value" ;;
      NATS_USER) NATS_USER_V="$value" ;;
      NATS_PASS) NATS_PASS_V="$value" ;;
      OSHIOKI_AGENT_SOCKET) AGENT_SOCKET_V="$value" ;;
      OSHIOKI_REUSED) ;;
      *) die "unknown value from privileged phase: $key" ;;
    esac
  done <<<"$block"
}

check_config() {
  [ -n "$ORIGIN" ] || die "$INSTALL_ENV has no OSHIOKI_ORIGIN"
  [ -n "$AGENT_SOCKET_V" ] || AGENT_SOCKET_V="$DEFAULT_SOCKET"
  # The agent's own bus, checked independently of the hook's below: an
  # install.env from before this field existed carries neither, which is
  # the valid socket-only shape, not an error.
  if [ -z "$AGENT_NATS_URL_V" ]; then
    if [ -n "$AGENT_NATS_USER_V" ] || [ -n "$AGENT_NATS_PASS_V" ]; then
      die "$INSTALL_ENV has agent NATS credentials without OSHIOKI_AGENT_NATS_URL; remove them or set a URL"
    fi
  else
    case "$AGENT_NATS_URL_V" in
      [Tt][Ll][Ss]://*|[Nn][Aa][Tt][Ss]://localhost*|[Nn][Aa][Tt][Ss]://127.*|[Nn][Aa][Tt][Ss]://\[::1\]*|[Nn][Aa][Tt][Ss]://:*) ;;
      [Nn][Aa][Tt][Ss]://*) info "warning: OSHIOKI_AGENT_NATS_URL is plaintext to a non-loopback host; add OSHIOKI_ALLOW_PLAINTEXT_NATS=1 to $INSTALL_ENV (testing only) or switch to tls:// (see README.md)" ;;
    esac
  fi
  if [ -z "$NATS_URL_V" ]; then
    # Socket-only: credentials without a server describe a NATS that
    # cannot exist, so they fail here rather than at the first sudo.
    if [ -n "$NATS_USER_V" ] || [ -n "$NATS_PASS_V" ]; then
      die "$INSTALL_ENV has NATS credentials without NATS_URL; remove them or set a URL"
    fi
    return 0
  fi
  # The hook and agent refuse plaintext NATS past loopback at runtime; say so
  # now rather than failing the first sudo afterwards. Production uses tls://.
  case "$NATS_URL_V" in
    [Tt][Ll][Ss]://*|[Nn][Aa][Tt][Ss]://localhost*|[Nn][Aa][Tt][Ss]://127.*|[Nn][Aa][Tt][Ss]://\[::1\]*|[Nn][Aa][Tt][Ss]://:*) ;;
    [Nn][Aa][Tt][Ss]://*) info "warning: NATS_URL is plaintext to a non-loopback host; add OSHIOKI_ALLOW_PLAINTEXT_NATS=1 to $INSTALL_ENV (testing only) or switch to tls:// (see README.md)" ;;
  esac
}

run_installer() {
  # A bare `$SUDO` prefix breaks on the stock macOS bash 3.2 when SUDO is
  # empty (it tries to run the first VAR= as a command), so the unprivileged
  # call spells its environment out instead of prefixing nothing.
  if [ -n "${SUDO:-}" ]; then
    $SUDO HOOK_BIN="$HOOK_BIN" PLUGIN_BIN="$PLUGIN_BIN" OSHIOKI_CHECKSUMS="$OSHIOKI_CHECKSUMS" \
      PAM_MODULE_BIN="$PAM_MODULE_BIN" \
      OSHIOKI_SUDO_USER="${OSHIOKI_SUDO_USER:-$LAPTOP_USER}" \
      "$INSTALLER" "$@" --config-file "$INSTALL_ENV"
  else
    HOOK_BIN="$HOOK_BIN" PLUGIN_BIN="$PLUGIN_BIN" OSHIOKI_CHECKSUMS="$OSHIOKI_CHECKSUMS" \
      PAM_MODULE_BIN="$PAM_MODULE_BIN" \
      OSHIOKI_SUDO_USER="${OSHIOKI_SUDO_USER:-$LAPTOP_USER}" \
      "$INSTALLER" "$@" --config-file "$INSTALL_ENV"
  fi
}

# True when a unix socket at $1 accepts a connection. The socket file
# outlives its listener across agent restarts, so presence proves nothing.
socket_live() {
  python3 -c 'import socket,sys;s=socket.socket(socket.AF_UNIX);s.settimeout(2);s.connect(sys.argv[1])' "$1" 2>/dev/null
}

# Verify a NATS server answers and the credentials open it: TCP connect,
# INFO with auth_required honored, CONNECT accepted. Status 0 means the
# hook and agent will be able to use these values; anything else prints
# the failing step. $1 url, $2 user, $3 pass.
nats_probe() {
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$1" "$2" "$3" <<'PYEOF'
import json, socket, ssl, sys
from urllib.parse import urlsplit
url, user, password = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    parts = urlsplit(url)
    host, port = parts.hostname, parts.port or 4222
except Exception:
    sys.exit("NATS probe: unparseable URL: %s" % url)
if not host:
    sys.exit("NATS probe: no host in URL: %s" % url)
if parts.scheme.lower() not in ("nats", "tls"):
    sys.exit("NATS probe: unsupported scheme in URL: %s" % url)
try:
    sock = socket.create_connection((host, port), timeout=4)
except OSError as error:
    sys.exit("NATS probe: cannot reach %s:%s: %s" % (host, port, error))
lines = b""
while b"\r\n" not in lines:
    chunk = sock.recv(4096)
    if not chunk:
        sys.exit("NATS probe: server closed the connection before INFO")
    lines += chunk
try:
    info = json.loads(lines.split(b"\r\n", 1)[0].split(None, 1)[1])
except Exception:
    sys.exit("NATS probe: unreadable server INFO")
# NATS sends INFO in the clear and upgrades to TLS afterwards, so the
# handshake comes after that first line, on a tls:// URL or when the server
# says it requires TLS. A server that demands TLS on a nats:// URL would
# also fail at the hook, so say so here.
if info.get("tls_required") and parts.scheme.lower() != "tls":
    sys.exit("NATS probe: server requires TLS; use a tls:// URL")
if parts.scheme.lower() == "tls":
    try:
        sock = ssl.create_default_context().wrap_socket(sock, server_hostname=host)
    except (ssl.SSLError, OSError) as error:
        sys.exit("NATS probe: TLS to %s:%s failed: %s" % (host, port, error))
if info.get("nonce"):
    sys.exit("NATS probe: server wants NKey auth, which setup does not configure")
required = info.get("auth_required", False)
if required and (not user or not password):
    sys.exit("NATS probe: server requires credentials and none were given")
if (user or password) and not (user and password):
    sys.exit("NATS probe: NATS user and password must be set together")
hello = {"verbose": False, "pedantic": False}
if user and password:
    # The protocol field is `pass`, not `password`: a wrong name fails
    # authentication the same way a wrong secret does, with no hint.
    hello.update(user=user, **{"pass": password})
sock.sendall(("CONNECT %s\r\nPING\r\n" % json.dumps(hello)).encode())
# Bytes buffered after INFO are pre-handshake plaintext on a TLS connection:
# the SSLSocket has its own stream, so carrying them across the upgrade would
# feed plaintext to the post-upgrade parse. Only the cleartext path keeps them.
if parts.scheme.lower() == "tls":
    rest = b""
else:
    rest = lines.split(b"\r\n", 1)[1]
while rest.count(b"\r\n") < 1:
    chunk = sock.recv(4096)
    if not chunk:
        sys.exit("NATS probe: server closed the connection during CONNECT")
    rest += chunk
reply = rest.split(b"\r\n", 1)[0].decode("utf-8", "replace")
if reply.startswith("-ERR"):
    sys.exit("NATS probe: server rejected the connection: %s" % reply)
if reply != "PONG":
    sys.exit("NATS probe: unexpected server reply: %s" % reply)
PYEOF
    return "$?"
  fi
  # No python3: reachability only, which cannot verify credentials. Say so
  # rather than writing values that fail at the first sudo.
  nats_probe_reachable "$1" || return 1
  if [ -n "$2" ] || [ -n "$3" ]; then
    info "warning: $1 is reachable but credentials were not verified (no python3); a wrong user or password fails at the first sudo"
  fi
  return 0
}

# True when $1 (a NATS URL) accepts TCP. Scheme, userinfo, path, and
# brackets are stripped; only reachability is tested.
tcp_reachable() {
  local pid i
  ( exec 3<>"/dev/tcp/$1/$2" ) 2>/dev/null &
  pid=$!
  for i in 1 2 3 4; do
    kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
    sleep 0.5
  done
  kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
  return 1
}
nats_probe_reachable() {
  local rest hostport host port
  rest="${1#*://}"; rest="${rest%%/*}"; rest="${rest%%\?*}"
  hostport="${rest##*@}"
  case "$hostport" in
    \[*\]*) host="$(printf '%s' "$hostport" | sed 's/^\[//; s/\].*//')"
      port="$(printf '%s' "$hostport" | sed 's/^[^]]*\]//; s/^://')" ;;
    *) host="${hostport%%:*}"; port="${hostport##*:}" ;;
  esac
  [ -n "$host" ] || { echo "NATS probe: no host in URL: $1" >&2; return 1; }
  # A bare host carries itself as the "port" (no colon to split on), and a
  # bracketed IPv6 host with no port yields an empty one; both mean 4222.
  if [ -z "$port" ] || [ "$host" = "$port" ]; then port=4222; fi
  if ! command -v nc >/dev/null 2>&1; then
    # No nc either: bash opens the TCP connection itself, bounded by hand
    # because stock macOS has no timeout(1).
    tcp_reachable "$host" "$port"
  elif [ "$(uname -s)" = Darwin ]; then
    nc -z -G 2 "$host" "$port" 2>/dev/null
  else
    nc -z -w 2 "$host" "$port" 2>/dev/null
  fi || { echo "NATS probe: cannot reach $host:$port" >&2; return 1; }
}

# The single privileged step of --local, run once under sudo by the outer
# flow. Writes install.env from the values file (or reuses it), shows the
# installer's dry-run plan, asks once, then installs, pins, enables, and
# verifies. Prints only the effective configuration on stdout, between
# markers, for the outer run to parse; everything else goes to stderr.
# Already root here, so the installer and hook run directly: no nested sudo,
# no further approvals.
privileged_phase_local() {
  [ "$LOCAL" -eq 1 ] || die "the privileged phase supports --local only"
  [ "$(id -u)" -eq 0 ] || echo "oshioki-laptop-setup: warning: privileged phase running unprivileged; writes will fail" >&2
  [ -n "$VALUES_FILE" ] && [ -f "$VALUES_FILE" ] || die "--values-file is required"
  [ -x "$INSTALLER" ] || die "installer not found: $INSTALLER"
  [ -n "${OSHIOKI_RECORD:-}" ] && [ -f "$OSHIOKI_RECORD" ] || die "device record is required (set OSHIOKI_RECORD)"
  local line key value
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    case "$line" in *=*) ;; *) die "invalid values line" ;; esac
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
      OSHIOKI_ORIGIN) PHASE_ORIGIN="$value" ;;
      OSHIOKI_RP_ID) PHASE_RP_ID="$value" ;;
      NATS_URL) PHASE_NATS_URL="$value" ;;
      NATS_USER) PHASE_NATS_USER="$value" ;;
      NATS_PASS) PHASE_NATS_PASS="$value" ;;
      OSHIOKI_AGENT_SOCKET) PHASE_AGENT_SOCKET="$value" ;;
      *) die "unknown values key: $key" ;;
    esac
  done < "$VALUES_FILE"
  rm -f "$VALUES_FILE"
  [ -n "${PHASE_ORIGIN:-}" ] || die "values file has no OSHIOKI_ORIGIN"
  # No NATS keys in the values means socket-only: the outer flow probes a
  # staged NATS before writing it here, so whatever arrives verified stays,
  # and whatever is absent is omitted rather than placeholdered.
  if [ -f "$INSTALL_ENV" ] && [ "$RECONFIGURE" -eq 0 ]; then
    # Reuse keeps the existing file byte-for-byte, so the reported values
    # must be what is actually installed. A stale file whose transports no
    # longer match what this run staged — notably the old unprobed
    # placeholders — refuses instead of silently reinstating them: the
    # installer would write them into config.env while the agent side went
    # socket-only. Values are plain KEY=VALUE lines; sed reads them rather
    # than sourcing, so hostile content cannot execute.
    reused_key() { sed -n "s/^$1=//p" "$INSTALL_ENV" | head -1; }
    if [ "$(reused_key NATS_URL)" != "${PHASE_NATS_URL:-}" ] \
      || [ "$(reused_key NATS_USER)" != "${PHASE_NATS_USER:-}" ] \
      || [ "$(reused_key NATS_PASS)" != "${PHASE_NATS_PASS:-}" ] \
      || [ "$(reused_key OSHIOKI_AGENT_SOCKET)" != "${PHASE_AGENT_SOCKET:-$DEFAULT_SOCKET}" ]; then
      die "existing $INSTALL_ENV names different transports than this run staged (stale NATS placeholders?); re-run with --reconfigure to rewrite it"
    fi
    info "reusing existing $INSTALL_ENV (pass --reconfigure to redo it)"
    PHASE_REUSED=1
  else
    info "writing $INSTALL_ENV"
    mkdir -p "$(dirname "$INSTALL_ENV")"
    {
      printf 'OSHIOKI_ORIGIN=%s\n' "$PHASE_ORIGIN"
      printf 'OSHIOKI_RP_ID=%s\n' "${PHASE_RP_ID:-localhost}"
      if [ -n "${PHASE_NATS_URL:-}" ]; then
        printf 'NATS_URL=%s\n' "$PHASE_NATS_URL"
        printf 'NATS_USER=%s\n' "${PHASE_NATS_USER:-}"
        printf 'NATS_PASS=%s\n' "${PHASE_NATS_PASS:-}"
      fi
      printf 'OSHIOKI_AGENT_SOCKET=%s\n' "${PHASE_AGENT_SOCKET:-$DEFAULT_SOCKET}"
      printf 'OSHIOKI_LOCAL=1\n'
    } > "$INSTALL_ENV"
    chmod 0600 "$INSTALL_ENV"
    PHASE_REUSED=0
  fi
  SUDO="" run_installer --prelaunch --dry-run >&2
  if [ "$YES" -eq 0 ]; then
    printf 'Apply the plan above? [y/N]: ' >&2
    IFS= read -r answer || true
    [ "$answer" = "y" ] || [ "$answer" = "Y" ] || die "aborted; re-run when ready"
  fi
  SUDO="" run_installer --prelaunch >&2
  [ -x "$INSTALLED_HOOK" ] || die "installed hook not found: $INSTALLED_HOOK (set INSTALLED_HOOK)"
  # The outer run exported the record and answers the confirmation itself,
  # so pinning never types the fingerprint.
  printf '%s\n' "${OSHIOKI_FINGERPRINT:-}" | "$INSTALLED_HOOK" pin-record "$OSHIOKI_RECORD" >&2
  rm -f "$OSHIOKI_RECORD"
  info "device paired locally"
  if ! SUDO="" run_installer --prelaunch-status >&2; then
    info "enabling the sudo plugin now that a device is active"
    SUDO="" run_installer --prelaunch >&2
  fi
  SUDO="" run_installer --prelaunch-status >&2 || die "plugin is not enabled after install"
  printf '%s\n' 'OSHIOKI_SETUP_VALUES_BEGIN'
  printf 'OSHIOKI_ORIGIN=%s\n' "$PHASE_ORIGIN"
  printf 'OSHIOKI_RP_ID=%s\n' "${PHASE_RP_ID:-localhost}"
  if [ -n "${PHASE_NATS_URL:-}" ]; then
    printf 'NATS_URL=%s\n' "$PHASE_NATS_URL"
    printf 'NATS_USER=%s\n' "${PHASE_NATS_USER:-}"
    printf 'NATS_PASS=%s\n' "${PHASE_NATS_PASS:-}"
  fi
  printf 'OSHIOKI_AGENT_SOCKET=%s\n' "${PHASE_AGENT_SOCKET:-$DEFAULT_SOCKET}"
  printf 'OSHIOKI_REUSED=%s\n' "$PHASE_REUSED"
  printf '%s\n' 'OSHIOKI_SETUP_VALUES_END'
}

if [ "$PRIVILEGED" -eq 1 ]; then
  privileged_phase_local
  exit "$?"
fi

if [ "$LOCAL" -eq 1 ]; then
  info "step 1/$TOTAL_STEPS: agent identity and configuration"
  [ -x "$AGENT_BIN" ] || die "agent not found: $AGENT_BIN (set AGENT_BIN)"
  mkdir -p "$AGENT_STATE"
  local_show_out="$("$AGENT_BIN" show 2>&1)" && local_show_ok=1 || local_show_ok=0
  if [ "$local_show_ok" -eq 0 ] && agent_keychain_blocked "$local_show_out"; then
    die_keychain_locked
  fi
  if [ "$local_show_ok" -eq 0 ]; then
    info "no agent identity; creating one (no server involved)"
    "$AGENT_BIN" init
  else
    info "agent identity present"
  fi
  # Exported here, pinned by the privileged phase: the record crosses the
  # boundary as a file, never as arguments.
  record="$(mktemp "${TMPDIR:-/tmp}/oshioki-record.XXXXXX")"
  "$AGENT_BIN" device-record --label "$(hostname -s 2>/dev/null || hostname)" > "$record"
  fingerprint="$(grep '"fingerprint":' "$record" | sed -e 's/^[^:]*:[[:space:]]*"//' -e 's/".*$//' || true)"
  [ -n "$fingerprint" ] || { rm -f "$record"; die "device record has no fingerprint"; }
  info "pinning device $fingerprint"
  # NATS is opt-in: any staged NATS_* value means a server exists to
  # verify, and it is probed before anything is written. Otherwise the
  # install is socket-only and no NATS keys are staged anywhere, neither
  # here nor by the privileged phase: a config must never claim a
  # transport that was not verified live.
  if [ -n "${NATS_URL+set}" ] || [ -n "${NATS_USER+set}" ] || [ -n "${NATS_PASS+set}" ]; then
    NATS_URL="${NATS_URL:-nats://127.0.0.1:4222}"
    NATS_USER="${NATS_USER:-}"
    NATS_PASS="${NATS_PASS:-}"
    nats_probe "$NATS_URL" "$NATS_USER" "$NATS_PASS" \
      || die "NATS verification failed; fix the server or unset NATS_URL/NATS_USER/NATS_PASS for a socket-only install"
    info "NATS verified at $NATS_URL"
  else
    NATS_URL=""; NATS_USER=""; NATS_PASS=""
    info "socket-only install: no NATS values staged, so none will be written"
  fi
  # The agent's own NATS role, staged independently of the hook's above and
  # never persisted into install.env for --local (there is no per-role
  # provisioning for the local pairing lane, so this is re-supplied on the
  # environment each run). Left unset, the agent goes socket-only, same as
  # the hook; it never inherits NATS_USER/NATS_PASS above, which name the
  # hook's own role.
  if [ -n "${OSHIOKI_AGENT_NATS_URL:-}" ] || [ -n "${OSHIOKI_AGENT_NATS_USER:-}" ] || [ -n "${OSHIOKI_AGENT_NATS_PASS:-}" ]; then
    AGENT_NATS_URL_V="${OSHIOKI_AGENT_NATS_URL:-$NATS_URL}"
    AGENT_NATS_USER_V="${OSHIOKI_AGENT_NATS_USER:-}"
    AGENT_NATS_PASS_V="${OSHIOKI_AGENT_NATS_PASS:-}"
    [ -n "$AGENT_NATS_URL_V" ] || die "OSHIOKI_AGENT_NATS_URL is required when agent NATS credentials are staged (no hook NATS_URL to fall back on)"
    nats_probe "$AGENT_NATS_URL_V" "$AGENT_NATS_USER_V" "$AGENT_NATS_PASS_V" \
      || die "agent NATS verification failed; fix OSHIOKI_AGENT_NATS_URL/USER/PASS or unset them for a socket-only agent"
    info "agent NATS verified at $AGENT_NATS_URL_V"
  fi
  # Staged for the privileged phase, which writes install.env itself (or
  # reuses it) and reports the effective values back.
  values="$(mktemp "${TMPDIR:-/tmp}/oshioki-values.XXXXXX")"
  {
    printf 'OSHIOKI_ORIGIN=%s\n' "${OSHIOKI_ORIGIN:-https://localhost}"
    printf 'OSHIOKI_RP_ID=%s\n' "${OSHIOKI_RP_ID:-localhost}"
    if [ -n "$NATS_URL" ]; then
      printf 'NATS_URL=%s\n' "$NATS_URL"
      printf 'NATS_USER=%s\n' "$NATS_USER"
      printf 'NATS_PASS=%s\n' "$NATS_PASS"
    fi
    printf 'OSHIOKI_AGENT_SOCKET=%s\n' "${OSHIOKI_AGENT_SOCKET:-$DEFAULT_SOCKET}"
  } > "$values"
  chmod 0600 "$values"
fi
if [ "$LOCAL" -eq 0 ]; then
info "step 1/$TOTAL_STEPS: installer configuration in $INSTALL_ENV"
$SUDO mkdir -p "$(dirname "$INSTALL_ENV")"
if ! install_env_exists || [ "$RECONFIGURE" -eq 1 ]; then
  prompt "WebAuthn origin" "${OSHIOKI_ORIGIN:-}" ORIGIN 0
  prompt "WebAuthn RP ID" "${OSHIOKI_RP_ID:-}" RP_ID 0
  prompt "NATS URL" "${NATS_URL:-nats://127.0.0.1:4222}" NATS_URL_V 0
  prompt "NATS user" "${NATS_USER:-oshioki}" NATS_USER_V 0
  prompt "NATS password" "${NATS_PASS:-}" NATS_PASS_V 1
  prompt "Agent socket" "${OSHIOKI_AGENT_SOCKET:-$DEFAULT_SOCKET}" AGENT_SOCKET_V 0
  # The Mac agent's own NATS role -- deliberately asked separately from the
  # hook's above. Reusing the hook's NATS_USER/NATS_PASS here is the bug
  # this guards against: the agent then authenticates as the hook's role,
  # which the server answers with a permissions violation on every
  # subscribe instead of ever delivering an approval. Defaults to the same
  # bus as the hook (the common case) but every field is independently
  # overridable, since a laptop can run a local hook-side NATS (e.g. a
  # phone-bridge broker) while the agent talks to a different, real bus.
  prompt "Agent NATS URL" "${OSHIOKI_AGENT_NATS_URL:-$NATS_URL_V}" AGENT_NATS_URL_V 0
  prompt "Agent NATS user" "${OSHIOKI_AGENT_NATS_USER:-oshioki-agent}" AGENT_NATS_USER_V 0
  prompt "Agent NATS password" "${OSHIOKI_AGENT_NATS_PASS:-}" AGENT_NATS_PASS_V 1
  {
    printf 'OSHIOKI_ORIGIN=%s\n' "$ORIGIN"
    printf 'OSHIOKI_RP_ID=%s\n' "$RP_ID"
    printf 'NATS_URL=%s\n' "$NATS_URL_V"
    printf 'NATS_USER=%s\n' "$NATS_USER_V"
    printf 'NATS_PASS=%s\n' "$NATS_PASS_V"
    printf 'OSHIOKI_AGENT_SOCKET=%s\n' "$AGENT_SOCKET_V"
    printf 'OSHIOKI_AGENT_NATS_URL=%s\n' "$AGENT_NATS_URL_V"
    printf 'OSHIOKI_AGENT_NATS_USER=%s\n' "$AGENT_NATS_USER_V"
    printf 'OSHIOKI_AGENT_NATS_PASS=%s\n' "$AGENT_NATS_PASS_V"
  } | $SUDO tee "$INSTALL_ENV" >/dev/null
  $SUDO chmod 0600 "$INSTALL_ENV"
else
  info "reusing existing $INSTALL_ENV (pass --reconfigure to redo it)"
fi
fi
if [ "$LOCAL" -eq 0 ]; then
ORIGIN="$(env_key OSHIOKI_ORIGIN)"
NATS_URL_V="$(env_key NATS_URL)"
NATS_USER_V="$(env_key NATS_USER)"
NATS_PASS_V="$(env_key NATS_PASS)"
AGENT_SOCKET_V="$(env_key OSHIOKI_AGENT_SOCKET)"
AGENT_NATS_URL_V="$(env_key OSHIOKI_AGENT_NATS_URL)"
AGENT_NATS_USER_V="$(env_key OSHIOKI_AGENT_NATS_USER)"
AGENT_NATS_PASS_V="$(env_key OSHIOKI_AGENT_NATS_PASS)"
check_config
# Server installs name a NATS, so verify it before any elevation: a dead
# or miscredentialed server must fail here, not at the first sudo. An
# empty URL is the socket-only shape check_config accepts; there is
# nothing to probe then.
if [ -n "$NATS_URL_V" ]; then
  nats_probe "$NATS_URL_V" "$NATS_USER_V" "$NATS_PASS_V" \
    || die "NATS verification failed for $NATS_URL_V"
  info "NATS verified at $NATS_URL_V"
fi
# The agent's own bus and role: verified independently of the hook's above,
# and may be empty on an install.env written before this field existed --
# that leaves the agent socket-only here (never the hook's NATS_USER/PASS),
# and the plist-preservation in the autostart step is what protects an
# already-correctly-configured agent from losing its real credentials.
if [ -n "$AGENT_NATS_URL_V" ]; then
  nats_probe "$AGENT_NATS_URL_V" "$AGENT_NATS_USER_V" "$AGENT_NATS_PASS_V" \
    || die "agent NATS verification failed for $AGENT_NATS_URL_V"
  info "agent NATS verified at $AGENT_NATS_URL_V"
fi
fi

if [ "$LOCAL" -eq 1 ]; then
  info "step 2/$TOTAL_STEPS: privileged install (one approval)"
  # Everything privileged happens in this one sudo: config, install, pin,
  # enable. Flags forward; the empty expansion vanishes.
  phase_flags=""
  if [ "$YES" -eq 1 ]; then phase_flags="--yes"; fi
  if [ "$RECONFIGURE" -eq 1 ]; then phase_flags="$phase_flags --reconfigure"; fi
  # phase_flags intentionally splits on word boundaries.
  # shellcheck disable=SC2086
  phase_out="$($SUDO HOOK_BIN="$HOOK_BIN" PLUGIN_BIN="$PLUGIN_BIN" OSHIOKI_CHECKSUMS="$OSHIOKI_CHECKSUMS" \
    OSHIOKI_SUDO_USER="$LAPTOP_USER" OSHIOKI_INSTALL_ENV="$INSTALL_ENV" \
    INSTALLER="$INSTALLER" INSTALLED_HOOK="$INSTALLED_HOOK" OSHIOKI_RECORD="$record" \
    OSHIOKI_FINGERPRINT="$fingerprint" \
    "$SCRIPT_PATH" --privileged-phase --local --values-file "$values" $phase_flags)"
  rm -f "$values" "$record"
  read_markers "$phase_out"
  check_config
else
info "step 2/$TOTAL_STEPS: prelaunch install"
run_installer --prelaunch --dry-run
if [ "$YES" -eq 0 ]; then
  printf 'Apply the plan above? [y/N]: ' >&2
  IFS= read -r answer || true
  [ "$answer" = "y" ] || [ "$answer" = "Y" ] || die "aborted; re-run when ready"
fi
run_installer --prelaunch
fi

if [ "$LOCAL" -eq 0 ]; then
info "step 3/$TOTAL_STEPS: agent identity"
[ -x "$INSTALLED_HOOK" ] || die "installed hook not found: $INSTALLED_HOOK (set INSTALLED_HOOK)"
mkdir -p "$AGENT_STATE"
cleanup_enroll() {
  if [ -n "${enroll_pid:-}" ]; then kill "$enroll_pid" 2>/dev/null || true; fi
}
trap cleanup_enroll EXIT
agent_show_out="$("$AGENT_BIN" show 2>&1)" && agent_show_ok=1 || agent_show_ok=0
if [ "$agent_show_ok" -eq 0 ] && agent_keychain_blocked "$agent_show_out"; then
  die_keychain_locked
fi
if [ "$agent_show_ok" -eq 0 ]; then
  info "no agent identity; enrolling a new device (needs the server reachable)"
  $SUDO -v
  enroll_log="$(mktemp -t oshioki-enroll.XXXXXX)"
  $SUDO "$INSTALLED_HOOK" enroll >"$enroll_log" 2>&1 &
  enroll_pid=$!
  url=""
  enroll_live=1
  for _ in $(seq 1 "$ENROLL_URL_TIMEOUT"); do
    url="$(grep -oE 'https?://[^[:space:]'\'']+' "$enroll_log" 2>/dev/null | head -1 || true)"
    [ -n "$url" ] && break
    kill -0 "$enroll_pid" 2>/dev/null || { enroll_live=0; break; }
    sleep 1
  done
  # The process can exit between the grep and the liveness check with the
  # URL already written: read the log once more before giving up.
  [ -n "$url" ] || url="$(grep -oE 'https?://[^[:space:]'\'']+' "$enroll_log" 2>/dev/null | head -1 || true)"
  if [ -z "$url" ]; then
    cat "$enroll_log" >&2
    rm -f "$enroll_log"
    # Which of the two failures this was decides what the operator does
    # next, so say it. A hook that exited printed its own reason above; a
    # hook still running after the poll window is stuck on something that
    # never answered, and the hook's own transport timeouts are shorter than
    # this window precisely so the first case is the usual one.
    if [ "$enroll_live" -eq 1 ]; then
      die "enrollment produced no URL: $INSTALLED_HOOK enroll was still running after ${ENROLL_URL_TIMEOUT}s with nothing to show; check that the enrollment server and NATS are running and reachable from this host"
    fi
    die "enrollment produced no URL: $INSTALLED_HOOK enroll exited without printing one (its output is above)"
  fi
  pair_out="$(NATS_URL="$NATS_URL_V" NATS_USER="$NATS_USER_V" NATS_PASS="$NATS_PASS_V" \
    "$AGENT_BIN" pair "$url" --label "$(hostname -s 2>/dev/null || hostname)" 2>&1)" &&
    pair_ok=1 || pair_ok=0
  printf '%s\n' "$pair_out"
  if [ "$pair_ok" -eq 0 ]; then
    agent_keychain_blocked "$pair_out" && die_keychain_locked
    die "pairing failed"
  fi
  wait "$enroll_pid" || { cat "$enroll_log" >&2; rm -f "$enroll_log"; die "enrollment failed"; }
  rm -f "$enroll_log"
  enroll_pid=""
  info "device paired"
else
  info "agent identity present"
fi
if $SUDO "$INSTALLED_HOOK" status 2>/dev/null | grep -q 'active=true'; then
  info "host has active devices"
else
  info "host has no active devices yet; pair a device to approve requests"
fi
fi
# Server mode pairs after installing, so enabling may still be pending; the
# privileged phase already did this strictly for local mode. This is a
# no-op when the block is already there.
if [ "$LOCAL" -eq 0 ]; then
if ! run_installer --prelaunch-status >/dev/null 2>&1; then
  info "enabling the sudo plugin now that a device is active"
  run_installer --prelaunch
fi
fi

if [ "$LOCAL" -eq 1 ]; then AUTOSTART_STEP=3; VERIFY_STEP=4; else AUTOSTART_STEP=4; VERIFY_STEP=5; fi

info "step $AUTOSTART_STEP/$TOTAL_STEPS: agent autostart"
case "$(uname -s)" in
  Darwin)
    plist_dir="${LAUNCHAGENTS_DIR:-$HOME/Library/LaunchAgents}"
    mkdir -p "$plist_dir"
    plist="$plist_dir/$LABEL.plist"
    xml_escape() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }
    json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
    # An existing plist that already names a NATS_URL or NATS_USER is either
    # a prior correct run of this same script or a hand-maintained one; both
    # are the operator's real, working configuration for this device's own
    # role. Leave the file otherwise untouched and refresh only
    # ProgramArguments (the agent binary, which moves on every brew upgrade).
    # Without this, an ordinary re-run -- brew upgrade, laptop-setup
    # re-invoked for any reason -- would silently overwrite a real device
    # credential with whatever this run staged, which may be blank, may name
    # a different bus, or may (the bug this whole block exists to prevent)
    # be the hook's own role. Only --reconfigure is allowed to replace it.
    preserving=0
    if [ -f "$plist" ] && [ "$RECONFIGURE" -eq 0 ] && grep -Eq '<key>NATS_(URL|USER)</key>' "$plist"; then
      preserving=1
      info "preserving existing NATS/agent environment in $plist (pass --reconfigure to replace it)"
    fi
    if [ "$preserving" -eq 1 ]; then
      # plutil -replace edits the file's own existing structure in place, so
      # every other key -- EnvironmentVariables, KeepAlive, RunAtLoad, the
      # log paths, anything a future version adds -- survives verbatim
      # regardless of formatting. A prior version of this code instead tried
      # to re-emit a parsed copy of EnvironmentVariables using a same-line
      # sed extraction that only matched the script's own single-line
      # output; against a normally formatted plist (hand-written, or written
      # by plutil/PlistBuddy, which put each key on its own line) the grep
      # above still matched and this still announced preserving, but the
      # extraction came back empty, so the file written carried an EMPTY
      # EnvironmentVariables dict -- silently dropping the agent's real NATS
      # credentials to socket-only.
      "$PLUTIL" -replace ProgramArguments -json "[\"$(json_escape "$AGENT_BIN")\",\"run\"]" "$plist"
    else
      {
        printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>'
        printf '%s\n' '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
        printf '%s\n' '<plist version="1.0"><dict>'
        printf '  <key>Label</key><string>%s</string>\n' "$LABEL"
        printf '  <key>ProgramArguments</key><array><string>%s</string><string>run</string></array>\n' "$(xml_escape "$AGENT_BIN")"
        printf '%s\n' '  <key>EnvironmentVariables</key><dict>'
        # Socket-only writes no NATS keys at all: the agent would otherwise
        # log an authorization failure on every start against a server that
        # was never there. The agent's OWN role goes here -- AGENT_NATS_*,
        # never NATS_URL_V/NATS_USER_V/NATS_PASS_V, which are the hook's.
        if [ -n "$AGENT_NATS_URL_V" ]; then
          printf '    <key>NATS_URL</key><string>%s</string>\n' "$(xml_escape "$AGENT_NATS_URL_V")"
          if [ -n "$AGENT_NATS_USER_V" ]; then
            printf '    <key>NATS_USER</key><string>%s</string>\n' "$(xml_escape "$AGENT_NATS_USER_V")"
            printf '    <key>NATS_PASS</key><string>%s</string>\n' "$(xml_escape "$AGENT_NATS_PASS_V")"
          fi
        fi
        printf '    <key>OSHIOKI_AGENT_SOCKET</key><string>%s</string>\n' "$(xml_escape "$AGENT_SOCKET_V")"
        printf '    <key>OSHIOKI_AGENT_STATE</key><string>%s</string>\n' "$(xml_escape "$AGENT_STATE")"
        printf '%s\n' '  </dict>'
        printf '%s\n' '  <key>RunAtLoad</key><true/>'
        printf '%s\n' '  <key>KeepAlive</key><true/>'
        printf '  <key>StandardOutPath</key><string>%s</string>\n' "$(xml_escape "$AGENT_STATE/agent.log")"
        printf '  <key>StandardErrorPath</key><string>%s</string>\n' "$(xml_escape "$AGENT_STATE/agent.log")"
        printf '%s\n' '</dict></plist>'
      } > "$plist"
    fi
    chmod 0600 "$plist"
    # Line count taken before the restart, not the file's mtime: launchd
    # appends to the same log across restarts, and a prior run's own
    # "NATS connected" (or, worse, a prior violation) must never be read as
    # this run's result.
    agent_log="$AGENT_STATE/agent.log"
    log_start=0
    [ -f "$agent_log" ] && log_start="$(wc -l < "$agent_log" 2>/dev/null || echo 0)"
    $LAUNCHCTL bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    $LAUNCHCTL bootstrap "gui/$(id -u)" "$plist"
    # Prove the restart actually reached the bus, rather than assuming a
    # written plist and a bootstrap call mean approvals will arrive: a
    # wrong-role credential connects and is then refused per-subscription,
    # which looks identical to success until this log line is checked. Only
    # runs when this run's (or the preserved) environment names a NATS at
    # all; a socket-only agent never touches NATS and there is nothing here
    # to wait for.
    if [ "$preserving" -eq 1 ] || [ -n "$AGENT_NATS_URL_V" ]; then
      violation=0
      connected=0
      for _ in $(seq 1 "${OSHIOKI_AGENT_NATS_VERIFY_TIMEOUT:-5}"); do
        if [ -f "$agent_log" ] && tail -n "+$((log_start + 1))" "$agent_log" | grep -q 'Permissions Violation'; then
          violation=1
          break
        fi
        if [ -f "$agent_log" ] && tail -n "+$((log_start + 1))" "$agent_log" | grep -q 'NATS connected'; then
          connected=1
          break
        fi
        sleep 1
      done
      if [ "$violation" -eq 1 ]; then
        die "agent logged a NATS permissions violation right after (re)starting -- it is very likely running with the wrong role's credentials; see $agent_log"
      elif [ "$connected" -eq 1 ]; then
        info "agent connected to its NATS bus"
      else
        info "agent has not logged a NATS connection yet; check $agent_log if sudo approvals do not arrive"
      fi
    fi
    ;;
  Linux)
    # There is no autostart on Linux. The agent has no enclave here, so it
    # approves through the terminal prompt, and a service unit gives it no
    # terminal: under systemd stdin is /dev/null, the agent stops at once
    # rather than leaving every request to time out, and Restart=always
    # loops it. So write the environment the agent and hook must agree on
    # and let the user run it where the prompt can be answered.
    #
    # One env file instead of exported variables: it carries the socket and
    # state dir alongside any NATS credentials. Values are shell-quoted
    # because the agent is started by sourcing this file; the systemd unit
    # that once wanted bare EnvironmentFile syntax is gone.
    agent_env="$AGENT_STATE/agent.env"
    {
      # The agent's OWN role -- AGENT_NATS_*, never NATS_URL_V/NATS_USER_V/
      # NATS_PASS_V, which are the hook's. See the Darwin branch above.
      if [ -n "$AGENT_NATS_URL_V" ]; then
        printf 'NATS_URL=%s\n' "$(shell_quote "$AGENT_NATS_URL_V")"
        if [ -n "$AGENT_NATS_USER_V" ]; then
          printf 'NATS_USER=%s\n' "$(shell_quote "$AGENT_NATS_USER_V")"
          printf 'NATS_PASS=%s\n' "$(shell_quote "$AGENT_NATS_PASS_V")"
        fi
      fi
      printf 'OSHIOKI_AGENT_SOCKET=%s\n' "$(shell_quote "$AGENT_SOCKET_V")"
      printf 'OSHIOKI_AGENT_STATE=%s\n' "$(shell_quote "$AGENT_STATE")"
    } > "$agent_env"
    chmod 0600 "$agent_env"
    # An earlier setup installed such a unit. Leaving it enabled leaves it
    # restarting a process that bails on every start, and it would race the
    # terminal agent for the socket.
    unit="$HOME/.config/systemd/user/$LABEL.service"
    if [ -f "$unit" ]; then
      if command -v "$SYSTEMCTL" >/dev/null 2>&1; then
        $SYSTEMCTL --user disable --now "$LABEL" 2>/dev/null || true
      fi
      rm -f "$unit"
      # disable would normally clear this. Without systemctl the symlink
      # outlives the unit it points at, and a later daemon-reload reports a
      # failed unit, so drop it by hand.
      rm -f "$HOME/.config/systemd/user/default.target.wants/$LABEL.service"
      if command -v "$SYSTEMCTL" >/dev/null 2>&1; then
        $SYSTEMCTL --user daemon-reload 2>/dev/null || true
      fi
      info "removed the old systemd unit; it could never answer a prompt"
    fi
    info "run the agent on a terminal you keep open:"
    info "  set -a; . $(shell_quote "$agent_env"); set +a; $(shell_quote "$AGENT_BIN") run"
    info "every sudo prompts there; answering it is what approves the request"
    ;;
  *) die "unsupported operating system: $(uname -s)" ;;
esac

info "step $VERIFY_STEP/$TOTAL_STEPS: verify"
# Local mode verified the plugin strictly inside the privileged phase;
# server mode checks it here, after pairing.
if [ "$LOCAL" -eq 0 ]; then
  # With --contextual-pam this is not the last word: a lane host whose module
  # has gone missing fails this check, and the migration below is exactly the
  # repair for it. Report and carry on; --contextual-pam-status at the end is
  # the verdict. Without --contextual-pam the plugin lane is the whole
  # install, so a bad status is still fatal.
  if [ "$CONTEXTUAL_PAM" -eq 1 ]; then
    run_installer --prelaunch-status ||
      info "the contextual PAM migration below is what repairs this"
  else
    run_installer --prelaunch-status
  fi
fi

# The opt-in migration, last: it only makes sense once the plugin lane is
# installed, a device is paired, and the hook has been proven, which is
# exactly the state reached above. It is not part of the default flow --
# everything before this point leaves sudo on the plugin lane.
if [ "$CONTEXTUAL_PAM" -eq 1 ]; then
  [ -n "$PAM_MODULE_BIN" ] ||
    die "no $pam_module_name found next to this script (set PAM_MODULE_BIN)"
  info "contextual PAM migration requested (--contextual-pam):"
  info "  - installs $PAM_MODULE_BIN into this host's PAM security directory"
  info "  - adds one oshioki auth entry to the sudo PAM stack"
  info "  - removes the approval plugin block and the NOPASSWD sudoers rule"
  info "  - roll back with: $INSTALLER --disable-contextual-pam"
  info "  - inspect with:   $INSTALLER --contextual-pam-status"
  info "Keep a second root shell open until the status above reads all OK."
  run_installer --contextual-pam --dry-run
  if [ "$YES" -eq 0 ]; then
    printf 'Apply the PAM migration above? [y/N]: ' >&2
    IFS= read -r answer || true
    [ "$answer" = "y" ] || [ "$answer" = "Y" ] || die "aborted; sudo is unchanged on the plugin lane"
  fi
  run_installer --contextual-pam
  # Status is the verdict, not a formality: it exits non-zero unless all
  # eight lines read OK, and this is the last moment the second root shell
  # is still open.
  run_installer --contextual-pam-status ||
    info "status reported a problem above; roll back with: $INSTALLER --disable-contextual-pam"
fi
# Linux has no autostart, so a live socket only happens when the agent is
# already running on a terminal. That is the finished state, not a
# precondition: without it the install is still complete and sudo starts
# working the moment the agent does.
# Without python3 there is no way to tell a live listener from a socket file
# left behind by a crash or an earlier run, and guessing wrong sends the
# install down the macOS path to a sudo proof that cannot be answered. The
# early exit is the safe guess: it is already the common case on Linux.
if command -v python3 >/dev/null 2>&1; then
  agent_running() { socket_live "$1"; }
else
  agent_running() { false; }
fi
if [ "$(uname -s)" = Linux ] && ! agent_running "$AGENT_SOCKET_V"; then
  info "install complete. Start the agent on a terminal (above); sudo works from then on."
  exit 0
fi
# The socket file outlives its listener across agent restarts (notably the
# autostart cycle just above), so wait for a live listener, not a path.
if command -v python3 >/dev/null 2>&1; then
  for _ in $(seq 1 30); do
    socket_live "$AGENT_SOCKET_V" && break
    sleep 1
  done
  socket_live "$AGENT_SOCKET_V" || die "agent socket never answered at $AGENT_SOCKET_V; see $AGENT_STATE/agent.log"
else
  for _ in $(seq 1 15); do
    [ -S "$AGENT_SOCKET_V" ] && break
    sleep 1
  done
  [ -S "$AGENT_SOCKET_V" ] || die "agent socket never appeared at $AGENT_SOCKET_V; see $AGENT_STATE/agent.log"
fi
if [ -t 0 ]; then
  info "final proof: one real sudo (a Touch ID prompt is coming)"
  $SUDO true || die "sudo true was denied; see $AGENT_STATE/agent.log"
  info "ready: sudo approved through the agent socket."
else
  info "ready: the agent socket is live and sudo validates. Run 'sudo true'."
fi
