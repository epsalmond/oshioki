#!/usr/bin/env python3
"""Hermetic tests for scripts/oshioki-phone-setup.

No service manager, NATS daemon, Tailscale client, HTTPS endpoint, sudo, or
system configuration is used.  The tests still drive the helper's validation,
state, route, staging, and rollback paths rather than reimplementing them.
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import io
import json
import os
from pathlib import Path
import plistlib
import shlex
import subprocess
import tempfile
import unittest
from contextlib import redirect_stderr, redirect_stdout
from unittest import mock


ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "scripts" / "oshioki-phone-setup"
LOADER = importlib.machinery.SourceFileLoader("oshioki_phone_setup", str(SOURCE))
SPEC = importlib.util.spec_from_loader("oshioki_phone_setup", LOADER)
assert SPEC and SPEC.loader
phone = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(phone)


class PhoneSetupTests(unittest.TestCase):
    def setUp(self) -> None:
        self.temp = tempfile.TemporaryDirectory(prefix="oshioki-phone-setup-test-")
        self.root = Path(self.temp.name)
        self.home_patcher = mock.patch.object(phone.Path, "home", return_value=self.root / "home")
        self.home_patcher.start()
        self.state = self.root / "state"
        self.config = self.root / "etc" / "oshioki"
        self.nats_env = self.root / "nats.env"
        self.nats_env.write_text("NATS_URL=nats://127.0.0.1:4222\nNATS_USER=u\nNATS_PASS=p\n", encoding="utf-8")
        self.nats_env.chmod(0o600)

    def tearDown(self) -> None:
        self.home_patcher.stop()
        self.temp.cleanup()

    def assert_setup_error(self, function, *args, **kwargs) -> None:
        with self.assertRaises(phone.SetupError):
            function(*args, **kwargs)

    def test_rejects_loopback_http_and_malformed_nats(self) -> None:
        for value in ("http://phone.example", "https://localhost", "https://127.0.0.1", "https://phone.example/path"):
            self.assert_setup_error(phone._origin_parts, value)
        for value in ("http://nats.example:4222", "nats://nats.example:4222", "nats://u:p@127.0.0.1:4222", "nats://127.0.0.1/path"):
            self.assert_setup_error(phone._nats_parts, value)

    def test_reports_web_push_readiness_separately_from_delivery(self) -> None:
        output = io.StringIO()
        with redirect_stdout(output):
            phone._report_web_push({
                "web_push": {
                    "key_loaded": True,
                    "public_key_available": True,
                    "worker_running": True,
                }
            })
        self.assertIn("key=ready", output.getvalue())
        self.assertIn("worker=ready", output.getvalue())
        self.assertIn("delivery is not proven", output.getvalue())

    def test_external_mode_never_queries_tailscale_and_stages_real_values(self) -> None:
        sudo_calls: list[tuple[Path, Path]] = []

        def fake_sudo(staging: Path, config_dir: Path, sudo_bin: str) -> None:
            sudo_calls.append((staging, config_dir))
            staged = json.loads(staging.read_text(encoding="utf-8"))
            self.assertEqual(staged["nats_pass"], "p")

        args = phone._parser().parse_args([
            "--server-url", "https://phone.example",
            "--nats-config", str(self.nats_env),
            "--state-dir", str(self.state),
            "--config-dir", str(self.config),
        ])
        with mock.patch.object(phone, "_health_request"), mock.patch.object(phone, "_nats_probe"), mock.patch.object(phone, "_sudo_install", side_effect=fake_sudo), mock.patch.object(phone, "_tailscale_status", side_effect=AssertionError("Tailscale must not be queried")):
            phone._external_mode(args, self.config)
        self.assertEqual(len(sudo_calls), 1)
        self.assertEqual(sudo_calls[0][0].parent, self.state)
        self.assertFalse((self.state / ".config-staging.json").exists())

    def test_check_is_read_only_and_does_not_create_credentials(self) -> None:
        fake_binary = self.root / "fake"
        fake_binary.write_text("", encoding="utf-8")
        fake_binary.chmod(0o755)
        with mock.patch.object(phone.os, "geteuid", return_value=501), mock.patch.object(phone, "_binary", return_value=fake_binary), mock.patch.object(phone, "_tailscale_status", return_value=("phone.example", "https://phone.example", {"100.64.0.1"})), mock.patch.object(phone, "_serve_config", return_value={}), mock.patch.object(phone, "_check_https_listener"):
            result = phone.main(["--check", "--state-dir", str(self.state), "--config-dir", str(self.config)])
        self.assertEqual(result, 0)
        self.assertFalse(self.state.exists())
        self.assertFalse(self.config.exists())

    def test_top_level_root_invocation_stops_before_state_mutation(self) -> None:
        with mock.patch.object(phone.os, "geteuid", return_value=0), mock.patch.object(phone, "_local_mode", side_effect=AssertionError("normal setup must stop before mode selection")):
            self.assertEqual(phone.main(["--state-dir", str(self.state), "--config-dir", str(self.config)]), 1)
        self.assertFalse(self.state.exists())
        self.assertFalse(self.config.exists())

    def test_local_mode_reuses_secret_state_and_preserves_route_check(self) -> None:
        self.state.mkdir(mode=0o700)
        creds = {
            "version": 1,
            "hook_user": "oshioki-hook",
            "hook_pass": "hook-secret",
            "server_user": "oshioki-server",
            "server_pass": "server-secret",
        }
        (self.state / "credentials.json").write_text(json.dumps(creds), encoding="utf-8")
        (self.state / "credentials.json").chmod(0o600)
        fake_binary = self.root / "fake"
        fake_binary.write_text("", encoding="utf-8")
        fake_binary.chmod(0o755)
        captured: dict[str, object] = {}

        def fake_nats_config(state, credentials, port):
            captured["credentials"] = credentials.copy()
            return state / "nats.conf"

        def fake_runtime(state, **kwargs):
            captured["runtime"] = kwargs
            return {"version": 1}

        args = phone._parser().parse_args(["--state-dir", str(self.state), "--config-dir", str(self.config)])
        completed = __import__("subprocess").CompletedProcess([], 0, b"", b"")
        expected = phone._expected_serve("phone.example", 18444, 18443)
        with mock.patch.object(phone, "_binary", return_value=fake_binary), mock.patch.object(phone, "_tailscale_status", return_value=("phone.example", "https://phone.example", {"100.64.0.1"})), mock.patch.object(phone, "_serve_config", side_effect=[{}, expected]), mock.patch.object(phone, "_check_https_listener"), mock.patch.object(phone, "_run", return_value=completed), mock.patch.object(phone, "_nats_config", side_effect=fake_nats_config), mock.patch.object(phone, "_runtime", side_effect=fake_runtime), mock.patch.object(phone, "_ensure_services"), mock.patch.object(phone, "_wait_nats"), mock.patch.object(phone, "_wait_health"), mock.patch.object(phone, "_staging_file", return_value=self.state / "stage"), mock.patch.object(phone, "_sudo_install"):
            # The final staging file is mocked because this test focuses on
            # idempotent secret reuse and the local service path.
            phone._local_mode(args, self.config)
        self.assertEqual(captured["credentials"]["hook_pass"], "hook-secret")
        self.assertEqual(captured["credentials"]["server_pass"], "server-secret")
        self.assertEqual(captured["runtime"]["origin"], "https://phone.example:18444")

    def test_install_config_preserves_socket_local_and_registry(self) -> None:
        self.config.mkdir(parents=True)
        hook = self.config / "hook.json"
        hook.write_text(json.dumps({"version": 1, "origin": "https://old.example", "rp_id": "old.example", "server_base_url": "https://old.example", "future": "keep"}), encoding="utf-8")
        hook.chmod(0o600)
        config_env = self.config / "config.env"
        config_env.write_text("OSHIOKI_AGENT_SOCKET=/tmp/agent.sock\nOSHIOKI_LOCAL=1\nCUSTOM=keep\n", encoding="utf-8")
        config_env.chmod(0o600)
        install_env = self.config / "install.env"
        install_env.write_text("OSHIOKI_AGENT_SOCKET=/tmp/agent.sock\nOSHIOKI_LOCAL=1\n", encoding="utf-8")
        install_env.chmod(0o600)
        devices = self.config / "devices.json"
        devices.write_text('{"version":1,"devices":[]}', encoding="utf-8")
        devices.chmod(0o600)
        devices_before = devices.read_bytes()
        staging = self.root / "staging.json"
        staging.write_text(json.dumps({"version": 1, "origin": "https://phone.example", "rp_id": "phone.example", "nats_url": "nats://127.0.0.1:4222", "nats_user": "hook", "nats_pass": "secret"}), encoding="utf-8")
        staging.chmod(0o600)
        phone._install_config(staging, self.config)
        self.assertIn(b"OSHIOKI_AGENT_SOCKET=/tmp/agent.sock", config_env.read_bytes())
        self.assertIn(b"OSHIOKI_LOCAL=1", install_env.read_bytes())
        self.assertIn(b"CUSTOM=keep", config_env.read_bytes())
        self.assertEqual(devices_before, devices.read_bytes())
        self.assertEqual(json.loads(hook.read_text())["future"], "keep")
        self.assertEqual(json.loads(hook.read_text())["origin"], "https://phone.example")

    def test_install_config_refuses_active_browser_origin_migration(self) -> None:
        self.config.mkdir(parents=True)
        hook = self.config / "hook.json"
        hook.write_text('{"version":1,"origin":"https://old.example","rp_id":"old.example","server_base_url":"https://old.example"}', encoding="utf-8")
        hook.chmod(0o600)
        devices = self.config / "devices.json"
        devices.write_text('{"version":1,"devices":[{"kind":"webauthn","active":true}]}', encoding="utf-8")
        devices.chmod(0o600)
        staging = self.root / "staging.json"
        staging.write_text(json.dumps({"version": 1, "origin": "https://phone.example", "rp_id": "phone.example", "nats_url": "nats://127.0.0.1:4222", "nats_user": "hook", "nats_pass": "secret"}), encoding="utf-8")
        staging.chmod(0o600)
        self.assert_setup_error(phone._install_config, staging, self.config)

    def test_symlink_and_unknown_staging_are_refused(self) -> None:
        self.config.mkdir(parents=True)
        real = self.root / "real-staging.json"
        real.write_text("{}", encoding="utf-8")
        real.chmod(0o600)
        staging = self.root / "staging.json"
        staging.symlink_to(real)
        self.assert_setup_error(phone._install_config, staging, self.config)
        real.write_text(json.dumps({"version": 1, "origin": "https://phone.example", "rp_id": "phone.example", "nats_url": "nats://127.0.0.1:4222", "nats_user": "u", "nats_pass": "p", "unexpected": 1}), encoding="utf-8")
        self.assert_setup_error(phone._install_config, real, self.config)

    def test_config_write_failure_restores_original_bytes(self) -> None:
        self.config.mkdir(parents=True)
        hook = self.config / "hook.json"
        hook_before = b'{"version":1,"origin":"https://old.example"}\n'
        hook.write_bytes(hook_before)
        hook.chmod(0o600)
        staging = self.root / "staging.json"
        staging.write_text(json.dumps({"version": 1, "origin": "https://phone.example", "rp_id": "phone.example", "nats_url": "nats://127.0.0.1:4222", "nats_user": "u", "nats_pass": "p"}), encoding="utf-8")
        staging.chmod(0o600)
        original_atomic = phone._atomic_write
        calls = 0

        def fail_second(path, data, mode=0o600):
            nonlocal calls
            calls += 1
            if calls == 2:
                raise phone.SetupError("synthetic write failure")
            return original_atomic(path, data, mode)

        with mock.patch.object(phone, "_atomic_write", side_effect=fail_second):
            self.assert_setup_error(phone._install_config, staging, self.config)
        self.assertEqual(hook.read_bytes(), hook_before)
        self.assertFalse((self.config / "config.env").exists())

    def test_launchagent_reload_retries_bootstrap_without_kickstarting_old_definition(self) -> None:
        self.state.mkdir(mode=0o700)
        calls = []
        attempts = 0

        def launchctl(argv, **kwargs):
            nonlocal attempts
            calls.append(argv)
            if argv[1] == "bootstrap":
                attempts += 1
                return phone.subprocess.CompletedProcess(argv, 37 if attempts == 1 else 0, b"", b"")
            return phone.subprocess.CompletedProcess(argv, 0, b"", b"")

        with mock.patch.object(phone, "_platform", return_value="Darwin"), mock.patch.object(phone, "_run", side_effect=launchctl), mock.patch.object(phone.time, "sleep"):
            phone._ensure_services(self.state, {}, roles=("nats",))
        self.assertEqual(attempts, 2)
        self.assertEqual([call[1] for call in calls], ["bootout", "bootstrap", "bootstrap"])

    def test_service_arguments_are_parseable_and_do_not_contain_credentials(self) -> None:
        args = phone._service_args("server", self.state)
        parsed = phone._parser().parse_args(args[args.index("--run-service"):])
        self.assertTrue(parsed.run_service)
        self.assertEqual(parsed.role, "server")
        self.assertNotIn("PASS", " ".join(args))

    def test_local_nats_permissions_include_hook_request_watch(self) -> None:
        state = self.root / "state"
        state.mkdir(mode=0o700)
        credentials = {
            "hook_user": "oshioki-hook",
            "hook_pass": "hook-secret",
            "server_user": "oshioki-server",
            "server_pass": "server-secret",
        }
        config = phone._nats_config(state, credentials, 14222)
        text = config.read_text(encoding="utf-8")
        self.assertIn('"oshioki.request.>"', text)
        self.assertIn('"$JS.ACK.>"', text)

    def _user_block(self, text: str, user: str) -> str:
        # Isolate one user's stanza so assertions below check the
        # subject is granted to the *correct* role, not merely present
        # somewhere in the file. The last user in the list has no
        # trailing comma after its closing brace, so look for either.
        marker = f'user: "{user}"'
        start = text.index(marker)
        candidates = [index for index in (text.find("},", start), text.find("}\n  ]", start)) if index != -1]
        end = min(candidates)
        return text[start:end]

    def test_local_nats_permissions_grant_delivery_receipt_subjects(self) -> None:
        # Regression test for the DeliveryV1 permission gap (PR #57 added
        # oshioki.ack.<id> and oshioki.delivery.<id>; this script's
        # generated nats.conf must grant them to both roles, matching
        # transport/src/nats.rs and server/src).
        state = self.root / "state"
        state.mkdir(mode=0o700)
        credentials = {
            "hook_user": "oshioki-hook",
            "hook_pass": "hook-secret",
            "server_user": "oshioki-server",
            "server_pass": "server-secret",
        }
        config = phone._nats_config(state, credentials, 14222)
        text = config.read_text(encoding="utf-8")

        hook_block = self._user_block(text, "oshioki-hook")
        hook_subscribe_start = hook_block.index("subscribe:")
        hook_subscribe_block = hook_block[hook_subscribe_start:]
        self.assertIn('"oshioki.ack.>"', hook_subscribe_block)
        self.assertIn('"oshioki.delivery.>"', hook_subscribe_block)

        server_block = self._user_block(text, "oshioki-server")
        server_publish_start = server_block.index("publish:")
        server_subscribe_start = server_block.index("subscribe:")
        server_publish_block = server_block[server_publish_start:server_subscribe_start]
        self.assertIn('"oshioki.ack.>"', server_publish_block)
        self.assertIn('"oshioki.delivery.>"', server_publish_block)
        # The server relays a native enrollment submission back to the
        # hook waiting on its reply_subject via an outbox row
        # (server/src/db.rs) that the outbox worker publishes
        # (server/src/main.rs); that grant must stay in the server's
        # publish permissions or `sudo oshioki enroll` never completes.
        self.assertIn('"oshioki.enrollment.submission.>"', server_publish_block)

    def test_command_shims_and_script_path_remain_lexically_stable(self) -> None:
        target = self.root / "Cellar" / "tool"
        target.parent.mkdir(parents=True)
        target.write_text("#!/bin/sh\n", encoding="utf-8")
        target.chmod(0o755)
        shim = self.root / "bin" / "tool"
        shim.parent.mkdir()
        shim.symlink_to(target)
        resolved = phone._binary(str(shim), "UNUSED_BINARY_ENV", [], "tool")
        self.assertEqual(resolved, Path(os.path.abspath(shim)))

        script_target = self.root / "Cellar" / "oshioki-phone-setup"
        script_target.write_text("", encoding="utf-8")
        script_link = self.root / "bin" / "oshioki-phone-setup"
        script_link.symlink_to(script_target)
        with mock.patch.object(phone, "__file__", str(script_link)):
            self.assertEqual(phone._script_path(), Path(os.path.abspath(script_link)))

    def test_launchagent_upgrade_updates_only_a_proven_owned_plist(self) -> None:
        log = self.root / "logs" / "nats.log"
        plist = self.root / "LaunchAgents" / "nats.plist"
        state = self.root / "state"
        log.parent.mkdir(parents=True)
        plist.parent.mkdir(parents=True)
        changed = phone._plist(plist, "com.oshioki.phone-server.nats", "nats", state, log)
        self.assertTrue(changed)
        old = plistlib.loads(plist.read_bytes())
        marker = old["ProgramArguments"].index("--run-service")
        old["ProgramArguments"] = ["/old/homebrew/python3", "/old/Cellar/oshioki-phone-setup"] + old["ProgramArguments"][marker:]
        plist.write_bytes(plistlib.dumps(old, fmt=plistlib.FMT_XML))
        plist.chmod(0o600)
        self.assertTrue(phone._plist(plist, "com.oshioki.phone-server.nats", "nats", state, log))
        updated = plistlib.loads(plist.read_bytes())
        self.assertEqual(updated["ProgramArguments"], phone._service_args("nats", state))

        collision = dict(updated)
        collision["ProgramArguments"] = phone._service_args("server", state)
        plist.write_bytes(plistlib.dumps(collision, fmt=plistlib.FMT_XML))
        plist.chmod(0o600)
        self.assert_setup_error(phone._plist, plist, "com.oshioki.phone-server.nats", "nats", state, log)

    def test_systemd_upgrade_reloads_owned_unit_and_refuses_role_collision(self) -> None:
        log = self.root / "logs" / "server.log"
        unit = self.root / "systemd" / "server.service"
        state = self.root / "state"
        log.parent.mkdir(parents=True)
        unit.parent.mkdir(parents=True)
        self.assertTrue(phone._systemd_unit(unit, "Oshioki phone setup server", "server", state, log))
        old_lines = unit.read_text(encoding="utf-8").splitlines()
        old_lines = [
            "ExecStart=/old/homebrew/python3 /old/Cellar/oshioki-phone-setup --run-service --role server --state-dir " + shlex.quote(str(state))
            if line.startswith("ExecStart=") else line
            for line in old_lines
        ]
        unit.write_text("\n".join(old_lines) + "\n", encoding="utf-8")
        unit.chmod(0o600)
        self.assertTrue(phone._systemd_unit(unit, "Oshioki phone setup server", "server", state, log))
        self.assertIn("/usr/bin/env python3", unit.read_text(encoding="utf-8"))

        collision_lines = unit.read_text(encoding="utf-8").replace("--role server", "--role nats")
        unit.write_text(collision_lines, encoding="utf-8")
        unit.chmod(0o600)
        self.assert_setup_error(phone._systemd_unit, unit, "Oshioki phone setup server", "server", state, log)

    def test_linux_updated_unit_is_restarted_after_reload(self) -> None:
        state = self.root / "state"
        runtime = {"version": 1}
        calls: list[list[str]] = []
        completed = subprocess.CompletedProcess([], 0, b"", b"")
        with mock.patch.dict(os.environ, {phone.PLATFORM_ENV: "Linux"}), mock.patch.object(phone, "_run", side_effect=lambda argv, **kwargs: calls.append(argv) or completed):
            phone._ensure_services(state, runtime, roles=("server",))
        self.assertTrue(any(command[-2:] == ["--now", "oshioki-phone-server.service"] for command in calls))
        self.assertTrue(any(command[-2:] == ["restart", "oshioki-phone-server.service"] for command in calls))

    def test_nats_then_server_phases_preserve_and_then_reload_old_server_unit(self) -> None:
        state = self.root / "state"
        server_unit = self.root / "home" / ".config" / "systemd" / "user" / "oshioki-phone-server.service"
        log = state / "logs" / "server.log"
        state.mkdir(mode=0o700)
        log.parent.mkdir(parents=True)
        server_unit.parent.mkdir(parents=True)
        self.assertTrue(phone._systemd_unit(server_unit, "Oshioki phone setup server", "server", state, log))
        old_lines = server_unit.read_text(encoding="utf-8").splitlines()
        old_lines = [
            "ExecStart=/old/python3 /old/oshioki-phone-setup --run-service --role server --state-dir " + shlex.quote(str(state))
            if line.startswith("ExecStart=") else line
            for line in old_lines
        ]
        server_unit.write_text("\n".join(old_lines) + "\n", encoding="utf-8")
        server_unit.chmod(0o600)
        before = server_unit.read_bytes()
        calls: list[list[str]] = []
        completed = subprocess.CompletedProcess([], 0, b"", b"")
        with mock.patch.dict(os.environ, {phone.PLATFORM_ENV: "Linux"}), mock.patch.object(phone, "_run", side_effect=lambda argv, **kwargs: calls.append(argv) or completed):
            phone._ensure_services(state, {"version": 1}, roles=("nats",))
            self.assertEqual(before, server_unit.read_bytes())
            phone._ensure_services(state, {"version": 1}, roles=("server",))
        self.assertIn("/usr/bin/env python3", server_unit.read_text(encoding="utf-8"))
        self.assertTrue(any(command[-2:] == ["restart", "oshioki-phone-server.service"] for command in calls))

    def test_serve_collision_is_refused_before_local_state_or_service_start(self) -> None:
        fake = self.root / "tailscale"
        fake.write_text("", encoding="utf-8")
        fake.chmod(0o755)
        with mock.patch.object(phone, "_serve_config", return_value={"Web": {"other.example:443": {"Handlers": {"/": {"Proxy": "http://127.0.0.1:9999"}}}}}):
            self.assert_setup_error(phone._check_serve_route, fake, phone._expected_serve("phone.example", 443, 18443))

    def test_ss_listener_parser_covers_ipv4_ipv6_and_owners(self) -> None:
        output = b"""LISTEN 0 128 0.0.0.0:18444 0.0.0.0:* users:((\"traefik\",pid=123,fd=3))
LISTEN 0 128 [::]:18444 [::]:* users:((\"caddy\",pid=456,fd=9))
LISTEN 0 128 100.64.0.7:18444 0.0.0.0:* users:((\"tailscaled\",pid=789,fd=4))
"""
        self.assertEqual(phone._parse_ss_listeners(output), [
            ("0.0.0.0", 18444, {"traefik"}),
            ("::", 18444, {"caddy"}),
            ("100.64.0.7", 18444, {"tailscaled"}),
        ])

    def test_lsof_listener_parser_reads_field_output(self) -> None:
        output = b"p123\nctailscaled\nn100.64.0.7:18444\np456\nctraefik\nn*:18444\n"
        self.assertEqual(phone._parse_lsof_listeners(output), [
            ("100.64.0.7", 18444, {"tailscaled"}),
            ("*", 18444, {"traefik"}),
        ])

    def test_listener_inspection_fails_closed_when_missing_failed_or_malformed(self) -> None:
        with mock.patch.object(phone, "_platform", return_value="Linux"), mock.patch.object(phone.shutil, "which", return_value=None):
            self.assert_setup_error(phone._port_listeners, 18444)
        with mock.patch.object(phone, "_platform", return_value="Linux"), mock.patch.object(phone.shutil, "which", return_value="/usr/bin/ss"), mock.patch.object(phone, "_run", return_value=subprocess.CompletedProcess([], 2, b"", b"permission denied")):
            self.assert_setup_error(phone._port_listeners, 18444)
        with mock.patch.object(phone, "_platform", return_value="Linux"), mock.patch.object(phone.shutil, "which", return_value="/usr/bin/ss"), mock.patch.object(phone, "_run", return_value=subprocess.CompletedProcess([], 0, b"broken listener row\n", b"")):
            self.assert_setup_error(phone._port_listeners, 18444)

    def test_tailscale_status_requires_valid_node_addresses_for_listener_check(self) -> None:
        fake = self.root / "tailscale"
        status = {"Self": {"DNSName": "phone.example.", "Online": True, "TailscaleIPs": ["100.64.0.7", "fd7a:115c:a1e0::7"]}}
        completed = subprocess.CompletedProcess([], 0, json.dumps(status).encode(), b"")
        with mock.patch.object(phone, "_run", return_value=completed):
            self.assertEqual(phone._tailscale_status(fake), ("phone.example", "https://phone.example", {"100.64.0.7", "fd7a:115c:a1e0::7"}))
        for invalid in ({"Self": {"DNSName": "phone.example.", "Online": True}}, {"Self": {"DNSName": "phone.example.", "Online": True, "TailscaleIPs": ["not-an-ip"]}}):
            with self.subTest(invalid=invalid), mock.patch.object(phone, "_run", return_value=subprocess.CompletedProcess([], 0, json.dumps(invalid).encode(), b"")):
                self.assert_setup_error(phone._tailscale_status, fake)

    def test_darwin_listener_adapter_accepts_clean_no_match_and_parses_owners(self) -> None:
        no_match = subprocess.CompletedProcess([], 1, b"", b"")
        with mock.patch.object(phone, "_platform", return_value="Darwin"), mock.patch.object(phone.shutil, "which", return_value="/usr/sbin/lsof"), mock.patch.object(phone, "_run", return_value=no_match) as run:
            self.assertEqual(phone._port_listeners(18444), [])
        self.assertEqual(run.call_args.args[0], ["/usr/sbin/lsof", "-nP", "-iTCP:18444", "-sTCP:LISTEN", "-Fpcn"])
        found = subprocess.CompletedProcess([], 0, b"p321\nccaddy\nn[::]:18444\n", b"")
        with mock.patch.object(phone, "_platform", return_value="Darwin"), mock.patch.object(phone.shutil, "which", return_value="/usr/sbin/lsof"), mock.patch.object(phone, "_run", return_value=found):
            self.assertEqual(phone._port_listeners(18444), [("::", 18444, {"caddy"})])
        with mock.patch.object(phone, "_platform", return_value="Darwin"), mock.patch.object(phone.shutil, "which", return_value="/usr/sbin/lsof"), mock.patch.object(phone, "_run", return_value=subprocess.CompletedProcess([], 1, b"", b"permission denied")):
            self.assert_setup_error(phone._port_listeners, 18444)
        with mock.patch.object(phone, "_platform", return_value="Darwin"), mock.patch.object(phone.shutil, "which", return_value="/usr/sbin/lsof"), mock.patch.object(phone, "_run", return_value=subprocess.CompletedProcess([], 0, b"", b"")):
            self.assert_setup_error(phone._port_listeners, 18444)
        with mock.patch.object(phone, "_platform", return_value="Darwin"), mock.patch.object(phone.shutil, "which", return_value="/usr/sbin/lsof"), mock.patch.object(phone, "_run", return_value=subprocess.CompletedProcess([], 0, b"p321\n", b"")):
            self.assert_setup_error(phone._port_listeners, 18444)
        with mock.patch.object(phone, "_platform", return_value="Darwin"), mock.patch.object(phone.shutil, "which", return_value="/usr/sbin/lsof"), mock.patch.object(phone, "_run", return_value=subprocess.CompletedProcess([], 0, b"p321\nccaddy\nn[::]:443\n", b"")):
            self.assert_setup_error(phone._port_listeners, 18444)

    def test_exact_owned_serve_exempts_only_sole_tailscaled_tailnet_listener(self) -> None:
        own_listener = [("100.64.0.7", 18444, {"tailscaled"})]
        with mock.patch.object(phone, "_port_listeners", return_value=own_listener):
            phone._check_https_listener(18444, {"100.64.0.7"}, existing_owned_route=True)
            self.assert_setup_error(phone._check_https_listener, 18444, {"100.64.0.7"}, False)
        for listeners in (
            [("0.0.0.0", 18444, {"tailscaled"})],
            [("100.64.0.7", 18444, {"nginx"})],
            [("100.64.0.7", 18444, {"tailscaled", "nginx"})],
            own_listener + [("::", 18444, {"traefik"})],
            [("100.64.0.9", 18444, {"tailscaled"})],
            [("100.64.0.7", 18444, set())],
        ):
            with self.subTest(listeners=listeners), mock.patch.object(phone, "_port_listeners", return_value=listeners):
                self.assert_setup_error(phone._check_https_listener, 18444, {"100.64.0.7"}, True)

    def test_check_refuses_listener_before_state_or_service_mutation(self) -> None:
        fake = self.root / "tailscale"
        fake.write_text("", encoding="utf-8")
        fake.chmod(0o755)
        stderr = io.StringIO()
        with mock.patch.object(phone.os, "geteuid", return_value=501), mock.patch.object(phone, "_binary", return_value=fake), mock.patch.object(phone, "_tailscale_status", return_value=("phone.example", "https://phone.example", {"100.64.0.7"})), mock.patch.object(phone, "_serve_config", return_value={}), mock.patch.object(phone, "_port_listeners", return_value=[("0.0.0.0", 18444, {"traefik"})]), mock.patch.object(phone, "_owned_directory") as owned_directory, mock.patch.object(phone, "_credentials") as credentials, mock.patch.object(phone, "_ensure_services") as ensure_services, mock.patch.object(phone, "_sudo_install") as sudo_install, redirect_stderr(stderr):
            result = phone.main(["--check", "--state-dir", str(self.state), "--config-dir", str(self.config)])
        self.assertEqual(result, 1)
        self.assertIn("Tailscale Serve takes this port for all tailnet traffic", stderr.getvalue())
        owned_directory.assert_not_called()
        credentials.assert_not_called()
        ensure_services.assert_not_called()
        sudo_install.assert_not_called()
        self.assertFalse(self.state.exists())
        self.assertFalse(self.config.exists())

    def _write_runtime(self, origin: str = "https://phone.example") -> None:
        self.state.mkdir(mode=0o700)
        runtime = {
            "version": 1,
            "nats_bin": "/usr/bin/nats-server",
            "server_bin": "/usr/bin/oshioki-server",
            "nats_port": 14222,
            "server_port": 18443,
            "origin": origin,
            "rp_id": "phone.example",
            "script": "/usr/bin/oshioki-phone-setup",
        }
        (self.state / "runtime.json").write_text(json.dumps(runtime), encoding="utf-8")
        (self.state / "runtime.json").chmod(0o600)

    def test_omitted_https_port_preserves_existing_runtime_origin(self) -> None:
        self._write_runtime("https://phone.example")
        args = phone._parser().parse_args(["--state-dir", str(self.state)])
        self.assertIsNone(args.https_port)
        old_runtime = phone._existing_runtime(self.state)
        self.assertEqual(phone._effective_https_port(args, old_runtime), 443)
        explicit = phone._parser().parse_args(["--state-dir", str(self.state), "--https-port", "18444"])
        candidate = {"nats_port": 14222, "server_port": 18443, "origin": "https://phone.example:18444", "rp_id": "phone.example"}
        self.assertEqual(phone._effective_https_port(explicit, old_runtime), 18444)
        self.assert_setup_error(phone._check_runtime_compatibility, old_runtime, candidate)

    def test_check_preserves_old_origin_and_still_preflights_its_port(self) -> None:
        self._write_runtime("https://phone.example")
        fake = self.root / "fake"
        fake.write_text("", encoding="utf-8")
        fake.chmod(0o755)
        listener = mock.Mock()
        output = io.StringIO()
        with mock.patch.object(phone.os, "geteuid", return_value=501), mock.patch.object(phone, "_binary", return_value=fake), mock.patch.object(phone, "_tailscale_status", return_value=("phone.example", "https://phone.example", {"100.64.0.7"})), mock.patch.object(phone, "_serve_config", return_value={}), mock.patch.object(phone, "_check_https_listener", side_effect=listener), redirect_stdout(output):
            result = phone.main(["--check", "--state-dir", str(self.state), "--config-dir", str(self.config)])
        self.assertEqual(result, 0)
        self.assertIn("https://phone.example ", output.getvalue())
        self.assertEqual(listener.call_args.args, (443, {"100.64.0.7"}, False))
        self.assertFalse(self.config.exists())

    def test_explicit_port_change_is_rejected_before_listener_or_filesystem_changes(self) -> None:
        self._write_runtime("https://phone.example")
        before = (self.state / "runtime.json").read_bytes()
        fake = self.root / "fake"
        fake.write_text("", encoding="utf-8")
        fake.chmod(0o755)
        args = phone._parser().parse_args(["--https-port", "18444", "--state-dir", str(self.state), "--config-dir", str(self.config)])
        with mock.patch.object(phone, "_binary", return_value=fake), mock.patch.object(phone, "_tailscale_status", return_value=("phone.example", "https://phone.example", {"100.64.0.7"})), mock.patch.object(phone, "_check_https_listener") as check_listener, mock.patch.object(phone, "_credentials") as credentials, mock.patch.object(phone, "_ensure_services") as ensure_services:
            self.assert_setup_error(phone._local_mode, args, self.config)
        check_listener.assert_not_called()
        credentials.assert_not_called()
        ensure_services.assert_not_called()
        self.assertEqual((self.state / "runtime.json").read_bytes(), before)
        self.assertFalse(self.config.exists())

    def test_second_listener_check_blocks_serve_mutation(self) -> None:
        fake = self.root / "fake"
        fake.write_text("", encoding="utf-8")
        fake.chmod(0o755)
        args = phone._parser().parse_args(["--state-dir", str(self.state)])
        completed = subprocess.CompletedProcess([], 0, b"", b"")
        with mock.patch.object(phone, "_binary", return_value=fake), mock.patch.object(phone, "_tailscale_status", return_value=("phone.example", "https://phone.example", {"100.64.0.7"})), mock.patch.object(phone, "_serve_config", side_effect=[{}, {}]), mock.patch.object(phone, "_check_https_listener", side_effect=[None, phone.SetupError("port became busy")]) as check_listener, mock.patch.object(phone, "_run", return_value=completed) as run, mock.patch.object(phone, "_nats_config", return_value=self.state / "nats.conf"), mock.patch.object(phone, "_runtime", return_value={"version": 1}), mock.patch.object(phone, "_ensure_services"), mock.patch.object(phone, "_wait_nats"), mock.patch.object(phone, "_wait_health", return_value={"origin": "https://phone.example:18444", "rp_id": "phone.example"}), mock.patch.object(phone, "_sudo_install"):
            self.assert_setup_error(phone._local_mode, args, self.config)
        self.assertEqual(check_listener.call_count, 2)
        run.assert_not_called()

    def test_failure_removes_only_the_newly_added_port_route(self) -> None:
        fake = self.root / "fake"
        fake.write_text("", encoding="utf-8")
        fake.chmod(0o755)
        args = phone._parser().parse_args(["--state-dir", str(self.state)])
        expected = phone._expected_serve("phone.example", 18444, 18443)
        completed = subprocess.CompletedProcess([], 0, b"", b"")
        run = mock.Mock(return_value=completed)
        with mock.patch.object(phone, "_binary", return_value=fake), mock.patch.object(phone, "_tailscale_status", return_value=("phone.example", "https://phone.example", {"100.64.0.7"})), mock.patch.object(phone, "_serve_config", side_effect=[{}, {}, expected, expected]), mock.patch.object(phone, "_check_https_listener"), mock.patch.object(phone, "_run", side_effect=run), mock.patch.object(phone, "_nats_config", return_value=self.state / "nats.conf"), mock.patch.object(phone, "_runtime", return_value={"version": 1}), mock.patch.object(phone, "_ensure_services"), mock.patch.object(phone, "_wait_nats"), mock.patch.object(phone, "_wait_health", side_effect=[{"origin": "https://phone.example:18444", "rp_id": "phone.example"}, phone.SetupError("TLS readiness failure")]), mock.patch.object(phone, "_sudo_install") as sudo_install:
            self.assert_setup_error(phone._local_mode, args, self.config)
        commands = [call.args[0] for call in run.call_args_list]
        self.assertEqual(commands, [
            [str(fake), "serve", "--bg", "--https=18444", "http://127.0.0.1:18443"],
            [str(fake), "serve", "--bg", "--https=18444", "off"],
        ])
        self.assertFalse(any("reset" in command for command in commands))
        sudo_install.assert_not_called()

    def test_local_readiness_failure_never_invokes_root_config_update(self) -> None:
        fake = self.root / "fake"
        fake.write_text("", encoding="utf-8")
        fake.chmod(0o755)
        args = phone._parser().parse_args(["--state-dir", str(self.state), "--config-dir", str(self.config)])
        completed = __import__("subprocess").CompletedProcess([], 0, b"", b"")
        with mock.patch.object(phone, "_binary", return_value=fake), mock.patch.object(phone, "_tailscale_status", return_value=("phone.example", "https://phone.example", {"100.64.0.1"})), mock.patch.object(phone, "_serve_config", return_value={}), mock.patch.object(phone, "_check_https_listener"), mock.patch.object(phone, "_run", return_value=completed), mock.patch.object(phone, "_nats_config", return_value=self.state / "nats.conf"), mock.patch.object(phone, "_runtime", return_value={"version": 1}), mock.patch.object(phone, "_ensure_services"), mock.patch.object(phone, "_wait_nats"), mock.patch.object(phone, "_wait_health", side_effect=phone.SetupError("synthetic readiness failure")), mock.patch.object(phone, "_sudo_install") as sudo_install:
            self.assert_setup_error(phone._local_mode, args, self.config)
        sudo_install.assert_not_called()
        self.assertFalse(self.config.exists())

    def test_nats_tls_requires_upgrade_after_clear_info(self) -> None:
        # This is a regression guard for the protocol ordering. The actual
        # socket/TLS integration is intentionally left to the NATS acceptance
        # lane; this test verifies the helper's explicit contract branch.
        with mock.patch.object(phone, "_nats_parts", return_value=("nats", "nats.example", 4222)):
            class FakeSocket:
                def close(self):
                    pass

            with mock.patch.object(phone.socket, "create_connection", return_value=FakeSocket()), mock.patch.object(phone, "_nats_read_line", return_value=b'INFO {"tls_required":true}'):
                self.assert_setup_error(phone._nats_connect, "nats://nats.example:4222", "u", "p")


