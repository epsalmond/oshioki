#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
free_port() {
  node -e 'const net=require("node:net"); const server=net.createServer(); server.listen(0,"127.0.0.1",()=>{ console.log(server.address().port); server.close(); });'
}

for tool in cargo curl nats nats-server node npm openssl; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "missing browser test prerequisite: $tool" >&2
    exit 2
  }
done

NATS_PORT="${SUDO_APPROVE_TEST_NATS_PORT:-$(free_port)}"
SERVER_PORT="${SUDO_APPROVE_TEST_SERVER_PORT:-$(free_port)}"
HTTPS_PORT="${SUDO_APPROVE_TEST_HTTPS_PORT:-$(free_port)}"
while [ "$SERVER_PORT" = "$NATS_PORT" ]; do SERVER_PORT="$(free_port)"; done
while [ "$HTTPS_PORT" = "$NATS_PORT" ] || [ "$HTTPS_PORT" = "$SERVER_PORT" ]; do HTTPS_PORT="$(free_port)"; done
TEMP_ROOT="$(cd "${TMPDIR:-/tmp}" && pwd -P)"
STATE_ROOT="$(mktemp -d "$TEMP_ROOT/sudo-approve-browser.XXXXXX")"
NATS_PID=""
SERVER_PID=""
TEST_OK=0

cleanup() {
  set +e
  [ -z "$SERVER_PID" ] || kill "$SERVER_PID" >/dev/null 2>&1 || true
  [ -z "$NATS_PID" ] || kill "$NATS_PID" >/dev/null 2>&1 || true
  [ -z "$SERVER_PID" ] || wait "$SERVER_PID" >/dev/null 2>&1 || true
  [ -z "$NATS_PID" ] || wait "$NATS_PID" >/dev/null 2>&1 || true
  if [ "$TEST_OK" -eq 1 ]; then
    rm -rf -- "$STATE_ROOT"
  else
    printf 'retained failed browser state: %s\n' "$STATE_ROOT" >&2
  fi
}
trap cleanup EXIT

mkdir -p "$STATE_ROOT/nats" "$STATE_ROOT/server" "$STATE_ROOT/hook" "$STATE_ROOT/tls"
chmod 0700 "$STATE_ROOT/hook"
cargo build --manifest-path "$REPO_ROOT/Cargo.toml" --workspace --locked
npm --prefix "$REPO_ROOT/server/web" ci
npm --prefix "$REPO_ROOT/server/web" exec playwright install chromium

nats-server -js -sd "$STATE_ROOT/nats" -p "$NATS_PORT" \
  --user sudo-approve --pass test-only >"$STATE_ROOT/nats.log" 2>&1 &
NATS_PID=$!
for _ in $(seq 1 50); do
  if (exec 3<>"/dev/tcp/127.0.0.1/$NATS_PORT") 2>/dev/null; then
    exec 3>&-
    break
  fi
  sleep 0.1
done
kill -0 "$NATS_PID"
nats --server "nats://127.0.0.1:$NATS_PORT" --user sudo-approve --password test-only \
  stream add SUDO_APPROVE --subjects 'sudo.request.>' --storage memory \
  --retention limits --discard old --max-age 10m --defaults >/dev/null

origin="https://sudo.test:$HTTPS_PORT"
printf '{"version":1,"origin":"%s","rp_id":"sudo.test","server_base_url":"%s"}\n' \
  "$origin" "$origin" >"$STATE_ROOT/hook/hook.json"
printf 'NATS_URL=nats://127.0.0.1:%s\nNATS_USER=sudo-approve\nNATS_PASS=test-only\n' \
  "$NATS_PORT" >"$STATE_ROOT/hook/config.env"
printf '{"version":1,"devices":[]}\n' >"$STATE_ROOT/hook/devices.json"
chmod 0600 "$STATE_ROOT/hook"/*

NATS_URL="nats://127.0.0.1:$NATS_PORT" \
NATS_USER=sudo-approve \
NATS_PASS=test-only \
SUDO_APPROVE_STATE_PATH="$STATE_ROOT/server/state.sqlite3" \
SUDO_APPROVE_LISTEN="127.0.0.1:$SERVER_PORT" \
SUDO_APPROVE_ORIGIN="$origin" \
SUDO_APPROVE_RP_ID=sudo.test \
  "$REPO_ROOT/target/debug/sudo-approve-server" >"$STATE_ROOT/server.log" 2>&1 &
SERVER_PID=$!
for _ in $(seq 1 100); do
  if curl --fail --silent "http://127.0.0.1:$SERVER_PORT/healthz" >/dev/null; then
    break
  fi
  sleep 0.1
done
curl --fail --silent "http://127.0.0.1:$SERVER_PORT/healthz" >/dev/null

openssl req -x509 -newkey rsa:2048 -nodes -days 1 \
  -subj /CN=sudo.test -addext subjectAltName=DNS:sudo.test \
  -keyout "$STATE_ROOT/tls/key.pem" -out "$STATE_ROOT/tls/cert.pem" >/dev/null 2>&1

SUDO_APPROVE_HOOK="$REPO_ROOT/target/debug/sudo-approve" \
SUDO_APPROVE_TEST_CONFIG_DIR="$STATE_ROOT/hook" \
SUDO_APPROVE_ORIGIN="$origin" \
SUDO_APPROVE_SERVER_HTTP="http://127.0.0.1:$SERVER_PORT" \
SUDO_APPROVE_TLS_KEY="$STATE_ROOT/tls/key.pem" \
SUDO_APPROVE_TLS_CERT="$STATE_ROOT/tls/cert.pem" \
SUDO_APPROVE_HTTPS_PORT="$HTTPS_PORT" \
NATS_URL="nats://127.0.0.1:$NATS_PORT" \
NATS_USER=sudo-approve \
NATS_PASS=test-only \
  npm --prefix "$REPO_ROOT/server/web" run test:e2e

TEST_OK=1
echo "test-browser-local: PASS"
