#!/usr/bin/env bash
# Reproducible, test-only Linux PAM characterization for issue 73.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
WORKSPACE="$(cd "$SCRIPT_DIR/.." && pwd -P)"
IMAGE="${IMAGE:-ubuntu:24.04}"
KEEP_ARTIFACTS="${OSHIOKI_E2E_KEEP_ARTIFACTS:-0}"
STATE_ROOT="$(mktemp -d -t oshioki-pam-spike.XXXXXX)"
CONTAINER="oshioki-pam-spike-${STATE_ROOT##*.}"
TEST_SUCCEEDED=0

cleanup() {
    set +e
    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
    if [ "$TEST_SUCCEEDED" -eq 1 ] && [ "$KEEP_ARTIFACTS" != 1 ]; then
        rm -rf "$STATE_ROOT"
    else
        echo "* retained PAM spike artifacts: $STATE_ROOT" >&2
    fi
}
trap cleanup EXIT

mkdir -p "$STATE_ROOT"
chmod 0700 "$STATE_ROOT"
docker run --rm --name "$CONTAINER" \
    -v "$WORKSPACE":/work:ro \
    -v "$STATE_ROOT":/run/oshioki-pam-spike:rw \
    "$IMAGE" \
    bash /work/tests/pam-spike/run-in-container.sh

TEST_SUCCEEDED=1
echo "* PASS: PAM migration spike (Ubuntu 24.04, private sudo PAM service)"
