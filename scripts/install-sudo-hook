#!/usr/bin/env bash
# Install, disable, or inspect the retained sudo-approve prelaunch block.
set -euo pipefail

MODE=""
DRY_RUN=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --prelaunch|--disable-prelaunch|--prelaunch-status|--standalone-e2e)
      [ -z "$MODE" ] || { echo "install-sudo-hook: choose exactly one mode" >&2; exit 2; }
      MODE="${1#--}"
      ;;
    --dry-run) DRY_RUN=1 ;;
    *) echo "install-sudo-hook: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done
[ -n "$MODE" ] || { echo "install-sudo-hook: choose exactly one mode" >&2; exit 2; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SERVICE_DIR="$(cd "$SCRIPT_DIR/.." && pwd -P)"
SUDO_CONF="${SUDO_CONF:-/etc/sudo.conf}"
SBIN_DIR="${SBIN_DIR:-/usr/local/sbin}"
STATE_DIR="${SUDO_APPROVE_STATE_DIR:-/etc/management-plane/sudo-approve}"
SUDOERS_D="${SUDOERS_D:-/etc/sudoers.d}"
ORIGIN="${SUDO_APPROVE_ORIGIN:-https://sudo.internal.psalmond.com}"
RP_ID="${SUDO_APPROVE_RP_ID:-sudo.internal.psalmond.com}"
NATS_URL="${NATS_URL:-nats://nats.internal.psalmond.com:4222}"
NATS_USER="${NATS_USER:-sudo-approve}"
NATS_PASS="${NATS_PASS:-}"
BEGIN_MARK='# BEGIN management-plane sudo approve'
END_MARK='# END management-plane sudo approve'
LOCK_DIR="${SUDO_APPROVE_INSTALL_LOCK:-${STATE_DIR}.install.lock}"

case "$(uname -s)" in
  Linux) PLUGIN_DIR="${SUDO_PLUGIN_DIR:-/usr/local/libexec/sudo}"; PLUGIN_NAME=approval_exec.so; BUILD_PLUGIN=libplugin.so ;;
  Darwin) PLUGIN_DIR="${SUDO_PLUGIN_DIR:-/usr/local/libexec/sudo}"; PLUGIN_NAME=approval_exec.dylib; BUILD_PLUGIN=libplugin.dylib ;;
  *) echo "install-sudo-hook: unsupported operating system" >&2; exit 1 ;;
esac
HOOK_BIN="$SERVICE_DIR/target/release/management-plane-sudo-approve"
PLUGIN_BIN="$SERVICE_DIR/target/release/$BUILD_PLUGIN"
PLUGIN_DEST="$PLUGIN_DIR/$PLUGIN_NAME"

die() { echo "install-sudo-hook: $*" >&2; exit 1; }
run() { if [ "$DRY_RUN" -eq 1 ]; then printf 'DRY:'; printf ' %q' "$@"; printf '\n'; else "$@"; fi; }
regular_or_absent() { [ ! -L "$1" ] || die "refusing unsafe target: $1"; [ ! -e "$1" ] || [ -f "$1" ] || die "refusing unsafe target: $1"; }
safe_directory() { [ ! -L "$1" ] || die "refusing symlink directory: $1"; [ ! -e "$1" ] || [ -d "$1" ] || die "refusing non-directory: $1"; }
hash_file() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'; else shasum -a 256 "$1" | awk '{print $1}'; fi; }

if [ "$MODE" = prelaunch-status ]; then
  [ -f "$SUDO_CONF" ] || { echo "disabled"; exit 1; }
  begins="$(grep -cF "$BEGIN_MARK" "$SUDO_CONF" || true)"; ends="$(grep -cF "$END_MARK" "$SUDO_CONF" || true)"
  if [ "$begins" -eq 1 ] && [ "$ends" -eq 1 ] && grep -Fq "Plugin approval_exec $PLUGIN_DEST" "$SUDO_CONF"; then echo "enabled: $PLUGIN_DEST"; exit 0; fi
  if [ "$begins" -eq 0 ] && [ "$ends" -eq 0 ]; then echo "disabled"; exit 1; fi
  die "malformed managed block in $SUDO_CONF"
fi

[ "$(id -u)" -eq 0 ] || [ "$DRY_RUN" -eq 1 ] || die "must run as root"
safe_directory "$(dirname "$STATE_DIR")"; safe_directory "$STATE_DIR"; regular_or_absent "$SUDO_CONF"
safe_directory "$SBIN_DIR"; safe_directory "$PLUGIN_DIR"; regular_or_absent "$SBIN_DIR/management-plane-sudo-approve"; regular_or_absent "$PLUGIN_DEST"

if [ "$DRY_RUN" -eq 0 ]; then
  mkdir "$LOCK_DIR" 2>/dev/null || die "another installer holds $LOCK_DIR"
  trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT HUP INT TERM
fi

rewrite_block() {
  local action="$1" source="$2" destination="$3" tmp begins ends
  begins="$(grep -cF "$BEGIN_MARK" "$source" 2>/dev/null || true)"; ends="$(grep -cF "$END_MARK" "$source" 2>/dev/null || true)"
  { [ "$begins" -eq 0 ] && [ "$ends" -eq 0 ]; } || { [ "$begins" -eq 1 ] && [ "$ends" -eq 1 ]; } || die "malformed managed block in $source"
  tmp="$(mktemp "${destination}.XXXXXX")"
  awk -v begin="$BEGIN_MARK" -v end="$END_MARK" '
    $0 == begin { inside=1; next } $0 == end { inside=0; next } !inside { print }
  ' "$source" > "$tmp"
  if [ "$action" = enable ]; then
    [ ! -s "$tmp" ] || [ "$(tail -c 1 "$tmp" | wc -l)" -ne 0 ] || printf '\n' >> "$tmp"
    printf '%s\nPlugin approval_exec %s\n%s\n' "$BEGIN_MARK" "$PLUGIN_DEST" "$END_MARK" >> "$tmp"
  fi
  chmod 0644 "$tmp"; chown root:root "$tmp"; mv -f "$tmp" "$destination"
}

validate_sudo() {
  if [ "${SKIP_NODEVER:-0}" = 1 ]; then return 0; fi
  if [ "$DRY_RUN" -eq 1 ]; then printf 'DRY: sudo -V  # validate %s\n' "$SUDO_CONF"; return 0; fi
  sudo -V >/dev/null 2>&1
}

if [ "$MODE" = disable-prelaunch ]; then
  [ -f "$SUDO_CONF" ] || die "missing $SUDO_CONF"
  if [ "$DRY_RUN" -eq 1 ]; then echo "DRY: remove exact managed block from $SUDO_CONF"; exit 0; fi
  backup="$(mktemp "${SUDO_CONF}.rollback.XXXXXX")"; cp -p "$SUDO_CONF" "$backup"
  rewrite_block disable "$SUDO_CONF" "$SUDO_CONF"
  if ! validate_sudo; then cp -p "$backup" "$SUDO_CONF"; rm -f "$backup"; die "sudo -V failed after disable; restored prior configuration"; fi
  rm -f "$backup"; echo "install-sudo-hook: prelaunch disabled and sudo validated"; exit 0
fi

for artifact in "$HOOK_BIN" "$PLUGIN_BIN"; do [ -f "$artifact" ] && [ ! -L "$artifact" ] || die "missing or unsafe build artifact: $artifact"; done
architecture="$(uname -m)"; file_output="$(file -b "$HOOK_BIN") $(file -b "$PLUGIN_BIN")"
case "$architecture" in
  x86_64|amd64) grep -Eqi 'x86[-_ ]?64|x86_64' <<<"$file_output" || die "artifact architecture does not match $architecture" ;;
  arm64|aarch64) grep -Eqi 'arm64|aarch64' <<<"$file_output" || die "artifact architecture does not match $architecture" ;;
  *) die "unsupported architecture: $architecture" ;;
esac

CHECKSUMS="${SUDO_APPROVE_CHECKSUMS:-$SERVICE_DIR/target/release/SHA256SUMS}"
[ -f "$CHECKSUMS" ] && [ ! -L "$CHECKSUMS" ] || die "missing artifact checksum manifest: $CHECKSUMS"
for artifact in "$HOOK_BIN" "$PLUGIN_BIN"; do
  name="$(basename "$artifact")"; expected="$(awk -v name="$name" '$2 == name {print $1}' "$CHECKSUMS")"
  [ "${#expected}" -eq 64 ] || die "checksum manifest has no exact entry for $name"
  [ "$(hash_file "$artifact")" = "$expected" ] || die "checksum mismatch for $name"
done

run install -d -m 0755 "$SBIN_DIR" "$PLUGIN_DIR"
run install -m 0755 -o root -g root "$HOOK_BIN" "$SBIN_DIR/management-plane-sudo-approve"
run install -m 0755 -o root -g root "$PLUGIN_BIN" "$PLUGIN_DEST"
run install -d -m 0750 -o root -g root "$STATE_DIR"

if [ "$DRY_RUN" -eq 1 ]; then
  printf 'DRY: write %s/config.env with NATS_PASS=<redacted>\n' "$STATE_DIR"
  printf 'DRY: write %s/hook.json for origin %s and RP ID %s\n' "$STATE_DIR" "$ORIGIN" "$RP_ID"
else
  tmp="$(mktemp "$STATE_DIR/config.env.XXXXXX")"; printf 'NATS_URL=%s\nNATS_USER=%s\nNATS_PASS=%s\n' "$NATS_URL" "$NATS_USER" "$NATS_PASS" > "$tmp"; chmod 0600 "$tmp"; chown root:root "$tmp"; mv -f "$tmp" "$STATE_DIR/config.env"
  tmp="$(mktemp "$STATE_DIR/hook.json.XXXXXX")"; printf '{"version":1,"origin":"%s","rp_id":"%s","server_base_url":"%s"}\n' "$ORIGIN" "$RP_ID" "$ORIGIN" > "$tmp"; chmod 0600 "$tmp"; chown root:root "$tmp"; mv -f "$tmp" "$STATE_DIR/hook.json"
  if [ ! -e "$STATE_DIR/devices.json" ]; then printf '{"version":1,"devices":[]}\n' > "$STATE_DIR/devices.json"; chmod 0600 "$STATE_DIR/devices.json"; chown root:root "$STATE_DIR/devices.json"; fi
fi

if [ "$MODE" = prelaunch ]; then
  stale="$SUDOERS_D/management-plane-sudo-approve"; regular_or_absent "$stale"; [ ! -f "$stale" ] || run rm -f -- "$stale"
fi

if [ "$DRY_RUN" -eq 1 ]; then echo "DRY: enable exact managed block in $SUDO_CONF"; validate_sudo; exit 0; fi
[ -f "$SUDO_CONF" ] || install -m 0644 -o root -g root /dev/null "$SUDO_CONF"
backup="$(mktemp "${SUDO_CONF}.rollback.XXXXXX")"; cp -p "$SUDO_CONF" "$backup"
rewrite_block enable "$SUDO_CONF" "$SUDO_CONF"
if ! validate_sudo; then rewrite_block disable "$SUDO_CONF" "$SUDO_CONF"; cp -p "$backup" "$SUDO_CONF"; rm -f "$backup"; die "sudo -V failed; restored prior configuration"; fi
rm -f "$backup"
echo "install-sudo-hook: $MODE installed and sudo validated"
