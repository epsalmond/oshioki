#!/usr/bin/env bash
set -euo pipefail
IMAGE="${1:?usage: test-image-contract IMAGE}"
revision="${2:?usage: test-image-contract IMAGE REVISION}"
docker inspect "$IMAGE" --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' | grep -Fx "$revision"
docker run --rm --entrypoint /bin/sh "$IMAGE" -c '
  test -x /opt/sudo-approve/bin/management-plane-sudo-approve-server
  test -x /opt/sudo-approve/bin/management-plane-sudo-approve
  test -f /opt/sudo-approve/libexec/sudo/approval_exec.so
  test -f /opt/sudo-approve/SHA256SUMS
  test -f /opt/sudo-approve/dist/v1/darwin-arm64/manifest.json
  cd /opt/sudo-approve/dist/v1/darwin-arm64
  sha256sum -c SHA256SUMS
'
